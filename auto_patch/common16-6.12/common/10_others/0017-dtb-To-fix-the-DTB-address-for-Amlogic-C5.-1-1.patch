From fbf0f6dab3eae92709fb69454a78240712c6a6c4 Mon Sep 17 00:00:00 2001
From: yao zhang1 <yao.zhang1@amlogic.com>
Date: Fri, 2 Jan 2026 13:26:18 +0800
Subject: [PATCH] dtb: To fix the DTB address for Amlogic C5. [1/1]

PD#SWPL-247402

Problem:
To fix the DTB address for Amlogic C5.

Solution:
To fix the DTB address for Amlogic C5.

Verify:
c5

Change-Id: I4ec22f0d95a92b40cbb901cecfd93f91e8d983a0
Signed-off-by: yao zhang1 <yao.zhang1@amlogic.com>
---
 arch/arm64/Kconfig       | 6 ++++++
 arch/arm64/kernel/head.S | 3 +++
 2 files changed, 9 insertions(+)

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 0b5559521788..8ce8dd105da5 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2437,6 +2437,12 @@ config AMLOGIC_LINUX_S_OPTIMIZE
 	help
 	Amlogic linux kernel size optimize
 
+config AMLOGIC_FIXED_DTB_ADDR
+	bool "To fix the DTB address"
+	default n
+	help
+	To fix the address of the Amlogic DTB
+
 endmenu # "Boot options"
 
 menu "Power management options"
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index cb68adcabe07..095622889d7e 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -167,6 +167,9 @@ SYM_CODE_END(record_mmu_state)
  * Preserve the arguments passed by the bootloader in x0 .. x3
  */
 SYM_CODE_START_LOCAL(preserve_boot_args)
+#ifdef CONFIG_AMLOGIC_FIXED_DTB_ADDR
+	ldr x0, =0x1000000
+#endif
 	mov	x21, x0				// x21=FDT
 
 	adr_l	x0, boot_args			// record the contents of
-- 
2.46.0

