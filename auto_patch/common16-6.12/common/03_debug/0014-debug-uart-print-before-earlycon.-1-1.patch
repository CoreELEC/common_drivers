diff --git a/arch/arm/include/debug/uncompress_debug.h b/arch/arm/include/debug/uncompress_debug.h
new file mode 100644
index 000000000000..3351d71cd930
--- /dev/null
+++ b/arch/arm/include/debug/uncompress_debug.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifdef CONFIG_AMLOGIC_DEBUG_EARLY_UART
+extern void putc(int c);
+static inline void flush(void) {}
+static void putstr_debug(const char *ptr)
+{
+       char c;
+
+       while ((c = *ptr++) != '\0') {
+               if (c == '\n')
+                       putc('\r');
+               putc(c);
+       }
+
+       flush();
+}
+#endif
diff --git a/arch/arm/kernel/aml_uart_puts.h b/arch/arm/kernel/aml_uart_puts.h
new file mode 100644
index 000000000000..c93ac6572c8f
--- /dev/null
+++ b/arch/arm/kernel/aml_uart_puts.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __AML_UART_PUTS_H
+#define __AML_UART_PUTS_H
+.macro puts_uart_m base, tmp1, tmp2, str
+    adr     \base, 3f
+    ldr     \base, [\base]
+
+    adr     \tmp1, 2f
+
+    ldr     \tmp2, [\base, #8]
+    orr     \tmp2, \tmp2, #(1 << 12)
+    bic     \tmp2, \tmp2, #(3 << 27)
+    dmb     sy
+    str     \tmp2, [\base, #8]
+    dmb     sy
+
+1:
+    ldr     \tmp2, [\base, #0xc]
+    tst     \tmp2, #(1 << 21)
+    bne     1b
+
+    ldrb    \tmp2, [\tmp1], #1
+    cmp     \tmp2, #0
+    beq     4f
+
+    strb    \tmp2, [\base]
+    b       1b
+
+2:
+    .ascii  "\str"
+    .byte   0
+    .align  4
+
+3:
+    .word   CONFIG_DEBUG_UART_PHYS
+
+4:
+    nop
+.endm
+#endif /* __AML_UART_PUTS_H */
