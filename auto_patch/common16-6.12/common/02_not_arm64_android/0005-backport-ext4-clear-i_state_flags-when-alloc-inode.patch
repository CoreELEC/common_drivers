From 54e7d75a665298ca5e41329a4c8dc10241ab61a1 Mon Sep 17 00:00:00 2001
From: yao zhang1 <yao.zhang1@amlogic.com>
Date: Tue, 31 Mar 2026 15:17:43 +0800
Subject: [PATCH] backport: ext4: clear i_state_flags when alloc inode

commit 4091c8206cfd2e3bb529ef260887296b90d9b6a2 upstream.

i_state_flags used on 32-bit archs, need to clear this flag when
alloc inode.
Find this issue when umount ext4, sometimes track the inode as orphan
accidently, cause ext4 mesg dump.

Change-Id: I6d49534bf746576e188c68d86ec9d15df2ddbc1b
Signed-off-by: yao zhang1 <yao.zhang1@amlogic.com>
---
 fs/ext4/ialloc.c | 2 ++
 fs/ext4/inode.c  | 2 ++
 fs/ext4/super.c  | 3 +++
 3 files changed, 7 insertions(+)

diff --git a/fs/ext4/ialloc.c b/fs/ext4/ialloc.c
index 21d228073d79..e45eeb09437f 100644
--- a/fs/ext4/ialloc.c
+++ b/fs/ext4/ialloc.c
@@ -1292,7 +1292,9 @@ struct inode *__ext4_new_inode(struct mnt_idmap *idmap,
 					      sizeof(gen));
 	}
 
+#ifndef CONFIG_AMLOGIC_EXT4_FIX
 	ext4_clear_state_flags(ei); /* Only relevant on 32-bit archs */
+#endif
 	ext4_set_inode_state(inode, EXT4_STATE_NEW);
 
 	ei->i_extra_isize = sbi->s_want_extra_isize;
diff --git a/fs/ext4/inode.c b/fs/ext4/inode.c
index 4ad34eba00a7..3ac70ac63ef1 100644
--- a/fs/ext4/inode.c
+++ b/fs/ext4/inode.c
@@ -4873,7 +4873,9 @@ struct inode *__ext4_iget(struct super_block *sb, unsigned long ino,
 	ei->i_projid = make_kprojid(&init_user_ns, i_projid);
 	set_nlink(inode, le16_to_cpu(raw_inode->i_links_count));
 
+#ifndef CONFIG_AMLOGIC_EXT4_FIX
 	ext4_clear_state_flags(ei);	/* Only relevant on 32-bit archs */
+#endif
 	ei->i_inline_off = 0;
 	ei->i_dir_start_lookup = 0;
 	ei->i_dtime = le32_to_cpu(raw_inode->i_dtime);
diff --git a/fs/ext4/super.c b/fs/ext4/super.c
index 37084c3df4a3..0cdc126d9e15 100644
--- a/fs/ext4/super.c
+++ b/fs/ext4/super.c
@@ -1419,6 +1419,9 @@ static struct inode *ext4_alloc_inode(struct super_block *sb)
 
 	inode_set_iversion(&ei->vfs_inode, 1);
 	ei->i_flags = 0;
+#ifdef CONFIG_AMLOGIC_EXT4_FIX
+	ext4_clear_state_flags(ei);	/* Only relevant on 32-bit archs */
+#endif
 	spin_lock_init(&ei->i_raw_lock);
 	ei->i_prealloc_node = RB_ROOT;
 	atomic_set(&ei->i_prealloc_active, 0);
-- 
2.46.0

