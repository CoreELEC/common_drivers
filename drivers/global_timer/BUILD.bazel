load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")
load("//common_drivers:amlogic_utils.bzl", "m_k_files", "kernel_select")

m_k_files()

ddk_module(
    name = "amlogic-global-timer",
    srcs = glob([
        "**/*.h",
    ]),
    conditional_srcs = {
        "CONFIG_AMLOGIC_GLOBAL_TIMER": {
            True: ["main.c"],
        },
        "CONFIG_AMLOGIC_GLOBAL_TIMER_CORE": {
            True: ["global_timer_core.c"],
        },
        "CONFIG_AMLOGIC_GLOBAL_TIMER_ISP": {
            True: ["global_timer_isp.c"],
        },
        "CONFIG_AMLOGIC_GLOBAL_TIMER_OUTPUT": {
            True: ["global_timer_output.c"],
        },
        "CONFIG_AMLOGIC_GLOBAL_TIMER_INPUT": {
            True: ["global_timer_input.c"],
        },
     },
    hdrs = [
    ],
    local_defines = ["pr_fmt(fmt)=\"glb_timer]: \" fmt"],
    out = "amlogic-global-timer.ko",
    kernel_build = kernel_select(),
    visibility = ["//visibility:public"],
    deps = [
         "//common_drivers/drivers/gpio:amlogic-gpio",
         "//common_drivers/drivers/gki_tool:amlogic-gkitool",
    ],
)
