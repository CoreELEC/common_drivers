load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")
load("//common_drivers:amlogic_utils.bzl", "m_k_files", "kernel_select")

m_k_files()

ddk_module(
    name = "amlogic-pcie",
    srcs = glob([
        "**/*.h",
    ]),
    conditional_srcs = {
        "CONFIG_AMLOGIC_PCIE": {
            True: ["main.c",],
        },
        "CONFIG_AMLOGIC_PCIE_V2_HOST": {
            True: [
                "controller/amlogic-pcie-v2-host.c",
            ],
        },
        "CONFIG_AMLOGIC_PCIE_V3_HOST": {
            True: [
		"controller/amlogic-pcie-v3-host.c",
                "controller/amlogic-pcie-v3-comm.c",
	    ],
        },
        "CONFIG_AMLOGIC_PCIE_V3_EP": {
            True: [
                "controller/amlogic-pcie-v3-comm.c",
                "controller/amlogic-pcie-v3-ep.c",
                "controller/pci_endpoint_test.c",
            ],
        },
        "CONFIG_AMLOGIC_PCIE_V4_HOST": {
            True: ["controller/amlogic-pcie-v4-host.c",],
        },
        "CONFIG_AMLOGIC_PCIE_PHY_A9": {
            True: [
		"phy/amlogic-pcie-phy.c",
		"phy/amlogic-pcie-phy-a9.c",
	    ],
         },
        "CONFIG_AMLOGIC_PCIE_PHY_C5": {
            True: [
		"phy/amlogic-pcie-phy.c",
		"phy/amlogic-pcie-phy-c5.c",
	    ],
         },
    },
    hdrs = [
        "//common:drivers/pci/controller/dwc/pcie-designware.h",
        "//common:drivers/pci/pci.h",
    ],
    linux_includes = [
        "../../../common/drivers/pci/controller/dwc",
        "../../../common/drivers/pci",
    ],
    local_defines = [
        "pr_fmt(fmt)=\"[pcie]: \" fmt",
    ],
    out = "amlogic-pcie.ko",
    kernel_build = kernel_select(),
    visibility = ["//visibility:public"],
    deps = [
        "//common_drivers/drivers/gki_tool:amlogic-gkitool",
        "//common_drivers/drivers/debug:amlogic-debug-iotrace",
        "//common_drivers/drivers/debug:amlogic-debug",
        "//common_drivers/drivers/cpu_info:amlogic-cpuinfo",
        "//common_drivers/drivers/secmon:amlogic-secmon",
        "//common_drivers/drivers/pm:amlogic-pm",
        "//common_drivers/drivers/power:amlogic-power",
    ],
)
