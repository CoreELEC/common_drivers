load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")
load("//common_drivers:amlogic_utils.bzl", "m_k_files", "kernel_select")

m_k_files()

ddk_module(
	name = "sei_gpio_ctrl",
	srcs = glob([
		"**/*.h",
	]),
	conditional_srcs = {
		"CONFIG_SEI_GPIO_CTRL": {
			True: [
				"gpio_ctrl.c",
			],
		},
	},
	hdrs = [
	],

	local_defines = [
		"pr_fmt(fmt)=\"[sei_gpio_ctrl]: \" fmt",
	],
	out = "sei_gpio_ctrl.ko",
	kernel_build = kernel_select(),
	visibility = ["//visibility:public"],
	deps = [
		"//common_drivers/drivers/gki_tool:amlogic-gkitool",
		"//common_drivers/drivers/pm:amlogic-pm",
	],
)
