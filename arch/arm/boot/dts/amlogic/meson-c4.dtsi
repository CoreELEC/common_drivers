	i2c0_master_ao_pins1:i2c0_ao_pins1 {
		mux {
			groups = "i2cm_a_scl_ao0",
				"i2cm_a_sda_ao1";
			function = "i2c0";
			bias-disable;
			drive-strength-microamp = <3000>;
		};
	};

	i2c0_master_ao_sleep_pins1:i2c0_ao_sleep_pins1 {
		mux {
			groups = "GPIOAO_0", "GPIOAO_1";
			function = "gpio_periphs";
			input-enable;
		};
	};

	i2c1_master_ao_pins1:i2c1_ao_pins1 {
		mux {
			groups = "i2cm_b_scl_ao3",
				"i2cm_b_sda_ao2";
			function = "i2c1";
			bias-disable;
			drive-strength-microamp = <3000>;
		};
	};

	i2c1_master_ao_sleep_pins1:i2c1_ao_sleep_pins1 {
		mux {
			groups = "GPIOAO_2", "GPIOAO_3";
			function = "gpio_periphs";
			input-enable;
		};
	};

	i2c1_master_ao_pins2:i2c1_ao_pins2 {
		mux {
			groups = "i2cm_b_scl_ao11",
				"i2cm_b_sda_ao10";
			function = "i2c1";
			bias-disable;
			drive-strength-microamp = <3000>;
		};
	};

	i2c1_master_ao_sleep_pins2:i2c1_ao_sleep_pins2 {
		mux {
			groups = "GPIOAO_10", "GPIOAO_11";
			function = "gpio_periphs";
			input-enable;
		};
	};

	i2c2_master_ao_pins1:i2c2_ao_pins1 {
		mux {
			groups = "i2cm_c_scl_ao6",
				"i2cm_c_sda_ao7";
			function = "i2c2";
			bias-disable;
			drive-strength-microamp = <3000>;
		};
	};

	i2c2_master_ao_sleep_pins1:i2c2_ao_sleep_pins1 {
		mux {
			groups = "GPIOAO_6", "GPIOAO_7";
			function = "gpio_periphs";
			input-enable;
		};
	};

	d_uart_pins1:d_uart1 {
		mux {
			groups = "uart_d_rx",
				"uart_d_tx";
			function = "uart_d_ao";
			bias-pull-up;
			drive-strength-microamp = <3000>;
		};
	};

	e_uart_pins2:e_uart2 {
		mux {
			groups = "uart_e_rx_ao1",
				"uart_e_tx_ao0";
			function = "uart_e_ao";
			bias-pull-up;
			drive-strength-microamp = <3000>;
		};
	};

	e_uart_pins3:e_uart3 {
		mux {
			groups = "uart_e_rx_ao11",
				"uart_e_tx_ao10",
				"uart_e_cts_ao12",
				"uart_e_rts_ao13";
			function = "uart_e_ao";
			bias-pull-up;
			drive-strength-microamp = <3000>;
		};
	};

	f_uart_pins2:f_uart2 {
		mux {
			groups = "uart_f_rx_ao3",
				"uart_f_tx_ao2";
			function = "uart_f_ao";
			bias-pull-up;
			drive-strength-microamp = <3000>;
		};
	};
};

