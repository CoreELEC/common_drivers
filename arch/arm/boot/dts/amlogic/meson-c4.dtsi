	emmc_pins: emmc {
		mux {
			groups = "emmc_d0",
				 "emmc_d1",
				 "emmc_d2",
				 "emmc_d3",
				 "emmc_d4",
				 "emmc_d5",
				 "emmc_d6",
				 "emmc_d7",
				 "emmc_clk",
				 "emmc_cmd";
			function = "emmc";
			bias-pull-up;
			input-enable;
			drive-strength-microamp = <3000>;
		};
		mux1 {
			groups = "emmc_ds";
			function = "emmc";
			input-enable;
			bias-pull-down;
			drive-strength-microamp = <3000>;
		};
		mux2 {
			groups = "emmc_reset";
			function = "emmc";
			bias-pull-up;
			drive-strength-microamp = <3000>;
		};
	};

