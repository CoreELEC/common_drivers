			groups = "i2c2_sda_h3",
				"i2c2_scl_h2";
			function = "i2c2";
			drive-strength-microamp = <3000>;
			bias-disable;
		};
	};

	i2c2_pins4_sleep:i2c2_pins4_sleep {
		mux {
			groups = "GPIOH_3",
				"GPIOH_2";
			function = "gpio_periphs";
