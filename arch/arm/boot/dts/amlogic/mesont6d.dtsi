		};
	};

	i2c2_pins2_sleep:i2c2_pins2_sleep {
		mux {
			groups = "GPIOH_21",
				"GPIOH_20";
			function = "gpio_periphs";
			input-enable;
		};
	};

	i2c2_pins3:i2c2_pins3 {
