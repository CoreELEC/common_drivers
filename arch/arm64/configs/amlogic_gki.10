# SPDX-License-Identifier: (GPL-2.0+ OR MIT)

# build in for amlogic memory change
CONFIG_AMLOGIC_MEMORY_EXTEND=y
CONFIG_AMLOGIC_MEM_DEBUG=y
CONFIG_AMLOGIC_CMA=y
CONFIG_AMLOGIC_MIX_ZRAM=y
CONFIG_AMLOGIC_PAGE_TRACE=y
CONFIG_AMLOGIC_SWAPD_OPT=y

# break gki_20
CONFIG_AMLOGIC_BREAK_GKI_20=y

# amlogic-thermal.ko(dvfs need)
CONFIG_THERMAL_GOV_STEP_WISE=n
CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR=y

CONFIG_PANIC_TIMEOUT=5
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_CFG80211_CERTIFICATION_ONUS=y

# amlogic skip incfs invalid data
CONFIG_AMLOGIC_INCFS_FIX=y
