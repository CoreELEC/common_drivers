		dolby_fw: dolby_fw {
			compatible = "amlogic, dolby_fw";
			mem_size = <0x100000>;
			status = "okay";
		};

		pcie_phy0: phy@fe4d4000 {
			compatible = "amlogic,a9-pcie-phy";
			reg = <0x0 0xfe4d4000 0x0 0x800
				0x0 0xfe002040 0x0 0x10
				0x0 0xfe01034c 0x0 0x4>;
			reg-names = "phy", "reset", "efuse";

			clocks = <&clkc CLKID_SYS_PCIEPHY>,
				<&clkc CLKID_SYS_PERIPH>;
			clock-names = "pcie_phy", "pcie_apb_bus";
			num-lanes = <1>;
			port-num = <0>;

			pll_setting_number = <7>;
			/* <reg_offset vlaue> */
			phy_pll_setting_1 = <0x0018 0x1f455ed>;
			phy_pll_setting_2 = <0x001c 0x909e7e5>;
			phy_pll_setting_3 = <0x0018 0xdf455ed>;
			phy_pll_setting_4 = <0x0020 0xa03b9788>;
			phy_pll_setting_5 = <0x000c 0x40000071>;
			phy_pll_setting_6 = <0x000c 0x4000007d>;
			/* open ssc 5000 ppm
			 * phy_pll_setting_7 = <0x0014 0x2328e050>;
			 */
			phy_pll_setting_7 = <0x017c 0x3000000>;

			resets = <&reset RESET_PCIEA_PIPE>,
				<&reset RESET_PCIE_A_POR>,
				<&reset RESET_PCIEA_PHY>,
				<&reset RESET_PCIEA_MAC_APB>,
				<&reset RESET_PCIEA_PHY_APB>,
				<&reset RESET_PCIEA_0>,
				<&reset RESET_PCIEA_1>,
				<&reset RESET_PCIEA_2>,
				<&reset RESET_PCIEA_3>,
				<&reset RESET_PCIEA_4>,
				<&reset RESET_PCIEA_5>,
				<&reset RESET_PCIEA_6>,
				<&reset RESET_PCIEA_7>;
			reset-names = "pipe", "por", "phy", "mac_apb", "phy_apb", "rst0",
					"rst1", "rst2", "rst3", "rst4", "rst5", "rst6", "rst7";
			pcie_rst_number = <1>;
			/* <reg_offset vlaue> */
			pcie_rst_1 = <0x04 0xFF007800>;
			pcie-phy-apb-rst = <0x4 0x400>;
			#phy-cells = <0>;
			power-domains = <&pwrdm PDID_A9_PCIE3PHY>;
			status = "disabled";
		};

		pcie_phy1: phy1@fe4d4000 {
			compatible = "amlogic,a9-pcie-phy";
			reg = <0x0 0xfe4d4000 0x0 0x1800
				0x0 0xfe002040 0x0 0x10
				0x0 0xfe01034c 0x0 0x4>;
			reg-names = "phy", "reset", "efuse";

			clocks = <&clkc CLKID_SYS_PCIEPHY>,
				<&clkc CLKID_SYS_PERIPH>;
			clock-names = "pcie_phy", "pcie_apb_bus";
			num-lanes = <1>;
			port-num = <1>;

			/* port B X1 */
			pll_setting_number = <11>;
			/* <reg_offset vlaue> */
			phy_pll_setting_1 = <0x0018 0x1f455ed>;
			phy_pll_setting_2 = <0x001c 0x909e7e5>;
			phy_pll_setting_3 = <0x0018 0xdf455ed>;
			phy_pll_setting_4 = <0x0020 0xa03b9788>;
			phy_pll_setting_5 = <0x000c 0x40000071>;
			phy_pll_setting_6 = <0x000c 0x4000007d>;
			phy_pll_setting_7 = <0x017c 0x3000000>;

			phy_pll_setting_8 = <0x1020 0xa03b9788>;
			phy_pll_setting_9 = <0x100c 0x40000071>;
			phy_pll_setting_10 = <0x100c 0x4000007d>;
			/* open ssc 5000 ppm
			 * phy_pll_setting_11 = <0x0014 0x2328e050>;
			 * phy_pll_setting_12 = <0x1014 0x2328e050>;
			 */
			phy_pll_setting_11 = <0x117c 0x3000000>;

			resets = <&reset RESET_PCIEB_PIPE>,
				<&reset RESET_PCIE_B_POR>,
				<&reset RESET_PCIEB_PHY>,
				<&reset RESET_PCIEB_MAC_APB>,
				/* <&reset RESET_PCIEA_PHY_APB>, */
				<&reset RESET_PCIEB_0>,
				<&reset RESET_PCIEB_1>,
				<&reset RESET_PCIEB_2>,
				<&reset RESET_PCIEB_3>,
				<&reset RESET_PCIEB_4>,
				<&reset RESET_PCIEB_5>,
				<&reset RESET_PCIEB_6>,
				<&reset RESET_PCIEB_7>;
			reset-names = "pipe", "por", "phy", "mac_apb", "rst0",
					"rst1", "rst2", "rst3", "rst4", "rst5", "rst6", "rst7";
			pcie_rst_number = <2>;
			/* <reg_offset vlaue> */
			pcie_rst_1 = <0x04 0x18>;
			pcie_rst_2 = <0x0c 0x1FF8>;
			pcie-phy-apb-rst = <0x4 0x400>;
			#phy-cells = <0>;
			power-domains = <&pwrdm PDID_A9_PCIE3PHY>;
			status = "disabled";
		};

		pcie_phy2: phy@fe4c4000 {
			compatible = "amlogic,a9-pcie-phy";
			reg = <0x0 0xfe4c4000 0x0 0x800
				0x0 0xfe002040 0x0 0x10
				0x0 0xfe01034c 0x0 0x4>;
			reg-names = "phy", "reset", "efuse";

			clocks = <&clkc CLKID_SYS_PCIEPHY>,
				<&clkc CLKID_SYS_PERIPH>;
			clock-names = "pcie_phy", "pcie_apb_bus";
			num-lanes = <1>;
			port-num = <2>;

			pll_setting_number = <7>;
			/* <reg_offset vlaue> */
			phy_pll_setting_1 = <0x0014 0x01f455ed>;
			phy_pll_setting_2 = <0x0018 0x0909e7e5>;
			phy_pll_setting_3 = <0x0014 0x0df455ed>;
			phy_pll_setting_4 = <0x0028 0xa03b9788>;
			phy_pll_setting_5 = <0x001c 0x40000071>;
			phy_pll_setting_6 = <0x001c 0x4000007d>;
			/* open ssc 5000 ppm
			 * phy_pll_setting_7 = <0x0024 0x2328e050>;
			 */
			phy_pll_setting_7 = <0x017c 0x3000000>;

			resets = <&reset RESET_U3HSG_PCIE_PIPE>,
				<&reset RESET_PCIE_B_POR>,
				<&reset RESET_U3HSG_PCIE2_PHY>,
				<&reset RESET_PCIEB_MAC_APB>,
				<&reset RESET_U3HSG_PCIE2_PHY_APB>,
				<&reset RESET_PCIEB_0>,
				<&reset RESET_PCIEB_1>,
				<&reset RESET_PCIEB_2>,
				<&reset RESET_PCIEB_3>,
				<&reset RESET_PCIEB_4>,
				<&reset RESET_PCIEB_5>,
				<&reset RESET_PCIEB_6>,
				<&reset RESET_PCIEB_7>;
			reset-names = "pipe", "por", "phy", "mac_apb", "phy_apb", "rst0",
					"rst1", "rst2", "rst3", "rst4", "rst5", "rst6", "rst7";
			pcie_rst_number = <2>;
			/* <reg_offset vlaue> */
			pcie_rst_1 = <0x04 0x18>;
			pcie_rst_2 = <0x0c 0x1FF8>;
			pcie-phy-apb-rst = <0x4 0x400>;
			#phy-cells = <0>;
			power-domains = <&pwrdm PDID_A9_U3HSG_PCIE2>;
			status = "disabled";
		};

		pcie_a: pcie@f4000000 {
			compatible = "amlogic, amlogic-pcie-v4";
			reg = <0x0 0xf4000000 0x0 0x400000
				0x0 0xfe4d0000 0x0 0x1000
				0x0 0xf4400000 0x0 0x200000
				0x0 0xfe002040 0x0 0x10>;
			reg-names = "dbi", "cfg", "config", "reset";
			linux,pci-domain = <0>;
			bus-range = <0x0 0xff>;
			#address-cells = <3>;
			#size-cells = <2>;
			interrupts = <GIC_SPI 293 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "msi";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0>;
			interrupt-map = <0 0 0 0 &gic GIC_SPI 303 IRQ_TYPE_EDGE_RISING>;
			device_type = "pci";
			ranges =
				/* downstream I/O */
				<0x81000000 0 0 0 0xf4600000 0x0 0x200000>,
				/* non-prefetchable memory */
				<0x82000000 0 0xf4800000 0x0 0xf4800000 0 0x3800000>;
			num-lanes = <1>;
			port-num = <0>;
			phys = <&pcie_phy0>;
			phy-names = "pcie-phy";
			/*
			 * pinctrl-names = "default";
			 * pinctrl-0 = <&pcieck_pins>;
			 */

			clocks = <&clkc CLKID_SYS_PCIEMAC_A>,
				 <&clkc CLKID_SYS_PCIEPHY>,
				 <&clkc CLKID_PCIE0_TL>,
				 <&clkc CLKID_PP>;
			clock-names = "pcie_mac", "pcie_phy", "pcie_tl", "pp_clk";
			pcie_tl_clk = <20000000>;
			assigned-clocks = <&clkc CLKID_PP>;
			assigned-clock-rates = <400000000>;

			/*reset-gpio-type
			 *0:Shared pad(no reset)
			 *1:OD pad2:Normal pad
			 */
			gpio-type = <2>;
			pcie_rst_number = <1>;
			/* <reg_offset vlaue> */
			pcie_rst_1 = <0x04 0xFF007800>;
			pcie-phy-apb-rst = <0x4 0x400>;
			power-domains = <&pwrdm PWRC_A9_PCIE_A_ID>;
			status = "disabled";
			dma-ranges = <0x0 0x0 0x0 0x0 0x0 0x0 0xe0000000>;
		};

		pcie_b: pcie@f8000000 {
			compatible = "amlogic, amlogic-pcie-v4";
			reg = <0x0 0xf8000000 0x0 0x400000
				0x0 0xfe4d2000 0x0 0x1000
				0x0 0xf8400000 0x0 0x200000
				0x0 0xfe002040 0x0 0x10>;
			reg-names = "dbi", "cfg", "config", "reset";
			linux,pci-domain = <1>;
			bus-range = <0x0 0xff>;
			#address-cells = <3>;
			#size-cells = <2>;
			interrupts = <GIC_SPI 325 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "msi";
			#interrupt-cells = <1>;
			interrupt-map-mask = <0 0 0 0>;
			interrupt-map = <0 0 0 0 &gic GIC_SPI 335 IRQ_TYPE_EDGE_RISING>;
			device_type = "pci";
			ranges =
				/* downstream I/O */
				<0x81000000 0 0 0 0xf8600000 0x0 0x200000>,
				/* non-prefetchable memory */
				<0x82000000 0 0xf8800000 0x0 0xf8800000 0 0x3800000>;
			num-lanes = <1>;
			port-num = <1>;
			phys = <&pcie_phy2>;
			phy-names = "pcie-phy";
			/*
			 * pinctrl-names = "default";
			 * pinctrl-0 = <&pcieck_pins>;
			 */

			clocks = <&clkc CLKID_SYS_PCIEMAC_B>,
				 <&clkc CLKID_PCIE1_TL>,
				 <&clkc CLKID_PP>;
			clock-names = "pcie_mac", "pcie_tl", "pp_clk";
			pcie_tl_clk = <20000000>;
			assigned-clocks = <&clkc CLKID_PP>;
			assigned-clock-rates = <400000000>;

			/*reset-gpio-type
			 *0:Shared pad(no reset)
			 *1:OD pad2:Normal pad
			 */
			gpio-type = <1>;
			pcie_rst_number = <2>;
			/* <reg_offset vlaue> */
			pcie_rst_1 = <0x04 0x18>;
			pcie_rst_2 = <0x0c 0x1FF8>;
			pcie-phy-apb-rst = <0x4 0x400>;
			power-domains = <&pwrdm PWRC_A9_PCIE_B_ID>;
			status = "disabled";
			dma-ranges = <0x0 0x0 0x0 0x0 0x0 0x0 0xe0000000>;
		};

		sd_emmc_c: mmc@fe08c000 {
			compatible = "amlogic,meson-v8-mmc";
			reg = <0x0 0xfe08c000 0x0 0x1000>,
				<0x0 0xfe000294 0x0 0x4>,
				<0x0 0xfe004000 0x0 0x4>;
			interrupts = <GIC_SPI 178 IRQ_TYPE_EDGE_RISING>;
			status = "disabled";
			clocks = <&clkc CLKID_SYS_SD_EMMC_C>,
				<&clkc CLKID_SD_EMMC_C_MUX>,
				 <&clkc CLKID_SD_EMMC_C>,
				 <&xtal>,
				 <&clkc CLKID_GP0_PLL>,
				 <&clkc CLKID_GP0_PLL>;
			clock-names = "core", "mux0", "mux1",
					"clkin0", "clkin1", "clkin2";
			no-sdio;
			no-sd;
			card_type = <1>;
			ignore_desc_busy;
			mmc_debug_flag;
			src_clk_rate = <1152000000>;
			assigned-clocks = <&clkc CLKID_GP0_PLL>,
					    <&clkc CLKID_SD_EMMC_C>;
			assigned-clock-rates = <1152000000>,
						 <1152000000>;
			tx_delay = <16>;
			cap-mmc-crypto;
			cap-mmc-64bit-dma;
			mmc-hs400-enhanced-strobe;
		//	power-domains=<&pwrdm PDID_A9_SD_EMMC_C>;
		//	nwr_cnt = <0>;
		//	resets = <&reset RESET_SD_EMMC_C>;
		};

		sd_emmc_b: sd@fe08a000 {
			compatible = "amlogic,meson-v8-mmc";
			reg = <0x0 0xfe08a000 0x0 0x1000>,
				<0x0 0xfe000290 0x0 0x4>,
				<0x0 0xffa04010 0x0 0x4>;
			interrupts = <GIC_SPI 177 IRQ_TYPE_EDGE_RISING>;
			status = "disabled";
			clocks = <&clkc CLKID_SYS_SD_EMMC_B>,
				<&clkc CLKID_SD_EMMC_B_MUX>,
				 <&clkc CLKID_SD_EMMC_B>,
				 <&xtal>,
				 <&scmi_clk CLKID_FCLK_DIV2>;
			clock-names = "core", "mux0", "mux1",
					"clkin0", "clkin1";
			card_type = <5>;
			mmc_debug_flag;
			no-mmc;
			no-sdio;
			power-domains=<&pwrdm PWRC_A9_SD_EMMC_B_ID>;
			//resets = <&reset RESET_SD_EMMC_B>;
		};

		sd_emmc_a: sdio@fe088000 {
			compatible = "amlogic,meson-v8-mmc";
			reg = <0x0 0xfe088000 0x0 0x1000>,
				<0x0 0xfe000290 0x0 0x4>,
				<0x0 0xfe00400c 0x0 0x4>;
			interrupts = <GIC_SPI 176 IRQ_TYPE_LEVEL_HIGH>;
			status = "disabled";
			clocks = <&clkc CLKID_SYS_SD_EMMC_A>,
				<&clkc CLKID_SD_EMMC_A_MUX>,
				 <&clkc CLKID_SD_EMMC_A>,
				 <&xtal>,
				 <&scmi_clk CLKID_FCLK_DIV2>;
			clock-names = "core", "mux0", "mux1",
					"clkin0", "clkin1";
			card_type = <3>;
			mmc_debug_flag;
			cap-sdio-irq;
			keep-power-in-suspend;
			use_intf3_tuning;
			no-mmc;
			no-sd;
			power-domains=<&pwrdm PWRC_A9_SD_EMMC_A_ID>;
			//resets = <&reset RESET_SD_EMMC_A>;
		};

		mtd_nand: nfc@fe08c800 {
			compatible = "amlogic,meson-nfc-single-ecc-bl2ex";
			status = "disabled";
			reg = <0x0 0xfe08c800 0x0 0x200>;
			interrupts = <GIC_SPI 175 IRQ_TYPE_EDGE_RISING>;

			//clocks = <&clkc CLKID_SD_EMMC_C>,
			//	   <&scmi_clk CLKID_FCLK_DIV2>;
			//clock-names = "gate", "fdiv2pll";
			nand_clk_ctrl = <0xfe08c000>;
		};

		serdes0: hsgmii-phy@fe4c2000 {
			compatible = "amlogic,hsgmii-phy";
			reg = <0x0 0xfe4c2000 0x0 0x22c>;
			clocks = <&clkc CLKID_SYS_U3HSG>;
			clock-names = "hsg_general";
			resets = <&reset RESET_HSG>,
				 <&reset RESET_U3HSG_HSG>;
			reset-names = "hsg_rst", "hsg_apb_rst";
			hsg-trim-reg = <0xfe01034c>;
			u3hsg-combo-reg = <0xfe0086e0>;
			combo-hsg-sel-val = <0x0>;
			#phy-cells = <0>;
			power-domains=<&pwrdm PWRC_A9_U3HSG_HSG_ID>;
			status = "disabled";
		};

		ethmac_a: ethernet@fe498000 {
			compatible = "amlogic,meson-axg-dwmac",
				     "snps,dwmac-4.00";
			reg = <0x0 0xfe498000 0x0 0x12ec>,
			      <0x0 0xfe494000 0x0 0x2c>;
			interrupts = <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq";
			clocks = <&clkc CLKID_SYS_ETH>,
				 <&scmi_clk CLKID_FCLK_DIV2>,
				 <&scmi_clk CLKID_FCLK_50M>,
				 <&clkc CLKID_SYS_PERIPH>;
			clock-names = "stmmaceth", "clkin0", "clkin1", "sys_apb";
			// resets = <&reset RESET_ETH>;
			// reset-names = "stmmaceth";
			rx-fifo-depth = <4096>;
			tx-fifo-depth = <4096>;
			mboxes = <&mbox_fifo A9_REE2AO_ETH>;
			internal_phy = <2>;
			/* ignore integrated PCS link states */
			amlogic,ignore-pcs-stats;
			power-domains=<&pwrdm PWRC_A9_ETH_ID>;
			status = "disabled";

			ext_mdio_a: mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				compatible = "snps,dwmac-mdio";
				status = "disabled";

				external_phy_a: ethernet-phy@0 {
						reg = <0>;
						max-speed = <1000>;

						reset-assert-us = <20000>;
						reset-deassert-us = <50000>;
						reset-gpios = <&gpioz 15 (GPIO_ACTIVE_LOW |
									GPIO_OPEN_DRAIN)>;
						realtek,clkout-disable;
						realtek,aldps-enable;
				};
			};
		};

		ethmac_b: ethernet@fe4e8000 {
			compatible = "amlogic,meson-axg-dwmac",
				     "snps,dwmac-4.00";
			reg = <0x0 0xfe4e8000 0x0 0x12ec>,
			      <0x0 0xfe4e4000 0x0 0x2c>;
			interrupts = <GIC_SPI 190 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "macirq";
			clocks = <&clkc CLKID_SYS_ETH_1G_MAC>,
				 <&scmi_clk CLKID_FCLK_DIV2>,
				 <&scmi_clk CLKID_FCLK_50M>,
				 <&clkc CLKID_SYS_PERIPH>;
			clock-names = "stmmaceth", "clkin0", "clkin1", "sys_apb";
			// resets = <&reset RESET_ETH_1G>;
			// reset-names = "stmmaceth";
			rx-fifo-depth = <4096>;
			tx-fifo-depth = <4096>;
			mboxes = <&mbox_fifo A9_REE2AO_ETH>;
			// amlogic,smc-id = <0x8200009d>;
			internal_phy = <2>;
			power-domains=<&pwrdm PWRC_A9_ETH_1G_ID>;
			status = "disabled";

			ext_mdio_b: mdio {
				#address-cells = <1>;
				#size-cells = <0>;
				compatible = "snps,dwmac-mdio";
				status = "disabled";

				external_phy_b: ethernet-phy@0 {
						reg = <0>;
						max-speed = <1000>;

						reset-assert-us = <20000>;
						reset-deassert-us = <50000>;
						reset-gpios = <&gpioa 15 (GPIO_ACTIVE_LOW |
									GPIO_OPEN_DRAIN)>;
						realtek,clkout-disable;
						realtek,aldps-enable;
				};
			};
		};

		uart_A: serial@fe078000 {
			compatible = "amlogic,meson-uart";
			reg = <0x0 0xfe078000 0x0 0x18>;
			interrupts = <GIC_SPI 168 IRQ_TYPE_EDGE_RISING>;
			status = "disabled";
			clocks = <&xtal>,
				 <&clkc CLKID_SYS_UART_A>;
			clock-names = "clk_uart", "clk_gate";
			fifosize = < 64 >;
			pinctrl-names = "default";
			pinctrl-0 = <&a_uart_pins>;
		};

		uart_F: serial@fe082000 {
			compatible = "amlogic,meson-uart";
			reg = <0x0 0xfe082000 0x0 0x18>;
			interrupts = <GIC_SPI 167 IRQ_TYPE_EDGE_RISING>;
			status = "disabled";
			clocks = <&xtal>,
				 <&clkc CLKID_SYS_UART_F>;
			clock-names = "clk_uart", "clk_gate";
			fifosize = < 64 >;
			pinctrl-names = "default";
			pinctrl-0 = <&f_uart_pins>;
		};
	};

	mesonstream {
		compatible = "amlogic, codec, streambuf";
		dev_name = "mesonstream";
		status = "okay";
	};

	vcodec_dos_dev: vcodec_dos_dev {
		compatible = "amlogic, cpu-major-id-a9";
		dev_name = "vcodec_dos_dev";
		status = "okay";
		reg = <0x0 0xfe320000 0x0 0x10000>,
			<0x0 0xfe036000 0x0 0x2000>,
			<0x0 0xfe010000 0x0 0x2000>;
		reg-names = "dosbus",
			"dmcbus",
			"sysctrl";
		clocks = <&clkc CLKID_SYS_DOS>,
			 <&clkc CLKID_HCODEC>,
			 <&clkc CLKID_HEVCF>;
		clock-names = "vdec",
			"clk_hcodec_mux",
			"clk_hevcf_mux";
		assigned-clocks = <&scmi_clk CLKID_GP1_PLL>;
		assigned-clock-rates = <852000000>;
	};

	vdec {
		compatible = "amlogic, vdec-pm-pd";
		dev_name = "vdec.0";
		status = "okay";
		interrupts = <0 3 1
			0 155 1
			0 32 1
			0 87 1
			0 88 1
			0 89 1
			0 252 1
			0 201 1
			0 113 1>;
		interrupt-names = "vsync",
			"demux",
			"parser",
			"mailbox_0",
			"mailbox_1",
			"mailbox_2",
			"assist_mbox_irq_ee",
			"viff_empty",
			"axi_monitor";
		power-domains = <&pwrdm PWRC_A9_DOS_HEVC_ID>,
			<&pwrdm PWRC_A9_DOS_HCODEC_ID>;
		power-domain-names = "pwrc-hevc",
			"pwrc-hcodec";
		reset-names = "hevcf_dmc_pipel";
		resets = <&reset RESET_BRG_HEVCF_DMC_PIPEL>;
	};

	vcodec_dec {
		compatible = "amlogic, vcodec-dec";
		dev_name = "aml-vcodec-dec";
		status = "okay";
	};

	ddr_bandwidth {
		compatible = "amlogic,ddr-bandwidth-a9";
		status = "okay";
		reg = <0x0 0xfe036000 0x0 0x1000
		       0x0 0xfe036ca8 0x0 0x4>;
		interrupts = <0 78 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "ddr_bandwidth";
	};

	dmc_monitor {
		compatible = "amlogic,dmc_monitor-a9";
		status = "okay";
		memory-region = <&dmc_reserved>;
		reg = <0x0 0xfe036000 0x0 0x1000>;
		reg_base = <0xfe036000>;
		interrupts = <0 62 IRQ_TYPE_LEVEL_HIGH
			      0 61 IRQ_TYPE_EDGE_RISING>;
	};

	tx_venc: tx_venc {
		compatible = "amlogic, tx-venc-a9";
		status = "okay";
		reg = <0x0 0xFF500000 0x0 0x3ffff>;
		reg-names = "vcbus";
		venc_offset = <0x0 0x600>;
	};

	tx_phy: tx_phy {
		compatible = "amlogic, tx-phy-a9";
		reg = <0x0 0xfe008000 0x0 0x1000>,
		      <0x0 0xfe48c000 0x0 0x100>;
		reg-names = "anactrl_typec_dp_reg", "dpphy_ctrl_reg";
		dptx-aux-gpios = <&gpiocc 0 GPIO_ACTIVE_HIGH
				  &gpiocc 1 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	dptx_clk: dptx_clk {
		compatible = "amlogic, tx-clk-a9";
		status = "okay";
		reg = <0x0 0xFE016000 0x0 0x2000
			0x0 0xfe000000 0x0 0x2000>;
		reg-names = "ana_ctrl",
			"clk_ctrl";
	};

	dptx: dptx {
		compatible = "amlogic, dptx-a9";
		dev_name = "dptx";
		status = "disabled";
		tx_phy = <&tx_phy>;
		tx_clk = <&dptx_clk>;
		dev_index = <0>;
		interrupts = <GIC_SPI 285 IRQ_TYPE_LEVEL_HIGH
			GIC_SPI 286 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "apb_dp_int", "hdcp2tx_intr";

		reg = <0x0 0xFE484000 0x0 0x2000
			0x0 0xFE010000 0x0 0x2000
			0x0 0xFE016000 0x0 0x2000
			0x0 0xFE00C000 0x0 0x2000
			0x0 0xFE002000 0x0 0x2000
			0x0 0xFE000000 0x0 0x2000
			0x0 0xFF500000 0x0 0x3ffff
			0x0 0xFE004000 0x0 0x2000>;
		reg-names = "dptx",
			"sys_ctrl",
			"ana_ctrl",
			"pwr_ctrl",
			"reset_ctrl",
			"clk_ctrl",
			"vpu_ctrl",
			"pad_ctrl";
		ports {
			port {
				#address-cells = <1>;
				#size-cells = <0>;
				dptx_to_drm: endpoint@0 {
					reg = <0>;
					remote-endpoint = <0>;
				};
			};
		};
	};

	/* Used by the edptx driver */
	dptx_core: dptx_core {
		compatible = "amlogic, dptx-core-a9";
		dev_name = "dptx_core";
		status = "disabled";
		tx_phy = <&tx_phy>;
		tx_clk = <&dptx_clk>;
		dev_index = <1>;

		reg = <0x0 0xFE074000 0x0 0x2000
			0x0 0xFE010000 0x0 0x2000
			0x0 0xFE016000 0x0 0x2000
			0x0 0xFE00C000 0x0 0x2000
			0x0 0xFE002000 0x0 0x2000
			0x0 0xFE000000 0x0 0x2000
			0x0 0xFF500000 0x0 0x3ffff
			0x0 0xFE004000 0x0 0x2000>;
		reg-names = "edptx",
			"sys_ctrl",
			"ana_ctrl",
			"pwr_ctrl",
			"reset_ctrl",
			"clk_ctrl",
			"vpu_ctrl",
			"pad_ctrl";
		ports {
			port {
				#address-cells = <1>;
				#size-cells = <0>;
				edp_to_drm: endpoint@0 {
					reg = <0>;
					remote-endpoint = <0>;
				};
			};
		};
	};

	amhdmitx: amhdmitx{
		compatible = "amlogic, amhdmitx-a9";
		dev_name = "amhdmitx";
		status = "disabled";
		//power-domains = <&pwrdm PDID_T7_VI_CLK2>;
		vend-data = <&vend_data>;
		pinctrl-names="hdmitx_hpd", "hdmitx_ddc";
		pinctrl-0=<&hdmitx_hpd>;
		pinctrl-1=<&hdmitx_ddc>;
		hdmitx-gpios-hpd = <&gpioh 6 GPIO_ACTIVE_HIGH>;
		hdmitx-gpios-scl = <&gpioh 5 GPIO_ACTIVE_HIGH>;
		hdmitx-gpios-sda = <&gpioh 4 GPIO_ACTIVE_HIGH>;
		interrupts = <GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH
			GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "hdmitx_hpd", "hdmitx_vsync";
		enc_idx = <0>;
		max_refresh_rate = <120>; /* the max fresh_rate of A9 is upto 120hz */
		reg =	<0x0 0xff500000 0x0 0x40000>,
			<0x0 0xfe310000 0x0 0x10000>,
			<0x0 0xfe300000 0x0 0x10000>,
			<0x0 0xfe010000 0x0 0x2000>,
			<0x0 0xfe00c000 0x0 0x2000>,
			<0x0 0xfe008000 0x0 0x2000>,
			<0x0 0xfe002000 0x0 0x2000>,
			<0x0 0xfe000000 0x0 0x2000>,
			<0x0 0xfe004000 0x0 0x2000>;
		reg-names = "vpu",
			    "hdmitxcor",
			    "hdmitxtop",
			    "sysctrl",
			    "pwrctrl",
			    "anactrl",
			    "resetctrl",
			    "clkctrl",
			    "padctrl";
		frac_enable = <1>;

		vend_data: vend_data{ /* Should modified by Customer */
			vendor_name = "CUS_NAME"; /* Max Chars: 8 */
			product_desc = "PRODUCT_NAME"; /* Max Chars: 16 */
			/* standards.ieee.org/develop/regauth/oui/oui.txt */
			vendor_id = <0x000000>;
		};

		ports {
			port {
				#address-cells = <1>;
				#size-cells = <0>;
				hdmitx_to_drm: endpoint@0 {
					reg = <0>;
					remote-endpoint = <0>;
				};
			};
		};
	};

	aocec: aocec {
		compatible = "amlogic, aocec-a9";
		dev_name = "aocec";
		status = "okay";
		vendor_name = "Amlogic"; /* Max Chars: 8     */
		/* Refer to the following URL at:
		 * http://standards.ieee.org/develop/regauth/oui/oui.txt
		 */
		vendor_id = <0xffffff>;
		product_desc = "A9"; /* Max Chars: 16    */
		cec_osd_string = "AML_MBOX"; /* Max Chars: 14    */
		cec_version = <5>;/*5:1.4;6:2.0*/
		port_num = <1>;
		cec_sel = <1>;/*1:use one ip, 2:use 2 ip*/
		ee_cec;
		arc_port_mask = <0x1>;
		interrupts = <GIC_SPI 407 IRQ_TYPE_EDGE_RISING>;/*1:ts*/
		interrupt-names = "hdmi_aocecb";
		pinctrl-names = "default","hdmitx_aocecb","cec_pin_sleep";
		pinctrl-0=<&eecec_b>;
		pinctrl-1=<&eecec_b>;
		pinctrl-2=<&eecec_b>;
		clocks = <&ao_clkc CLKID_AO_CECB_CLK>;
		clock-names = "cecb_clk";
		assigned-clocks = <&ao_clkc CLKID_AO_CECB_DUAL>;
		assigned-clock-rates = <32768>;
		reg = <0x0 0xffa16000 0x0 0x2ff
		       0x0 0xfe010000 0x0 0xfff
		       0x0 0xffa00000 0x0 0xfff
		       0x0 0xfe004000 0x0 0x2000>;
		reg-names = "ao","periphs","clock","pad_reg";
		mbox-names = "mbox_cec";
		mboxes = <&mbox_fifo A9_REE2AO_AOCEC>;
	};

	aml_dma {
		compatible = "amlogic,aml_p1_dma";
		reg = <0x0 0xfe440400 0x0 0x48>;
		interrupts = <0 24 1>;
		dma_bus64 = /bits/ 8 <0x1>;

		aml_aes {
			compatible = "amlogic,aes_g12a_dma";
			dev_name = "aml_aes_dma";
			status = "okay";
			iv_swap = /bits/ 8 <0x0>;
		};

		aml_sha {
			compatible = "amlogic,sha_dma";
			dev_name = "aml_sha_dma";
			hw_ctx_sz = /bits/ 32 <0x28>;
			status = "okay";
		};

		aml_sha3 {
			compatible = "amlogic,sha3_dma";
			dev_name = "aml_sha3_dma";
			status = "okay";
		};

		aml_tdes {
			compatible = "amlogic,des_dma,tdes_dma";
			dev_name = "aml_tdes_dma";
			status = "okay";
		};

		aml_sm4 {
			compatible = "amlogic,sm4_dma";
			dev_name = "aml_sm4_dma";
			status = "okay";
			iv_swap = /bits/ 8 <0x0>;
		};

		crypto {
			compatible = "amlogic,crypto_s5";
			dev_name = "aml_crypto_dev";
			status = "okay";
			thread = /bits/ 8 <0x1>;
			interrupts = <0 25 1>;
		};
	};

	rng {
		compatible = "amlogic,meson-rng";
		status = "okay";
		#address-cells = <2>;
		#size-cells = <2>;
		reg = <0x0 0xfe440788 0x0 0x0c>;
		quality = /bits/ 16 <1000>;
		version = <2>;
	};

	canvas: canvas{
		compatible = "amlogic, meson, canvas";
		status = "okay";
	};

	codec_io: codec_io {
		compatible = "amlogic, meson-a9, codec-io";
		status = "okay";
		#address-cells=<2>;
		#size-cells=<2>;
		ranges;
		reg =	<0x0 0xfe002000 0x0 0x2000>,
			<0x0 0xfe320000 0x0 0x10000>,
			<0x0 0x0 0x0 0x0>,
			<0x0 0x0 0x0 0x00>,
			<0x0 0xff500000 0x0 0x40000>,
			<0x0 0xfe036000 0x0 0x2000>,
			<0x0 0x0 0x0 0x0>;
		reg-names = "cbus",
			    "dosbus",
			    "hiubus",
			    "aobus",
			    "vcbus",
			    "dmcbus",
			    "efusebus";
	};

	tahoe_enc {
		compatible = "amlogic, tahoe";
		dev_name = "tahoe";
		status = "okay";
		clocks = <&clkc CLKID_HCODEC>;
		clock-names = "clk_tahoe";
		interrupts = <GIC_SPI 259 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "tahoe_irq0";
		power-domains = <&pwrdm PWRC_A9_TAHOE_ID>;
		reset-names = "tahoe_core_rst", "tahoe_a_rst", "tahoe_apb_rst", "tahoe_sys_rst";
		resets = <&reset RESET_TAHOE_CORE>,
			<&reset RESET_TAHOE>,
			<&reset RESET_TAHOE_APB>,
			<&reset RESET_TAHOE_SYS>;
		#address-cells=<2>;
		#size-cells=<2>;
		ranges;
		io_reg_base {
			reg = <0x0 0xfe370000 0x0 0x10000>;
		};
	};

	jpegenc{
		compatible = "amlogic, jpegenc";
		dev_name = "jpegenc";
		status = "okay";
		clocks = <&clkc CLKID_SYS_DOS>,
			<&clkc CLKID_HCODEC>;
		clock-names =
			"clk_dos",
			"clk_jpeg_enc";

		power-domains = <&pwrdm PWRC_A9_DOS_HCODEC_ID>;
		interrupts = <0 87 1 0 88 1 0 89 1>;
		interrupt-names = "dos_mbox_slow_irq0", "dos_mbox_slow_irq1", "dos_mbox_slow_irq2";
		//reset-names = "jpegenc_rst";
		//resets = <&reset RESET_BRG_HCODEC_PIPL0>;
	};

	vpu: vpu {
		compatible = "amlogic, vpu-a9";
		status = "okay";
		reg =	<0x0 0xfe000000 0x0 0x2000    /* clk */
			 0x0 0xfe00c000 0x0 0x70     /* pwrctrl */
			 0x0 0xff500000 0x0 0x40000>; /* vcbus */
		clocks = <&clkc CLKID_VAPB>,
			 <&clkc CLKID_VPU>;
		clock-names =	"vapb_clk",
				"vpu_clk";
		clk_level = <8>;
		/* 0: 24.0M  1: 100.0M    2: 166.7M    3: 200.0M    4: 250.0M */
		/* 5: 333.3M    6: 400.0M    7: 500.0M    8: 666.7M */
	};

	rdma {
		compatible = "amlogic, meson-t3, rdma";
		status = "okay";
		interrupts = <GIC_SPI 215 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "rdma";
		/* after sc2 */
		reset-names = "rdma";
		resets = <&reset RESET_RDMA>;
		rdma_table_page_count = <16>;
	};

	amlvecm: amlvecm {
		compatible = "amlogic, vecm-a9";
		dev_name = "aml_vecm";
		status = "okay";
		gamma_en = <0>;/*1:enable ;0:disable*/
		wb_en = <0>;/*1:enable ;0:disable*/
		/*0: 709/601  1: bt2020*/
		tx_op_color_primary = <0>;
	};

	aml_primesl {
		compatible = "amlogic, prime_sl_a9";
		dev_name = "amprime_sl";
		status = "okay";
	};

	multi-di {
		compatible = "amlogic, dim-a9";
		/* s6 same as s7d */
		status = "okay";
		/* 0:use reserved; 1:use cma; 2:use cma as reserved */
		flag_cma = <4>;	//<1>;
		//memory-region = <&di_reserved>;
		//memory-region = <&di_cma_reserved>;
		interrupts = <0 203 1
				0 202 1>;
		interrupt-names = "pre_irq", "post_irq";
		clocks = <&clkc CLKID_VPU_CLKB>,
			 <&clkc CLKID_VPU>;
		clock-names = "vpu_clkb",
			"vpu_mux";
		clock-range = <334 400>;
		/* buffer-size = <3621952>;(yuv422 8bit) */
		buffer-size = <4074560>;/*yuv422 fullpack*/
		/* reserve-iomap = "true"; */
		/* if enable nr10bit, set nr10bit-support to 1 */
		post-wr-support = <1>;
		nr10bit-support = <1>;
		nrds-enable = <1>;
		pps-enable = <1>;
		en_4k = <0>;
		keep_dec_vf = <0>;
		po_fmt = <0>;
		post_nub = <11>;
		alloc_sct = <0>;
		hf = <0>;
		dct = <0>;
		sub_v = <0>;//sub version
		afbce_loss_en = <0>;//t5w loss mode enable for DI output
		prelink_en = <0>;
		ponly_mode = <0>;
		t5db_afbcd_en = <1>;
		postlink_en = <0>;
		/***************************************************
		 * t5w t3 support 4k ,same with t7 ,no canvas,
		 * post_nub---default is 11
		 *            (T7/T3/SC2/S4 new path)
		 *            post 11*5222400 = 56M,local 7*4075520 = 28m
		 * flag_cma---0: use reserved; 1:use cma;
		 *            2:use cma as reserved 4:use codec mem
		 * en_4k :en_4k---0: not support 4K;  1: enable 4K
		 *                2: dynamic: vdin: 4k enable,
		 *                   other source 4k disable
		 *                8: when 4k,
		 *                   output with a resolution is below 1080p
		 * keep_dec_vf---0:not keep; 1: keep dec vf for p;
		 *               2: dynamic keep dec vf for p,other is disable
		 * po_fmt---1: NV21/8;  2: nv12/8;  3: AFBC 422/10BIT;
		 *          4: dynamic(4K AFBC,10/422);
		 *          6: dynamic(from decoder 4K source,
		 *             out is AFBC,10/420),
		 *             other is 422/10BIT
		 * bypass_mem---0:nr not bypass; 1: nr bypass;
		 *              2: when 4k input ,nr is bypass;
		 *              3: bypass nr for 4k,but not from vdin;
		 * alloc_sct---0:not support; bit 0: for 4k; bit 1: for 1080p
		 * hf---0:not enable; 1: enable
		 * dct---0:not enable; 1: enable 1 ch; 2: enable 2 ch
		 * sub_v---0:major; 1: sub
		 * afbce_loss_en---1:check the loss flag in vf and set for di,0:disable
		 ***************************************************/
	};

	vclk_serve: vclk_serve {
		compatible = "amlogic, vclk_serve";
		status = "okay";
		reg = <0x0 0xfe008000 0x0 0x400    /* ana reg */
			0x0 0xfe000000 0x0 0x590>; /* clk reg */
	};

	vout_sys: vout_sys {
		compatible = "amlogic, vout_sys_serve";
		status = "okay";
		reg = <0x0 0xfe01029c 0x0 0x4>;
	};

	vdac {
		compatible = "amlogic, vdac-s4d";
		status = "disabled";
	};

	vout: vout {
		compatible = "amlogic, vout";
		status = "okay";

		/* fr_policy:
		 *    0: disable
		 *    1: nearby (only for 60->59.94 and 30->29.97)
		 *    2: force (60/50/30/24/59.94/23.97)
		 */
		fr_policy = <2>;
	};

	vout2: vout2 {
		compatible = "amlogic, vout2";
		status = "okay";

		/* fr_policy:
		 *    0: disable
		 *    1: nearby (only for 60->59.94 and 30->29.97)
		 *    2: force (60/50/30/24/59.94/23.97)
		 */
		fr_policy = <2>;
	};

	vout_mux: vout_mux {
		compatible = "amlogic, vout_mux-t7";
		status = "okay";
		clocks = <&scmi_clk CLKID_FCLK_DIV5>, <&clkc CLKID_VDIN_MEAS>;
		clock-names = "fclk_div5", "vdin_meas_clk";
	};

	dummy_venc: dummy_venc {
		compatible = "amlogic, dummy_venc_a9";
		status = "okay";

		ports {
			port {
				#address-cells = <1>;
				#size-cells = <0>;
				dummyl_to_drm: endpoint@0 {
					reg = <0>;
					remote-endpoint = <0>;
				};
			};
		};
	};

	adc: adc {
		compatible = "amlogic, adc-s4d";
		status = "disabled";
		reg = <0x0 0xff654000 0x0 0x2000/* afe reg base */
			0x0 0xfe008000 0x0 0x2000/* hiu base */
			>;
	};

	ir: ir@8000 {
		compatible = "amlogic, meson-ir";
		reg = <0x0 0xffa14080 0x0 0xA4>,
			<0x0 0xffa14000 0x0 0x58>;
		status = "disable";
		protocol = <REMOTE_TYPE_NEC>;
		interrupts = <GIC_SPI 413 IRQ_TYPE_EDGE_RISING>;
		map = <&custom_maps>;
		wakeup_map = <&ir_wakeup_key>;
		mboxes = <&mbox_fifo A9_REE2AO_IR>;
		max_frame_time = <200>;
	};

	cpu_tsensor: cpu_tsensor@fe028000 {
		compatible = "amlogic,a9-cpu-thermal";
		status = "okay";
		reg = <0x0 0xfe028000 0x0 0x50>;
		clocks = <&clkc CLKID_TS>;
		clock-names = "ts_comp";
		reset-temp = <110000>;
		amlogic,ao-secure = <&secao_tsens>;
		#thermal-sensor-cells = <0>;
	};

	core_tsensor: core_tsensor@fe022000 {
		compatible = "amlogic,a9-core-thermal";
		status = "okay";
		reg = <0x0 0xfe022000 0x0 0x50>;
		clocks = <&clkc CLKID_TS>;
		clock-names = "ts_comp";
		reset-temp = <110000>;
		amlogic,ao-secure = <&secao_tsens>;
		#thermal-sensor-cells = <0>;
	};

	p_tsensor: p_tsensor@fe020000 {
		compatible = "amlogic,a9-pll-thermal";
		status = "okay";
		reg = <0x0 0xfe020000 0x0 0x50>;
		clocks = <&clkc CLKID_TS>;
		clock-names = "ts_comp";
		reset-temp = <110000>;
		amlogic,ao-secure = <&secao_tsens>;
		#thermal-sensor-cells = <0>;
	};

	dos_tsensor: dos_tsensor@fe02a000 {
		compatible = "amlogic,a9-dos-thermal";
		status = "okay";
		reg = <0x0 0xfe02a000 0x0 0x50>;
		clocks = <&clkc CLKID_TS>;
		clock-names = "ts_comp";
		reset-temp = <110000>;
		amlogic,ao-secure = <&secao_tsens>;
		#thermal-sensor-cells = <0>;
	};

	meson_cooldev: meson-cooldev@0 {
			status = "okay";
			compatible = "amlogic, meson-cooldev";
			cooling_devices {
				gpufreq_cool {
					dyn_coeff = <140>;
					node_name = "avalon";
					device_type = "gpufreq";
				};
			};
		};/*meson cooling devices end*/

	thermal-zones {
		soc_thermal: soc_thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			sustainable-power = <1760>;
			thermal-sensors = <&cpu_tsensor>;
			trips {
				cpu_switch_on: trip-point@0 {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu_control: trip-point@1 {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "passive";
				};
				cpu_critical: trip-point@2 {
					temperature = <105000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
			cooling-maps {
				a78_cooling_map {
					trip = <&cpu_control>;
					cooling-device = <&CPU6 0 8>;
					contribution = <1024>;
				};
			};
		};

		c_thermal: c_thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			sustainable-power = <695>;
			thermal-sensors = <&core_tsensor>;
			trips {
				c_switch_on: trip-point@0 {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "passive";
				};
				c_control: trip-point@1 {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "passive";
				};
				c_critical: trip-point@2 {
					temperature = <105000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};

			cooling-maps {
				gpu_cooling_map {
					trip = <&c_control>;
					cooling-device = <&gpu 0 3>;
					contribution = <1024>;
				};
				a55_cooling_map {
					trip = <&c_control>;
					cooling-device = <&CPU0 0 6>;
					contribution = <1024>;
				};
			};
		};

		pll_thermal: pll_thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			sustainable-power = <1160>;
			thermal-sensors = <&p_tsensor>;
			trips {
				p_switch_on: trip-point@0 {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "passive";
				};
				p_control: trip-point@1 {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "passive";
				};
				p_critical: trip-point@2 {
					temperature = <105000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
		};

		dos_thermal: dos_thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			sustainable-power = <1160>;
			thermal-sensors = <&dos_tsensor>;
			trips {
				dos_switch_on: trip-point@0 {
					temperature = <85000>;
					hysteresis = <5000>;
					type = "passive";
				};
				dos_control: trip-point@1 {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "passive";
				};
				dos_critical: trip-point@2 {
					temperature = <105000>;
					hysteresis = <1000>;
					type = "critical";
				};
			};
		};
	};/*thermal zone end*/

	ion_dev {
		compatible = "amlogic, ion_dev";
		memory-region = <&ion_cma_reserved
				&ion_fb_reserved>;
	};

	gpu_protected_memory_allocator: protected-memory-allocator {
		compatible = "arm,protected-memory-allocator";
		memory-region = <&mali_protected>;
	};

	meson_uvm {
		compatible = "amlogic, meson_uvm";
		status = "okay";
		enable_screencap = <1>;
	};

	meson_videotunnel{
		compatible = "amlogic, meson_videotunnel";
		status = "okay";
	};

	fb: fb {
		compatible = "amlogic, fb-s6";
		memory-region = <&logo_reserved>;
		status = "disabled";
		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING
			GIC_SPI 194 IRQ_TYPE_EDGE_RISING
			GIC_SPI 215 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "viu-vsync", "viu2-vsync", "rdma";
		/* uboot logo,fb0/fb1 memory size,if afbcd fb0=0x01851000*/
		display_mode_default = "1080p60hz";
		scale_mode = <1>;
		/** 0:VPU free scale 1:OSD free scale 2:OSD super scale */
		display_size_default = <1920 1080 1920 2160 32>;
		/*1920*1080*4*3 = 0x17BB000*/
		display_device_cnt = <2>;
		//clocks = <&clkc CLKID_VPU_CLKC>;
		clock-names = "vpu_clkc";
	};

	irblaster: meson-irblaster@fe08414c {
		compatible = "amlogic, meson_irblaster";
		status = "disabled";
		reg = <0x0 0xfe08414c 0x0 0x10>;
		#irblaster-cells = <2>;
		interrupts = <GIC_SPI 81 IRQ_TYPE_EDGE_RISING>;
	};

	hdmirx: hdmirx {
		compatible = "amlogic, hdmirx_a9";
		#address-cells=<1>;
		#size-cells=<1>;
		/*memory-region = <&hdmirx_emp_cma_reserved>;*/
		status = "okay";
		pinctrl-names = "hdmirx_pins";
		pinctrl-0 = <&hdmirx_a_mux>;
		repeat = <0>;
		/*power-domains = <&pwrdm PDIP_T6D_VPU_HDMI>;*/
		interrupts = <0 284 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkc CLKID_HDMIRX_CFG>,
			<&clkc CLKID_HDMIRX_ACR_REF>,
			<&clkc CLKID_HDMIRX_METER>,
			<&clkc CLKID_HDMIRX_2M>,
			<&clkc CLKID_HDMIRX_5M>,
			<&clkc CLKID_HDMIRX_HDCP2X>,
			<&xtal>,
			<&scmi_clk CLKID_FCLK_DIV4>,
			<&scmi_clk CLKID_FCLK_DIV5>;
		clock-names = "hdmirx_cfg_clk",
				"cts_hdmirx_acr_ref_clk",
				"cts_hdmirx_meter_clk",
				"cts_hdmirx_2m_clk",
				"cts_hdmirx_5m_clk",
				"cts_hdmirx_hdcp2x_eclk",
				"xtal",
				"fclk_div4",
				"fclk_div5";
		//power-domains = <&pwrdm 2>;
		hdmirx_id = <0>;
		en_4k_2_2k = <0>;
		hpd_low_cec_off = <1>;
		arc_port = <0>;
		vrr_range_dynamic_update_en = <1>;
		/* bit4: enable feature, bit3~0: port number */
		disable_port = <0x0>;
		/* MAP_ADDR_MODULE_CBUS */
		/* MAP_ADDR_MODULE_HIU */
		/* MAP_ADDR_MODULE_HDMIRX_CAPB3 */
		/* MAP_ADDR_MODULE_SEC_AHB */
		/* MAP_ADDR_MODULE_SEC_AHB2 */
		/* MAP_ADDR_MODULE_APB4 */
		/* MAP_ADDR_MODULE_TOP */
		/* MAP_ADDR_MODULE_CLK_CTRL */
		/* MAP_ADDR_MODULE_ANA_CTRL */
		reg = < 0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0
			0x0 0x0 0x0 0x0
			0x0 0xfe400000 0x0 0x18000
			0x0 0xfe000000 0x0 0x2000
			0x0 0xfe008000 0x0 0x2000>;
	};

	/*if you want to use vdin just modify status to "ok"*/
	vdin0: vdin0 {
		compatible = "amlogic, vdin-a9";
		dev_name = "vdin0";
		status = "okay";
		reserve-iomap = "true";
		/*bit8: 0-total buffer num apply,1-one buffer apply*/
		flag_cma = <0x30101>;/*1:share with codec_mm;2:cma alone*/
		/*MByte, if 10bit disable: 64M(YUV422),
		 *if 10bit enable: 64*1.5 = 96M(YUV422)
		 *if support 4K2K-YUV444-10bit-WR:3840*2160*4*4 ~= 128M
		 *if support 4K2K-YUV422-10bit-wr:3840*2160*3*4 ~= 96M
		 *if support 4K2K-YUV422-8BIT-WR:3840*2160*2*4 ~= 64M
		 *if support 1080p-YUV422-8BIT-WR:1920*1080*2*4 ~= 16M
		 */
		/*cma_size = <16>;*/
		interrupts = <0 210 1>;
		interrupt-names = "vsync_int";
		rdma-irq = <2>;
		clocks = <&scmi_clk CLKID_FCLK_DIV5>, <&clkc CLKID_VDIN_MEAS>;
		clock-names = "fclk_div5", "cts_vdin_meas_clk";
		vdin_id = <0>;
		tv_bit_mode = <0x235>;
		afbce_bit_mode = <0x11>;
		chk_wr_done_en;
		/* urgent_en; */
		double_write_en;
		/* vdin v4l2 */
		v4l_support_en = <0>;
		v4l_vd_num = <70>;
		/* v4l2 capability */
		driver   = "vdin_video";
		card     = "meson-a9";
		bus_info = "vdin0 v4l2";
		version  = <0x20260423>;
		/* fe_ports refer to tvin.h */
		fe_ports = <0x00001001   /* CVBS1 */
			0x00010000   /* MIPI */
			0x00004000   /* HDMI0 */
			0x00004001   /* HDMI1 */
			0x00004002>; /* HDMI2 */
		/* vdin v4l2 end */
	};
	vdin1: vdin1 {
		compatible = "amlogic, vdin-a9";
		dev_name = "vdin1";
		status = "okay";
		reserve-iomap = "true";
		/* flag_cma = <0x30101>;1:share with codec_mm;0:cma alone;bit16:scatter*/
		interrupts = <0 212 1>;
		interrupt-names = "vsync_int";
		rdma-irq = <4>;
		clocks = <&scmi_clk CLKID_FCLK_DIV5>, <&clkc CLKID_VDIN_MEAS>;
		clock-names = "fclk_div5", "cts_vdin_meas_clk";
		vdin_id = <1>;
		tv_bit_mode = <0x215>;
		afbce_bit_mode = <0x0>;
		chk_wr_done_en;
		double_write_en;
		/* vdin v4l2 */
		v4l_support_en = <0>;
		v4l_vd_num = <71>;
		/* v4l2 capability */
		driver   = "vdin_video";
		card     = "meson-a9";
		bus_info = "vdin1 v4l2";
		version  = <0x20251030>;
		/* fe_ports refer to tvin.h */
		fe_ports = <0x0000a002   /* WB0_VD1 */
			0x0000a003   /* WB0_VD2 */
			0x0000a004   /* WB0_OSD1 */
			0x0000a005   /* WB0_OSD2 */
			0x0000a006   /* WB0_VPP */
			0x0000a007   /* WB0_VDIN_BIST */
			0x0000a008   /* WB0_POST_BLEND */
			0x0000a001>; /* VIDEO */
		/* vdin v4l2 end */
	};

	amvideom: meson-amvideom {
		compatible = "amlogic, amvideom-a9";
		dev_name = "amvideom";
		status = "okay";
		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING
			GIC_SPI 194 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "vsync", "vsync_viu2";
	};

	lut_dma:lut_dma {
		compatible = "amlogic, meson-s5, lut_dma";
		status = "okay";
	};

	v2d {
		compatible = "amlogic, v2d";
		vpu_dma_mask = <1>;  /* 0: <= 4G, 1: > 4G*/
		dev_name = "v2d";
		status = "okay";
	};

	videodisplay {
		compatible = "amlogic, videodisplay";
		vpu_dma_mask = <1>;  /* 0: <= 4G, 1: > 4G*/
		dev_name = "videodisplay";
		status = "okay";
	};

	video_composer {
		compatible = "amlogic, video_composer";
		vpu_dma_mask = <1>;  /* 0: <= 4G, 1: > 4G*/
		dev_name = "video_composer";
		status = "okay";
	};

	di_process {
		compatible = "amlogic, di_process";
		dev_name = "di_process";
		status = "okay";
	};

	vpu_security {
		compatible = "amlogic, meson-t6d, vpu_security";
		dev_name = "amlogic-vpu-security";
		status = "okay";
		interrupts = <GIC_SPI 220 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "vpu_security";
	};

	dmx_aucpu: aucpu {
		compatible = "amlogic, aucpu";
		dev_name = "aml_aucpu";
		status = "okay";
		interrupts = <0 77 1>;
		interrupt-names = "aucpu_irq";
		reg = <0x0 0xfe09e080 0x0 0x100>;
	};

	cve {
		compatible = "amlogic, cve";
		reg = <0x0 0xFF561000 0x0 0x1000>;
		reg-names = "cve";
		interrupts = <GIC_SPI 218 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "cve";
		clocks = <&clkc CLKID_CVE>,
			<&clkc CLKID_VGE>;
		clock-names = "clk_cve", "clk_vge";
		clk-rate = <666000000>;
		power-domains = <&pwrdm PWRC_A9_CVE_ID>;
		status = "okay";
	};

	ge2d {
		compatible = "amlogic, ge2d-a9";
		status = "okay";
		interrupts = <GIC_SPI 217 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "ge2d";
		clocks = <&clkc CLKID_VAPB>,
			 <&clkc CLKID_GE2D>,
			 <&clkc CLKID_VGE>;
		clock-names = "clk_vapb_0",
			"clk_ge2d_gate",
			"cve_arb";
		reg = <0x0 0xff560000 0x0 0x100>;
		power-domains = <&pwrdm PWRC_A9_GE2D_ID>;
	};

	amlgdc {
		#address-cells=<2>;
		#size-cells=<2>;
		status = "okay";
		compatible = "amlogic, aml-gdc-v5";
		reg = <0 0xff566c00 0 0x000030c>;
		interrupts = <GIC_SPI 383 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "amlgdc";
		clocks = <&clkc CLKID_DEWARPA>, <&clkc CLKID_VGE>;
		clock-names = "clk_gate", "cve_arb";
		clk-rate = <800000000>;
		//power-domains = <&pwrdm PDID_S6_DEWARP>;
		//assigned-clocks = <&clkc CLKID_DEWARPA>;
		//assigned-clock-rates = <800000000>;
	};

	vicp {
		compatible = "amlogic, vicp-a9";
		dev_name = "vicp";
		status = "okay";
		interrupts = <GIC_SPI 263 IRQ_TYPE_EDGE_RISING>,
			<GIC_SPI 262 IRQ_TYPE_EDGE_RISING>,
			<GIC_SPI 261 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "vicp_err", "vicp_rdma", "vicp_proc";
		clocks = <&clkc CLKID_VAPB>,
			<&clkc CLKID_CVE>,
			<&clkc CLKID_CMPR>;
		clock-names = "clk_vapb_0",
			"clk_cve",
			"clk_vicp_gate";
		assigned-clocks = <&clkc CLKID_VAPB>,
			<&clkc CLKID_CVE>,
			<&clkc CLKID_CMPR>;
		assigned-clock-rates = <666666666>,
			<666666666>,
			<800000000>;
		reg = <0x0 0xff564000 0x0 0xe80>;
		power-domains = <&pwrdm PWRC_A9_VICP_ID>;
	};

	aml_bt: aml_bt {
		compatible = "amlogic, aml-bt";
		status = "disabled";
	};

	aml_wifi: aml_wifi {
		compatible = "amlogic, aml-wifi";
		status = "disabled";
		wifi_pwm_tee;
		irq_trigger_type = "IRQF_TRIGGER_LOW";
		wifi_static_buf = <0>;
		//pinctrl-0 = <&pwm_k_pins>;
		//pinctrl-names = "default";
		pwm_channel1_conf {
			pwms = <&pwm_k 0 30541 0>;
			duty-cycle = <15270>;
			times = <7>;
		};
		pwm_channel2_conf {
			pwms = <&pwm_k 1 30500 0>;
			duty-cycle = <15250>;
			times = <10>;
		};
	};

	state_led: state_led {
		compatible = "amlogic,state-led-aocpu";
		mboxes = <&mbox_fifo A9_REE2AO_LED>;
		status = "disabled";
	};

	efusecheck: efusecheck{
		maincmd = <0x8200003E>;
		checknum = <3>;
		check0 = <&check_0>;
		check1 = <&check_1>;
		check2 = <&check_2>;
		check_0:check_0{
			checkname = "dgpk1";
			subcmd = <0x1000>;
		};
		check_1:check_1{
			checkname = "dgpk2";
			subcmd = <0x1001>;
		};
		check_2:check_2{
			checkname = "aud_id";
			subcmd = <0x1002>;
		};
	};
	efuse: efuse{
		compatible = "amlogic, efuse";
		reg=<0x0 0xfe440040 0x0 0x4>;
		secureboot_mask = <0x00000c00>;
		mem_size = <0x100000>;
		read_cmd = <0x82000030>;
		write_cmd = <0x82000031>;
		get_max_cmd = <0x82000033>;
		mem_in_base_cmd = <0x82000020>;
		mem_out_base_cmd = <0x82000021>;
		efuse_pattern_size = <0x600>;
		efuse_obj_cmd_status = <0x1>;
		efuse_cali_item_read = <0x1>;
		key = <&efusekey>;
		check = <&efusecheck>;
		clock-names = "efuse_clk";
		status = "okay";
	};

	efusekey:efusekey{
		keynum = <4>;
		key0 = <&key_0>;
		key1 = <&key_1>;
		key2 = <&key_2>;
		key3 = <&key_3>;
		key_0:key_0{
			keyname = "mac";
			offset = <0>;
			size = <6>;
		};
		key_1:key_1{
			keyname = "mac_bt";
			offset = <6>;
			size = <6>;
		};
		key_2:key_2{
			keyname = "mac_wifi";
			offset = <12>;
			size = <6>;
		};
		key_3:key_3{
			keyname = "usid";
			offset = <18>;
			size = <16>;
		};
	};

	aml_mkl {
		compatible = "amlogic,aml_mkl";
		reg = <0x0 0xfe440200 0x0 0xf0>;
		kl_type = <1>;
		kl_vid_type = <0>;
		kl_offset = <0x80 0x88 0x8c 0x90>;
		status = "okay";
	};

	aml_kt {
		compatible = "amlogic,aml_kt";
		reg = <0x0 0xfe440500 0x0 0xa0>;
		kt_offset = <0x80 0x88 0x8c 0x90 0x94 0x98 0x9c>;
		kt_cap = <0x2597 0x6bf 0 64 0 32>;
		kt_reserved = <0>;
		kt_host_key_max_len = <32>;
		status = "okay";
	};

	chosen:chosen {
		bootargs = "usbcore.autosuspend=-1 dm_mod.reserved_bio_based_ios=8 swiotlb=noforce";
	};

	gpu_opp_table: gpu_opp_table {
		compatible = "operating-points-v2";
		opp-285 {
			opp-hz = /bits/ 64 <285714281>;
			opp-microvolt = <690000>;
		};
		opp-400 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <710000>;
		};
		opp-500 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <730000>;
		};
		opp-666 {
			opp-hz = /bits/ 64 <666666666>;
			opp-microvolt = <750000>;
		};
		opp-800 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <790000>;
		};
		opp-1000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <820000>;
		};
	};

	smmu: aml_smmu {
		compatible = "amlogic,smmu";
		status = "okay";
		#iommu-cells = <1>;
		memory-region = <&pcie_dma_ops_mm>;
	};

	codec_mm {
		compatible = "amlogic, codec, mm";
		memory-region = <&codec_mm_cma &codec_mm_reserved &secure_vdec_reserved\
			&codec_mm_reserved_ext>;
		dev_name = "codec_mm";
		status = "okay";
		/*
		 * scatter_alloc_mode: the mode of scatter memory allocation
		 * 0: default mode, alloc from system and cma
		 * 1: only alloc from system
		 */
		scatter_alloc_mode = <1>;
		/* secure memory controller para <switch  align_2n> */
		secure_ctrl_para = <1 16>;
	};

	amdolby_vision {
		compatible = "amlogic, dolby_vision_a9";
		dev_name = "aml_amdolby_vision_driver";
		status = "okay";
		tv_mode = <0>;/*1:enable ;0:disable*/
	};

	cvbsout {
		compatible = "amlogic, cvbsout-s4";
		status = "disabled";

		/* clk path */
		/* 0:vid_pll vid2_clk */
		/* 1:gp0_pll vid2_clk */
		/* 2:vid_pll vid1_clk */
		/* 3:gp0_pll vid1_clk */
		clk_path = <0>;

		/* performance: reg_address, reg_value */
		/* s4 */
		performance_pal = <0x1bf0  0x9 /* default Matrx625 CTCC value*/
			0x1b12  0x80c0
			0x1b05  0xf7
			0x1b56  0x333
			0x1c59  0xf25c
			0xffff  0x0>; /* ending flag */
		performance = <0x1bf0  0x9 /* ccitt033 SVA value */
			0x1b12  0x8040
			0x1b05  0xfd
			0x1b56  0x333
			0x1c59  0xf654
			0xffff  0x0>; /* ending flag */
		performance_ntsc = <0x1bf0  0x9
			0x1b12  0x8020
			0x1b03  0x0
			0x1b04  0x0
			0x1b05  0x0
			0x1b06  0x0
			0x1b56  0x333
			0x1c59  0xf850
			0xffff  0x0>; /* ending flag */
	};

	ionvideo {
		compatible = "amlogic, ionvideo";
		dev_name = "ionvideo";
		status = "disabled";
	};

	video_queue {
		compatible = "amlogic, video_queue";
		dev_name = "videoqueue";
		status = "okay";
	};

	amlvideo2_0: amlvideo2_0 {
		compatible = "amlogic, amlvideo2";
		dev_name = "amlvideo2";
		vpu_dma_mask = <1>;  /* 0: <= 4G, 1: > 4G*/
		status = "okay";
		amlvideo2_id = <0>;
		cma_mode = <1>;
	};

	amlvideo2_1: amlvideo2_1 {
		compatible = "amlogic, amlvideo2";
		dev_name = "amlvideo2";
		vpu_dma_mask = <1>;  /* 0: <= 4G, 1: > 4G*/
		status = "okay";
		amlvideo2_id = <1>;
		cma_mode = <1>;
		support_4k = <1>;
	};

	amvdec_csi: amvdec_csi {
		compatible = "amlogic, amvdec_csi-s6";
		status = "okay";
		csi_id = <0>;
		squlech_mode = <0>;
		deskew_mode = <0>;
		reg = <0x0 0xfe014000 0x0 0x00000100>,
			<0x0 0xfe016000 0x0 0x00000100>,
			<0x0 0xfe018000 0x0 0x00000100>;
		reg-names = "csi_phy", "csi_host", "csi_adapt";

		//clocks = <&clkc CLKID_CSI2_ADAPT>,
		//	   <&clkc CLKID_CSI_PHY>;
		clock-names = "cts_csi_adapt_clk_composite",
			"cts_csi_phy_clk_composite";

		// depends on power domain.
		//power-domains = <&pwrdm PDID_S6_ADAPT>;

		// 88 for csi2_adap_int
		interrupts = <GIC_SPI 88 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "csi_phy";
	};

	ppmgr {
		compatible = "amlogic, ppmgr";
		memory-region = <&ppmgr_reserved>;
		dev_name = "ppmgr";
		status = "disabled";
	};

	provisionkey {
		compatible = "amlogic, provisionkey";
		status = "disabled";
		key-permit-default = "write";
		//new key not need add dts if started with KEY_PROVISION_
		KEY_PROVISION_XXX { };
		//test_my_added_keyname { };
	};//End provisionkey

	unifykey{
		compatible = "amlogic,unifykey";
		status = "okay";
		unifykey-num = <19>;
		unifykey-index-0 = <&keysn_0>;
		unifykey-index-1 = <&keysn_1>;
		unifykey-index-2 = <&keysn_2>;
		unifykey-index-3 = <&keysn_3>;
		unifykey-index-4 = <&keysn_4>;
		unifykey-index-5 = <&keysn_5>;
		unifykey-index-6 = <&keysn_6>;
		unifykey-index-7 = <&keysn_7>;
		unifykey-index-8 = <&keysn_8>;
		unifykey-index-9 = <&keysn_9>;
		unifykey-index-10= <&keysn_10>;
		unifykey-index-11= <&keysn_11>;
		unifykey-index-12= <&keysn_12>;
		unifykey-index-13= <&keysn_13>;
		unifykey-index-14= <&keysn_14>;
		unifykey-index-15= <&keysn_15>;
		unifykey-index-16= <&keysn_16>;
		unifykey-index-17= <&keysn_17>;
		unifykey-index-18= <&keysn_18>;

		keysn_0: key_0{
			key-name = "usid";
			key-device = "normal";
			key-permit = "read","write","del";
		};
		keysn_1:key_1{
			key-name = "mac";
			key-device = "normal";
			key-permit = "read","write","del";
		};
		keysn_2:key_2{
			key-name = "hdcp";
			key-device = "secure";
			key-type = "sha1";
			key-permit = "read","write","del";
		};
		keysn_3:key_3{
			key-name = "secure_boot_set";
			key-device = "efuse";
			key-permit = "write";
		};
		keysn_4:key_4{
			key-name = "mac_bt";
			key-device = "normal";
			key-permit = "read","write","del";
			key-type  = "mac";
		};
		keysn_5:key_5{
			key-name = "mac_wifi";
			key-device = "normal";
			key-permit = "read","write","del";
			key-type = "mac";
		};
		keysn_6:key_6{
			key-name = "hdcp2_tx";
			key-device = "normal";
			key-permit = "read","write","del";
		};
		keysn_7:key_7{
			key-name = "hdcp2_rx";
			key-device = "normal";
			key-permit = "read","write","del";
		};
		keysn_8:key_8{
			key-name = "widevinekeybox";
			key-device = "secure";
			key-permit = "read","write","del";
		};
		keysn_9:key_9{
			key-name = "deviceid";
			key-device = "normal";
			key-permit = "read","write","del";
		};
		keysn_10:key_10{
			key-name = "hdcp22_fw_private";
			key-device = "secure";
			key-permit = "read","write","del";
		};
		keysn_11:key_11{
			key-name = "PlayReadykeybox25";
			key-device = "secure";
			key-permit = "read","write","del";
		};
		keysn_12:key_12{
			key-name = "prpubkeybox";//PlayReady
			key-device = "secure";
			key-permit = "read","write","del";
		};
		keysn_13:key_13{
			key-name = "prprivkeybox";//PlayReady
			key-device = "secure";
			key-permit = "read","write","del";
		};
		keysn_14:key_14{
			key-name = "attestationkeybox";//attestation key
			key-device = "secure";
			key-permit = "read","write","del";
		};
		keysn_15:key_15{
			key-name = "region_code";
			key-device = "normal";
			key-permit = "read","write","del";
		};
		keysn_16:key_16{
			key-name = "netflix_mgkid";
			key-device = "secure";
			key-permit = "read","write","del";
		};
		keysn_17:key_17{
			key-name = "attestationdevidbox";//attest dev id box
			key-device = "secure";
			key-permit = "read","write","del";
		};
		keysn_18:key_18{
			key-name = "oemkey";
			key-device = "normal";
			key-permit = "read","write","del";
		};
	};//End unifykey

	picdec {
		compatible = "amlogic, picdec";
		status = "disabled";
	};
};

&aobus_pinctrl {
	func-pwm-a {
		pwm_a_pins1: group-pwm-a-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 10, 3)>;
		};

		pwm_a_pins2: group-pwm-a-pins2 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 0, 1)>;
		};

		pwm_a_pins3: group-pwm-a-pins3 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 11, 2)>;
		};

		pwm_a_hiz_pins: group-pwm-a-hiz-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 10, 1)>;
		};
	};

	func-pwm-b {
		pwm_b_pins1: group-pwm-b-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 1, 1)>;
		};
	};

	func-pwm-c {
		pwm_c_pins1: group-pwm-c-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 2, 1)>;
		};

		pwm_c_hiz_pins: group-pwm-c-hiz-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 10, 4)>;
		};
	};

	func-pwm-d {
		pwm_d_pins1: group-pwm-d-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 3, 1)>;
		};
	};

	func-pwm-e {
		pwm_e_pins1: group-pwm-e-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 4, 1)>;
		};
	};

	func-pwm-f {
		pwm_f_pins1: group-pwm-f-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 5, 1)>;
		};
	};

	func-pwm-g {
		pwm_g_pins1: group-pwm-g-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 11, 3)>;
		};

		pwm_g_pins2: group-pwm-g-pins2 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 6, 4)>;
		};

		pwm_g_hiz_pins: group-pwm-g-hiz-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 11, 4)>;
		};
	};

	func-i2c0 {
		i2c0_pins1: group-i2c0-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 2, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 3, 1)>;
			bias-disable;
		};

		i2c0_pins2: group-i2c0-pins2 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 4, 4)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 5, 4)>;
			bias-disable;
		};

		i2c0_pins3: group-i2c0-pins3 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 6, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 7, 1)>;
			bias-disable;
		};

		i2c0_pins4: group-i2c0-pins4 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 0, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 1, 2)>;
			bias-disable;
		};
	};

	func-i2c1 {
		i2c1_pins1: group-i2c1-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 4, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 5, 2)>;
			bias-disable;
		};

		i2c1_pins2: group-i2c1-pins2 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 2, 4)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 3, 4)>;
			bias-disable;
		};
	};

	func-i2c2 {
		i2c2_pins1: group-i2c2-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 13, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 14, 1)>;
			bias-disable;
		};

		i2c2_pins2: group-i2c2-pins2 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 4)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 1, 4)>;
			bias-disable;
		};

		i2c2_pins3: group-i2c2-pins3 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 6, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 7, 2)>;
			bias-disable;
		};
	};

	func-i2c3 {
		i2c3_pins1: group-i2c3-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 15, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 16, 1)>;
			bias-disable;
		};

		i2c3_pins2: group-i2c3-pins2 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 11, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 12, 1)>;
			bias-disable;
		};

		i2c3_pins3: group-i2c3-pins3 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 8, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 9, 2)>;
			bias-disable;
		};
	};

	func-i3c0 {
		i3c0_ao_pins1: group-i3c0-ao-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 2, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 3, 3)>;
			bias-disable;
		};

		i3c0_ao_pins2: group-i3c0-ao-pins2 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 1, 7)>;
			bias-disable;
		};
	};

	func-ir-in {
		remote_pins: group-remote-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 5, 1)>;
			bias-disable;
		};

		remote_pins_1: group-remote-pins-1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 9, 3)>;
			bias-disable;
		};
	};

	func-gpio-periphs {
		sd_to_ao_uart_clr_pins: group-sd2aoaurt-clr-pin {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 0, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 1, 0)>;
			drive-strength = <3>;
			bias-pull-up;
		};

		sd_clr_all_pins: group-sd-clr-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 1, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 2, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 3, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 5, 0)>;
			output-high;
		};

		/* Attention use together with sd_clr_all_pins because of not mux */
		sd_clr_all_pins2: group-sd-clr-pins2 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 4, 0)>;
			output-low;
		};

		sd_clr_noall_pins: group-sd-clr-no-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 1, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 4, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 5, 0)>;
			output-high;
		};
	};
};

