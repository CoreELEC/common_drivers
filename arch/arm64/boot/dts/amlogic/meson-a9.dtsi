	pwm_a_hiz_pins: pwm_a_hiz_pins {
		mux {
			groups = "pwm_a_hiz";
			function = "pwm_a_hiz";
		};
	};

	pwm_b_hiz_pins: pwm_b_hiz_pins {
		mux {
			groups = "pwm_b_hiz";
			function = "pwm_b_hiz";
		};
	};

	pwm_c_hiz_pins: pwm_c_hiz_pins {
		mux {
			groups = "pwm_c_hiz";
			function = "pwm_b_hiz";
		};
	};

	pwm_g_hiz_pins: pwm_g_hiz_pins {
		mux {
			groups = "pwm_g_hiz";
			function = "pwm_g_hiz";
		};
	};

	remote_pins: remote_pin {
		mux {
			groups = "ir_remote_in_f3";
			function = "ir_remote";
			bias-disable;
		};
	};

	remote_pins_1: remote_pin_1 {
		mux {
			groups = "ir_remote_in_d";
			function = "ir_remote";
			bias-disable;
		};
	};

	spicc0_pins_a: spicc0_pins_a {
		mux {
			groups = "spi_a_mosi_a",
				 "spi_a_miso_a",
				 "spi_a_ss0_a",
				 "spi_a_clk_a";
			function = "spi_a";
			drive-strength-microamp = <3000>;
		};
	};

	spicc0_pins_f: spicc0_pins_f {
		mux {
			groups = "spi_a_mosi_f",
				 "spi_a_miso_f",
				 "spi_a_ss0_f",
				 "spi_a_clk_f";
			function = "spi_a";
			drive-strength-microamp = <3000>;
		};
	};

	spicc0_pins_h: spicc0_pins_h {
		mux {
			groups = "spi_a_mosi_h",
				 "spi_a_miso_h",
				 "spi_a_ss0_h",
				 "spi_a_clk_h";
			function = "spi_a";
			drive-strength-microamp = <3000>;
		};
	};

	spicc0_pins_x: spicc0_pins_x {
		mux {
			groups = "spi_a_mosi_x",
				 "spi_a_miso_x",
				 "spi_a_ss0_x",
				 "spi_a_clk_x";
			function = "spi_a";
			drive-strength-microamp = <3000>;
		};
	};

	spifc_pins:spifc_pins {
		mux {
			groups = "spif_hold",
				 "spif_mo",
				 "spif_mi",
				 "spif_clk",
				 "spif_wp",
				 "spif_cs";
			function = "spif";
			drive-strength-microamp = <3000>;
		};
	};

	irblaster_pin_f:irblaster_pin_f {
		mux {
			groups = "ir_remote_out_f";
			function = "ir_remote";
		};
	};

	irblaster_pin_h:irblaster_pin_h {
		mux {
			groups = "ir_remote_out_h";
			function = "ir_remote";
		};
	};

	irblaster_pin_z:irblaster_pin_z {
		mux {
			groups = "ir_remote_out_z";
			function = "ir_remote";
		};
	};

	irblaster_pin_a:irblaster_pin_a {
		mux {
			groups = "ir_remote_out_a";
			function = "ir_remote";
		};
	};

	spdifin: spdifin {
		mux {/* GPIOH_5 */
			groups = "spdif_in";
			function = "spdif_in";
		};
	};

	eth_pins: eth {
		mux {
			groups = "eth_mdio",
				 "eth_mdc",
				 "eth_rgmii_rx_clk",
				 "eth_rx_dv",
				 "eth_rxd0",
				 "eth_rxd1",
				 "eth_txen",
				 "eth_txd0",
				 "eth_txd1";
			function = "eth";
			drive-strength-microamp = <3000>;
			bias-disable;
		};
	};

	eth_rgmii_pins: eth-rgmii {
		mux {
			groups = "eth_rxd2_rgmii",
				 "eth_rxd3_rgmii",
				 "eth_rgmii_tx_clk",
				 "eth_txd2_rgmii",
				 "eth_txd3_rgmii";
			function = "eth";
			drive-strength-microamp = <3000>;
			bias-disable;
		};
	};
};

&gpu{
	status = "disabled";
	operating-points-v2 = <&gpu_opp_table>;
	reg =   <0x0 0xFD000000 0x0 0x800000>, /*mali APB bus base address*/
		<0x0 0xFE002000 0x0 0x01000>; /*reset register*/

	interrupts = <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "GPU", "MMU", "JOB";

	/* Protected memory allocator default not available*/
	//protected-memory-allocator = <&gpu_protected_memory_allocator>;

	num_of_pp = <1>;
	system-coherency = <31>;
	clocks = <&clkc_mali CLKID_MALI>,
		 <&clkc_mali CLKID_MALI_STACK>;
	clock-names = "gpu_mux", "gpu_stack";

	assigned-clocks = <&clkc_mali CLKID_MALI>,
			  <&clkc_mali CLKID_MALI_STACK>,
			  <&scmi_clk CLKID_GP1_PLL>;
	assigned-clock-rates = <400000000>,
			       <400000000>,
			       <996000000>;

	tbl = <&dvfs400_cfg>;//bringup s6 use fix clock 400M

};

#include "amlogic-a9-clock.dtsi"
#include "mesons6_cpufreq.dtsi"
