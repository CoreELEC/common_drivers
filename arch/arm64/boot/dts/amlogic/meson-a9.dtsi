#include <dt-bindings/clock/axg-audio-clkc.h>
#include <dt-bindings/clock/amlogic,a9-scmi-clkc.h>
#include <dt-bindings/clock/amlogic,a9-clkc.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/power/a9-pd.h>
#include <dt-bindings/power/amlogic-a9-power.h>
#include <dt-bindings/dma/amlogic,a9-dma.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/gpio/meson-a9-gpio.h>
#include <dt-bindings/reset/amlogic,meson-a9-reset.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/pwm/meson.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/input/meson_ir.h>
#include <dt-bindings/mailbox/amlogic,mbox.h>
#include <dt-bindings/firmware/amlogic,firmware.h>
#include <dt-bindings/mailbox/a9-mbox.h>
#include <dt-bindings/iio/adc/amlogic-saradc.h>
#include <dt-bindings/thermal/ddr-params.h>
#include <dt-bindings/pinctrl/amlogic,pinctrl.h>
#include "meson-ir-map.dtsi"
#include "meson-avalon.dtsi"
#include <dt-bindings/power/meson-pm.h>
#include <dt-bindings/i2c/i2c-meson.h>
/ {
	cpus:cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu-map {
			cluster0:cluster0 {
				core0 {
					cpu = <&CPU0>;
				};
				core1 {
					cpu = <&CPU1>;
				};
				core2 {
					cpu = <&CPU2>;
				};
				core3 {
					cpu = <&CPU3>;
				};
				core4 {
					cpu = <&CPU4>;
				};
				core5 {
					cpu = <&CPU5>;
				};
				core6 {
					cpu = <&CPU6>;
				};
				core7 {
					cpu = <&CPU7>;
				};
			};
		};

		CPU0:cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55","arm,armv8";
			reg = <0x0 0x0>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_SLEEP_0 &SYSTEM_SLEEP_0>;
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <59>;
			#cooling-cells = <2>;
		};

		CPU1:cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55","arm,armv8";
			reg = <0x0 0x100>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_SLEEP_0 &SYSTEM_SLEEP_0>;
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <59>;
			#cooling-cells = <2>;
		};

		CPU2:cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55","arm,armv8";
			reg = <0x0 0x200>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_SLEEP_0 &SYSTEM_SLEEP_0>;
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <59>;
			#cooling-cells = <2>;
		};

		CPU3:cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55","arm,armv8";
			reg = <0x0 0x300>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_SLEEP_0 &SYSTEM_SLEEP_0>;
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <59>;
			#cooling-cells = <2>;
		};

		CPU4:cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a55","arm,armv8";
			reg = <0x0 0x400>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_SLEEP_0 &SYSTEM_SLEEP_0>;
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <59>;
			#cooling-cells = <2>;
		};

		CPU5:cpu@5 {
			device_type = "cpu";
			compatible = "arm,cortex-a55","arm,armv8";
			reg = <0x0 0x500>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_SLEEP_0 &SYSTEM_SLEEP_0>;
			capacity-dmips-mhz = <430>;
			dynamic-power-coefficient = <59>;
			#cooling-cells = <2>;
		};

		CPU6:cpu@6 {
			device_type = "cpu";
			compatible = "arm,cortex-a78","arm,armv8";
			reg = <0x0 0x600>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_SLEEP_0 &SYSTEM_SLEEP_0>;
			capacity-dmips-mhz = <1024>;
			dynamic-power-coefficient = <416>;
			#cooling-cells = <2>;
		};

		CPU7:cpu@7 {
			device_type = "cpu";
			compatible = "arm,cortex-a78","arm,armv8";
			reg = <0x0 0x700>;
			enable-method = "psci";
			cpu-idle-states = <&CPU_SLEEP_0 &SYSTEM_SLEEP_0>;
			capacity-dmips-mhz = <1024>;
			dynamic-power-coefficient = <416>;
			#cooling-cells = <2>;
		};

		idle-states {
			entry-method = "arm,psci-0.2";
			CPU_SLEEP_0: cpu-sleep-0 {
					compatible = "arm,idle-state";
					arm,psci-suspend-param = <0x0010000>;
					local-timer-stop;
					entry-latency-us = <300>;
					exit-latency-us = <534>;
					min-residency-us = <1600>;
			};
			SYSTEM_SLEEP_0: system-sleep-0 {
					compatible = "arm,idle-state";
					arm,psci-suspend-param = <0x0000000>;
					entry-latency-us = <0x3fffffff>;
					exit-latency-us = <0x40000000>;
					min-residency-us = <0xffffffff>;
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 0xff08>,
				<GIC_PPI 14 0xff08>,
				<GIC_PPI 11 0xff08>,
				<GIC_PPI 10 0xff08>;
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		private-interrupts;
		interrupts = <GIC_SPI 359 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 360 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 361 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 362 IRQ_TYPE_LEVEL_HIGH>,

			     <GIC_SPI 363 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 364 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&CPU0>,
				     <&CPU1>,
				     <&CPU2>,
				     <&CPU3>,
				     <&CPU4>,
				     <&CPU5>;
	};

	pmu-a78 {
		compatible = "arm,cortex-a78-pmu";
		private-interrupts;
		interrupts = <GIC_SPI 365 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 366 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&CPU6>,
				     <&CPU7>;
	};

	gic: interrupt-controller@ff800000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0x0 0xff800000 0 0x10000>,
		      <0x0 0xff840000 0 0x100000>;
		interrupts = <GIC_PPI 9 0xf04>;
	};

	irq_latch {
		/* only for GICv3 */
		status = "disabled";
		reg = <0x0 0xfe00a140 0x0 0x30>, /*mode*/
			<0x0 0xfe00a1c0 0x0 0x30>; /*latch clear*/
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	mte_debug {
		status = "disabled";
		reg = <0x0 0xfe010250 0x0 0x4>; /*SYSCTRL_DEBUG_REG4*/
	};

	meson_suspend:pm {
		compatible = "amlogic, pm";
		status = "okay";
		device_name = "aml_pm";
		extend_resume_reason;
		clear_suspend_reason = <9>; /* Clear netflix wakeup reason */
		reg = <0x0 0xffa800e4 0x0 0x4>, /*SYSCTRL_STATUS_REG2*/
			<0x0 0xffa8005c 0x0 0x4>; /*SYSCTRL_STICKY_REG7*/
//		deep_mode = <SYSTEM_SUSPEND_EE_PWR_DOWN>;
		/*deep_mode supports custom configuration */
		deep_mode = <(DEFINE(DDR, NORMAL) | DEFINE(EE_PWR_DN, OFF))>;
	};

	cpu_info {
		compatible = "amlogic, cpuinfo";
		status = "okay";
		cpuinfo_cmd = <0x82000044>;
	};

	soc_info {
		compatible = "amlogic, socdata";
		reg =	<0x0 0xfe010000 0x0 0xc>,
			<0x0 0xfe010180 0x0 0x4>;
		read_nocsdata_cmd =<0x82000039>;
		write_nocsdata_cmd=<0x82000038>;
		auth_reg_ops_cmd=<0x820000f0>;
	};

	aml_reboot {
		compatible = "aml, reboot";
		sys_reset = <0x84000009>;
		sys_poweroff = <0x84000008>;
		dis_nb_cpus_in_shutdown;
		extend_reboot_reason; /* Support up to 128 reboot reasons*/
		reg = <0x0 0xfe01037c 0x0 0x4>; /* SEC_AO_SEC_SD_CFG15 */
		status = "okay";
	};

	ram-dump {
		compatible = "amlogic, ram_dump";
		status = "okay";
		reg = <0x0 0xFFA80058 0x0 4>;
		reg-names = "SYSCTRL_STICKY_REG6";
		store_device = "data";
	};

	amfc {
		compatible = "amlogic,amfc-s7d";
		status = "okay";
		/* registers and clk */
		reg = <0x0 0xfe024000 0x0 0x200
		       0x0 0xfe000000 0x0 0x400>;
		interrupts = <0 185 IRQ_TYPE_EDGE_RISING
			      0 186 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "amfc0", "amfc1";
		power-domains=<&pwrdm PWRC_A9_AMFC_ID>;
		clocks = <&clkc CLKID_AMFC>;
		assigned-clocks = <&clkc CLKID_AMFC>;
		assigned-clock-rates = <666666666>;
	};

	csi2_0: csi2_0@ff559000 {
		compatible = "amlogic,csi2-0";
		reg = <0x0 0xff558000 0x0 0x68>,
		      <0x0 0xff559000 0x0 0x290>,
		      <0x0 0xff55a000 0x0 0xd8>;
		reg-names = "aphy", "dphy", "host";
		clocks = <&clkc CLKID_CSI_PHY>;
		clock-names = "phy";
		assigned-clocks = <&clkc CLKID_CSI_PHY>;
		assigned-clock-rates = <200000000>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
			};

			port@1 {
				reg = <1>;
				csi2_0_out: endpoint {
					remote-endpoint = <&adap0_in>;
				};
			};
		};
	};

	csi2_1: csi2_1@ff559400 {
		compatible = "amlogic,csi2-1";
		reg = <0x0 0xff558000 0x0 0x68>,
		      <0x0 0xff559400 0x0 0x290>,
		      <0x0 0xff55a400 0x0 0xd8>;
		reg-names = "aphy", "dphy", "host";
		clocks = <&clkc CLKID_CSI_PHY>;
		clock-names = "phy";
		assigned-clocks = <&clkc CLKID_CSI_PHY>;
		assigned-clock-rates = <200000000>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
			};

			port@1 {
				reg = <1>;
				csi2_1_out: endpoint {
					remote-endpoint = <&adap1_in>;
				};
			};
		};
	};

	csi2_2: csi2_2@ff55d000 {
		compatible = "amlogic,csi2-2";
		reg = <0x0 0xff55c000 0x0 0x68>,
		      <0x0 0xff55d000 0x0 0x290>,
		      <0x0 0xff55e000 0x0 0xd8>;
		reg-names = "aphy", "dphy", "host";
		clocks = <&clkc CLKID_CSI_PHY>;
		clock-names = "phy";
		assigned-clocks = <&clkc CLKID_CSI_PHY>;
		assigned-clock-rates = <200000000>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
			};

			port@1 {
				reg = <1>;
				csi2_2_out: endpoint {
					remote-endpoint = <&adap2_in>;
				};
			};
		};
	};

	csi2_3: csi2_3@ff55d400 {
		compatible = "amlogic,csi2-3";
		reg = <0x0 0xff55c000 0x0 0x68>,
		      <0x0 0xff55d400 0x0 0x290>,
		      <0x0 0xff55e400 0x0 0xd8>;
		reg-names = "aphy", "dphy", "host";
		clocks = <&clkc CLKID_CSI_PHY>;
		clock-names = "phy";
		assigned-clocks = <&clkc CLKID_CSI_PHY>;
		assigned-clock-rates = <200000000>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
			};

			port@1 {
				reg = <1>;
				csi2_3_out: endpoint {
					remote-endpoint = <&adap3_in>;
				};
			};
		};
	};

	adap0: adap0@ff55b000 {
		compatible = "amlogic,adap0";
		reg = <0x0 0xff55b000 0x0 0xe4>;
		reg-names = "adap";
		power-domains = <&pwrdm PWRC_A9_OPP_ID>;
		clocks = <&clkc CLKID_ISP>;
		clock-names = "isp";
		assigned-clocks = <&clkc CLKID_ISP>;
		assigned-clock-rates = <400000000>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				adap0_in: endpoint {
					remote-endpoint = <&csi2_0_out>;
				};
			};

			port@1 {
				reg = <1>;
				adap0_out: endpoint {
					remote-endpoint = <&isp_virt0_in>;
				};
			};
		};
	};

	adap1: adap1@ff55b400 {
		compatible = "amlogic,adap1";
		reg = <0x0 0xff55b400 0x0 0xe4>;
		reg-names = "adap";
		power-domains = <&pwrdm PWRC_A9_OPP_ID>;
		clocks = <&clkc CLKID_ISP>;
		clock-names = "isp";
		assigned-clocks = <&clkc CLKID_ISP>;
		assigned-clock-rates = <400000000>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				adap1_in: endpoint {
					remote-endpoint = <&csi2_1_out>;
				};
			};

			port@1 {
				reg = <1>;
				adap1_out: endpoint {
					remote-endpoint = <&isp_virt1_in>;
				};
			};
		};
	};

	adap2: adap2@ff55f000 {
		compatible = "amlogic,adap2";
		reg = <0x0 0xff55f000 0x0 0xe4>;
		reg-names = "adap";
		power-domains = <&pwrdm PWRC_A9_OPP_ID>;
		clocks = <&clkc CLKID_ISP>;
		clock-names = "isp";
		assigned-clocks = <&clkc CLKID_ISP>;
		assigned-clock-rates = <400000000>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				adap2_in: endpoint {
					remote-endpoint = <&csi2_2_out>;
				};
			};

			port@1 {
				reg = <1>;
				adap2_out: endpoint {
					remote-endpoint = <&isp_virt2_in>;
				};
			};
		};
	};

	adap3: adap3@ff55f400 {
		compatible = "amlogic,adap3";
		reg = <0x0 0xff55f400 0x0 0xe4>;
		reg-names = "adap";
		power-domains = <&pwrdm PWRC_A9_OPP_ID>;
		clocks = <&clkc CLKID_ISP>;
		clock-names = "isp";
		assigned-clocks = <&clkc CLKID_ISP>;
		assigned-clock-rates = <400000000>;
		status = "disabled";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				adap3_in: endpoint {
					remote-endpoint = <&csi2_3_out>;
				};
			};

			port@1 {
				reg = <1>;
				adap3_out: endpoint {
					remote-endpoint = <&isp_virt3_in>;
				};
			};
		};
	};

	isp: isp@ff540000 {
			compatible = "amlogic,isp";
			reg = <0x0 0xff540000 0x0 0x17780>,
			      <0x0 0xff566000 0x0 0x520>;
			reg-names = "base", "disp";
			interrupts = <GIC_SPI 382 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 371 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 372 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 373 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 379 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "fe_rst", "fe_done", "be_done",
					  "opp_done", "intf";
			status = "disabled";
	};

	isp_virt0: isp-virt0 {
		compatible = "amlogic,isp-virt0";
		isp = <&isp>;
		power-domains = <&pwrdm PWRC_A9_CVE_ID>;
		clocks = <&clkc CLKID_DEWARPA>, <&clkc CLKID_ISP>;
		clock-names = "dewarp", "isp";
		assigned-clocks = <&clkc CLKID_DEWARPA>, <&clkc CLKID_ISP>;
		assigned-clock-rates = <800000000>, <800000000>;
		status = "disabled";

		port {
			isp_virt0_in: endpoint {
				remote-endpoint = <&adap0_out>;
			};
		};
	};

	isp_virt1: isp-virt1 {
		compatible = "amlogic,isp-virt1";
		isp = <&isp>;
		power-domains = <&pwrdm PWRC_A9_CVE_ID>;
		clocks = <&clkc CLKID_DEWARPA>, <&clkc CLKID_ISP>;
		clock-names = "dewarp", "isp";
		assigned-clocks = <&clkc CLKID_DEWARPA>, <&clkc CLKID_ISP>;
		assigned-clock-rates = <800000000>, <800000000>;
		status = "disabled";

		port {
			isp_virt1_in: endpoint {
				remote-endpoint = <&adap1_out>;
			};
		};
	};

	isp_virt2: isp-virt2 {
		compatible = "amlogic,isp-virt2";
		isp = <&isp>;
		power-domains = <&pwrdm PWRC_A9_CVE_ID>;
		clocks = <&clkc CLKID_DEWARPA>, <&clkc CLKID_ISP>;
		clock-names = "dewarp", "isp";
		assigned-clocks = <&clkc CLKID_DEWARPA>, <&clkc CLKID_ISP>;
		assigned-clock-rates = <800000000>, <800000000>;
		status = "disabled";

		port {
			isp_virt2_in: endpoint {
				remote-endpoint = <&adap2_out>;
			};
		};
	};

	isp_virt3: isp-virt3 {
		compatible = "amlogic,isp-virt3";
		isp = <&isp>;
		power-domains = <&pwrdm PWRC_A9_CVE_ID>;
		clocks = <&clkc CLKID_DEWARPA>, <&clkc CLKID_ISP>;
		clock-names = "dewarp", "isp";
		assigned-clocks = <&clkc CLKID_DEWARPA>, <&clkc CLKID_ISP>;
		assigned-clock-rates = <800000000>, <800000000>;
		status = "disabled";

		port {
			isp_virt3_in: endpoint {
				remote-endpoint = <&adap3_out>;
			};
		};
	};

	secmon:secmon {
		compatible = "amlogic, secmon";
		memory-region = <&secmon_reserved>;
		in_base_func = <0x82000020>;
		out_base_func = <0x82000021>;
		inout_size_func = <0x8200002a>;
		reserve_mem_size = <0x03300000>;
	};

	optee {
		compatible = "linaro,optee-tz";
		method = "smc";
	};

	aml_watermark {
		compatible = "amlogic,watermark";
		soc-name = "s6";
		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>; //=viu-vsync
		interrupt-names = "wm-vsync";
	};

	cma_shrinker: cma_shrinker {
		compatible = "amlogic, cma-shrinker";
		status = "disabled";
		adj  = <0 100 200 250 900 950>;
		free = <8192 12288 16384 24576 28672 32768>;
	};

	securitykey {
		compatible = "aml, securitykey";
		storage_query = <0x82000060>;
		storage_read = <0x82000061>;
		storage_write = <0x82000062>;
		storage_tell = <0x82000063>;
		storage_verify = <0x82000064>;
		storage_status = <0x82000065>;
		storage_list = <0x82000067>;
		storage_remove = <0x82000068>;
		storage_in_func = <0x82000023>;
		storage_out_func = <0x82000024>;
		storage_block_func = <0x82000025>;
		storage_size_func = <0x82000027>;
		storage_set_enctype = <0x8200006A>;
		storage_get_enctype = <0x8200006B>;
		storage_version = <0x8200006C>;
	};

	xtal: xtal-clk {
		compatible = "fixed-clock";
		clock-frequency = <24000000>;
		clock-output-names = "xtal";
		#clock-cells = <0>;
	};

	xtal_32k: xtal-32k-clk {
		compatible = "fixed-clock";
		clock-frequency = <32768>;
		clock-output-names = "xtal_32k";
		#clock-cells = <0>;
	};

	rtc: rtc@ffa08000 {
		compatible = "amlogic,a9-rtc", "amlogic,a4-rtc";
		reg = <0x0 0xffa08000 0x0 0x38>;
		interrupts = <GIC_SPI 404 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-0 = <&rtc_32k_pins>;
		pinctrl-names = "default";
		clocks = <&xtal_32k>, <&ao_clkc CLKID_AO_SYS_RTC_DIG>;
		clock-names = "osc", "sys";
		status = "okay";
	};

	sm: secure-monitor {
		compatible = "amlogic,meson-gxbb-sm";
	};

	pwrdm: power-domains {
		compatible = "amlogic,a9-pwrc";
		#power-domain-cells = <1>;
		status = "okay";
	};

	adla: adla@fe098000 {
		compatible = "amlogic,adla-gen3b";
		dev_name = "adla";
		status = "okay";
		reg = <0x0 0xfe098000 0x0 0x2000
			0x0 0xf3c19000 0x0 0x3c000
			>;
		reg-names = "adla_reg\0adla_sram";
		interrupt-names = "adla";
		interrupts = <GIC_SPI 260 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkc CLKID_NNA_CORE>;
		clock-names = "adla_core_clk";
		power-domains=<&pwrdm PWRC_A9_NNA_4T_ID>;
		nn_hw_version="r4p0";
		adla_core_clk_rate = <1000000000>;
		adla_smc_cmd = <0x820000b2>;
		smmu;
	};

	jtag {
		compatible = "amlogic, jtag";
		status = "okay";
		select = "disable"; /* disable/jtag_a/jtag_b */
		pinctrl-names="jtag_a_pins", "jtag_b_pins";
		pinctrl-0=<&jtag_a_pins>;
		pinctrl-1=<&jtag_b_pins>;
	};

	mbox_fifo: mbox_fifo@fe006000 {
		status = "okay";
		compatible = "amlogic, a9-mbox-fifo";
		reg = <0x0 0xfe006000 0x0 0x800>,  /* mbox wr fifo */
		      <0x0 0xfe006800 0x0 0x800>,  /* mbox rd fifo */
		      <0x0 0xfe0070c0 0x0 0x40>,   /* mbox set reg */
		      <0x0 0xfe007100 0x0 0x40>,   /* mbox clr reg */
		      <0x0 0xfe007140 0x0 0x40>,   /* mbox sts reg */
		      <0x0 0xfe007020 0x0 0x40>;   /* mbox irqctrl reg */
		interrupts = <GIC_SPI 248 IRQ_TYPE_EDGE_RISING>;   /* mbox top irq */
		mbox-irqctlr = <0>;
		mbox-nums = <A9_MBOX_NUMS>;
		mboxids = <A9_MBOX_DSPA2REE>,
			  <A9_MBOX_REE2DSPA>,
			  <A9_MBOX_AO2REE>,
			  <A9_MBOX_REE2AO>;
		#mbox-cells = <1>;
		mbox-dests = <MAILBOX_ARM>,
			     <MAILBOX_DSPA>,
			     <MAILBOX_ARM>,
			     <MAILBOX_AOCPU>;
		dspa-hang-detect;
		aocpu-sts-mboxid = <A9_AOCPU_STS_CHAN>;
	};

	mbox_devfs {
		status = "okay";
		compatible = "amlogic, mbox-devfs";
		mbox-nums = <4>;
		mbox-names = "ree2aocpu",
			     "aocpu2ree",
			     "dsp_dev",
			     "dspa2ree";
		mboxes = <&mbox_fifo A9_REE2AO_DEV>,
			 <&mbox_fifo A9_AO2REE_DEV>,
			 <&mbox_fifo A9_REE2DSPA_DEV>,
			 <&mbox_fifo A9_DSPA2REE_DEV>;
	};

	aml_hwspinlock: hwlock {
		status = "disabled";
		compatible = "amlogic, hwspinlock";
		syscon = <&aml_hwspinlock_regs 0 0x4>;
		#hwlock-cells = <1>;
	};

	vddee: pwm_e-regulator { //default ee/gpu/ddr and npu_sram/gpu_sram on United One-Way Power
		compatible = "amlogic, pwm-regulator";
		pwms = <&pwm_e MESON_PWM_0 630 0>;
		regulator-name = "vddee";
		regulator-min-microvolt = <680000>;
		regulator-max-microvolt = <830000>;
		regulator-always-on;
		max-duty-cycle = <630>;
		amlogic,vsel-step = <3>;
		amlogic,usleep-time = <200>;
		amlogic,udelay-time = <40 20>;	//pwm 1nF
		/* Voltage Duty-Cycle */
		voltage-table = <830000 0>,
				<820000 7>,
				<810000 13>,
				<800000 20>,
				<790000 27>,
				<780000 33>,
				<770000 40>,
				<760000 47>,
				<750000 53>,
				<740000 60>,
				<730000 67>,
				<720000 73>,
				<710000 80>,
				<700000 87>,
				<690000 93>,
				<680000 100>;
		status = "okay";
	};

	vddnpu: pwm_f-regulator {
		compatible = "amlogic, pwm-regulator";
		pwms = <&pwm_f MESON_PWM_0 840 0>;
		regulator-name = "vddnpu";
		regulator-min-microvolt = <660000>;
		regulator-max-microvolt = <860000>;
		regulator-always-on;
		max-duty-cycle = <840>;
		amlogic,vsel-step = <3>;
		amlogic,usleep-time = <200>;
		amlogic,udelay-time = <40 20>;
		/* Voltage Duty-Cycle */
		voltage-table = <860000 0>,
				<850000 5>,
				<840000 10>,
				<830000 15>,
				<820000 20>,
				<810000 25>,
				<800000 30>,
				<790000 35>,
				<780000 40>,
				<770000 45>,
				<760000 50>,
				<750000 55>,
				<740000 60>,
				<730000 65>,
				<720000 70>,
				<710000 75>,
				<700000 80>,
				<690000 85>,
				<680000 90>,
				<670000 95>,
				<660000 100>;
		status = "okay";
	};

	vddcpu0: pwm_d-regulator {
		compatible = "amlogic, pwm-regulator";
		pwms = <&pwm_d MESON_PWM_0 1260 0>;
		regulator-name = "vddcpu0";
		regulator-min-microvolt = <679000>;
		regulator-max-microvolt = <979000>;
