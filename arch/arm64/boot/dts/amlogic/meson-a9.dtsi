		bootargs = "usbcore.autosuspend=-1 dm_mod.reserved_bio_based_ios=8";
	};

	gpu_opp_table: gpu_opp_table {
		compatible = "operating-points-v2";
		opp-285 {
			opp-hz = /bits/ 64 <285714281>;
			opp-microvolt = <1150>;
		};
		opp-400 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <1150>;
		};
		opp-500 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <1150>;
		};
		opp-666 {
			opp-hz = /bits/ 64 <666666666>;
			opp-microvolt = <1150>;
		};
		opp-800 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <1150>;
		};
		opp-996 {
			opp-hz = /bits/ 64 <996000000>;
			opp-microvolt = <1150>;
		};
	};

	smmu: aml_smmu {
		compatible = "amlogic,smmu";
		status = "okay";
		#iommu-cells = <1>;
		memory-region = <&pcie_dma_ops_mm>;
	};

	codec_mm {
		compatible = "amlogic, codec, mm";
		memory-region = <&codec_mm_cma &codec_mm_reserved &secure_vdec_reserved\
			&codec_mm_reserved_ext>;
		dev_name = "codec_mm";
		status = "okay";
		/*
		 * scatter_alloc_mode: the mode of scatter memory allocation
		 * 0: default mode, alloc from system and cma
		 * 1: only alloc from system
		 */
		scatter_alloc_mode = <1>;
	};
	encmem_rev {
		compatible = "encmem_rev";
		dev_name = "encmem";
		status = "okay";
	};
	amdolby_vision {
		compatible = "amlogic, dolby_vision_s6";
		dev_name = "aml_amdolby_vision_driver";
		status = "disabled";
		tv_mode = <0>;/*1:enable ;0:disable*/
	};

	cvbsout {
		compatible = "amlogic, cvbsout-s4";
		status = "disabled";

		/* clk path */
		/* 0:vid_pll vid2_clk */
		/* 1:gp0_pll vid2_clk */
		/* 2:vid_pll vid1_clk */
		/* 3:gp0_pll vid1_clk */
		clk_path = <0>;

		/* performance: reg_address, reg_value */
		/* s4 */
		performance_pal = <0x1bf0  0x9 /* default Matrx625 CTCC value*/
			0x1b12  0x80c0
			0x1b05  0xf7
			0x1b56  0x333
			0x1c59  0xf25c
			0xffff  0x0>; /* ending flag */
		performance = <0x1bf0  0x9 /* ccitt033 SVA value */
			0x1b12  0x8040
			0x1b05  0xfd
			0x1b56  0x333
			0x1c59  0xf654
			0xffff  0x0>; /* ending flag */
		performance_ntsc = <0x1bf0  0x9
			0x1b12  0x8020
			0x1b03  0x0
			0x1b04  0x0
			0x1b05  0x0
			0x1b06  0x0
			0x1b56  0x333
			0x1c59  0xf850
			0xffff  0x0>; /* ending flag */
	};

	ionvideo {
		compatible = "amlogic, ionvideo";
		dev_name = "ionvideo";
		status = "disabled";
	};

	amlvideo2_0: amlvideo2_0 {
		compatible = "amlogic, amlvideo2";
		dev_name = "amlvideo2";
		vpu_dma_mask = <1>;  /* 0: <= 4G, 1: > 4G*/
		status = "okay";
		amlvideo2_id = <0>;
		cma_mode = <1>;
	};

	amlvideo2_1: amlvideo2_1 {
		compatible = "amlogic, amlvideo2";
		dev_name = "amlvideo2";
		vpu_dma_mask = <1>;  /* 0: <= 4G, 1: > 4G*/
		status = "okay";
		amlvideo2_id = <1>;
		cma_mode = <1>;
		/*720P_NV21:1, 1080P_NV21:2, 4K_NV21:3, default:4*/
		codec_mm_alloc = <1>;
	};

	amvdec_csi: amvdec_csi {
		compatible = "amlogic, amvdec_csi-s6";
		status = "okay";
		csi_id = <0>;
		squlech_mode = <0>;
		deskew_mode = <0>;
		reg = <0x0 0xfe014000 0x0 0x00000100>,
			<0x0 0xfe016000 0x0 0x00000100>,
			<0x0 0xfe018000 0x0 0x00000100>;
		reg-names = "csi_phy", "csi_host", "csi_adapt";

		//clocks = <&clkc CLKID_CSI2_ADAPT>,
		//	   <&clkc_mipi_csi_phy>;
		clock-names = "cts_csi_adapt_clk_composite",
			"cts_csi_phy_clk_composite";

		// depends on power domain.
		//power-domains = <&pwrdm PDID_S6_ADAPT>;

		// 88 for csi2_adap_int
		interrupts = <GIC_SPI 88 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "csi_phy";
	};

