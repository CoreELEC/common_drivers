	vddcpu1_sram: pwm_b-regulator {
		vin-supply = <&vdd1v8_ao_reg>;
		compatible = "amlogic, pwm-regulator";
		pwms = <&pwm_b MESON_PWM_0 1260 0>;
		regulator-name = "vddcpu1_sram";
		regulator-min-microvolt = <679000>;
		regulator-max-microvolt = <979000>;
		regulator-always-on;
		max-duty-cycle = <1260>;
		/* Voltage Duty-Cycle */
		voltage-table = <979000 0>,
				<969000 3>,
