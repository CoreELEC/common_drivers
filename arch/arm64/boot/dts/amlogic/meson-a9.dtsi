		usbphyc: usb-phy@fe4ac000 {
			compatible = "amlogic,uphy-a9";
			reg = <0x0 0xfe4ac000 0x0 0x100>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0x0 0xffffffff>;
			status = "disabled";
			u2pcport0: u2p@fe4ac000 {
				#phy-cells = <0>;
				port-speed = <0x0>; /* 0~2: HS HSP SS */
				reg = <0xfe4ac000 0x100
						0xfe002000 0x100
						0xfe010330 0x4
						0xfe4ae000 0x64>;
				reset-level = <0x48>;
				phy-reset-level-bits = <20>;
				usb-comb-reset-bit = <14>;
				/* u2phy apb & dwc3c share the same reset line.
				 * don't trigger it in phy_init().
				 */
				//phy-apb-reset-bit = <13>;
				pll-settings = <0x0
								0x0
								0x0
								0x0
								0x7>;
				clocks = <&clkc CLKID_SYS_U2H>,
					 <&clkc CLKID_SYS_PERIPH>,
					 <&clkc CLKID_PP>,
					 <&xtal>;
				clock-names = "usb_general", "apb_bus", "pp_clk", "xtal";
				assigned-clocks = <&clkc CLKID_PP>;
				assigned-clock-rates = <400000000>;
				power-domains = <&pwrdm PWRC_A9_U2H_ID>;
				sw-hsp;
				status = "okay";
			};
		};

