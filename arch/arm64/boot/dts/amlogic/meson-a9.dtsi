				 <AML_PINMUX(AMLOGIC_GPIO_Z, 11, 4)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 12, 4)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 13, 4)>;
			drive-strength-microamp = <3000>;
		};
	};

	/* ??? spif_hold spif_mo spif_mi spif_clk spif_wp spif_cs */
	func-spifc {
		spifc_pins: group-spifc-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_Z, 8, 4)>;
			drive-strength-microamp = <3000>;
		};
	};

	func-irblaster {
		/* ??? ir_remote_out_f */
		irblaster_pin_f: group-irblaster-f-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_Z, 8, 4)>;
			drive-strength-microamp = <3000>;
		};

		/* ??? ir_remote_out_h */
		irblaster_pin_h: group-irblaster-h-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_Z, 8, 4)>;
			drive-strength-microamp = <3000>;
		};

		/* ??? ir_remote_out_z */
		irblaster_pin_z: group-irblaster-z-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_Z, 8, 4)>;
			drive-strength-microamp = <3000>;
		};
		/* ??? ir_remote_out_a */
		irblaster_pin_a: group-irblaster-a-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_Z, 8, 4)>;
			drive-strength-microamp = <3000>;
		};
	};

	/* ??? spdif_in */
	func-spdif {
		spdifin: group-spdif-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_Z, 8, 4)>;
			drive-strength-microamp = <3000>;
		};
	};

	func-eth-a {
		eth_a_mdio_pins: group-eth-a-mdio-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_Z, 0, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 1, 1)>;
			drive-strength-microamp = <3000>;
			bias-disable;
		};

		eth_a_pins: group-eth-a-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_Z, 0, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 1, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 2, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 3, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 4, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 5, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 9, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 10, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 11, 1)>;
			drive-strength-microamp = <3000>;
			bias-disable;
		};

		eth_a_rgmii_pins: group-eth-a-rgmii-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_Z, 6, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 7, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 8, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 12, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_Z, 13, 1)>;
			drive-strength-microamp = <3000>;
			bias-disable;
		};
	};

	func-eth-b {
		eth_b_pins: group-eth-b-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_A, 0, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 1, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 2, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 3, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 4, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 5, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 9, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 10, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 11, 7)>;
			drive-strength-microamp = <3000>;
			bias-disable;
		};

		eth_b_rgmii_pins: group-eth-b-rgmii-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_A, 6, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 7, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 8, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 12, 7)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 13, 7)>;
			drive-strength-microamp = <3000>;
			bias-disable;
		};
	};

	/* from mesona9_aduio.dtsi */
	func-audio {
		tdmb_pin: group-audio-tdmb-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_A, 1, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 2, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 3, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 4, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 5, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 6, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 7, 1)>;
		};

		tdmout_b_gpio: group-audio-tdmout-b-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_A, 1, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 2, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 3, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 4, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 5, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 6, 0)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 7, 0)>;
			output-low;
		};

		mclk_1_pad: group-audio-mclk-pad-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_A, 0, 1)>;
		};
	};

	/* from ervery dts */
	func-dvb {
		dvb_s_ts0_pins: group-dvb-s-ts0-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_A, 0, 5)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 1, 5)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 2, 5)>,
				 <AML_PINMUX(AMLOGIC_GPIO_A, 3, 5)>;
		};
	};

	/* from ervery dts */
	func-tdm {
		bt_pcm_gpio_x_pins: group-tdma-bt-pcm-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_X, 7, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_X, 8, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_X, 9, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_X, 10, 1)>;
		};
	};
};

&aobus_pinctrl {
	func-jtag-a {
		jtag_a_pins: group-jtag-a-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 8, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 9, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 10, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 11, 2)>;
		};
	};

	func-aocec {
		eecec_b: group-eecec-b-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 14, 2)>;
			bias-pull-up;
		};
	};

	func-jtag-b {
		jtag_b_pins: group-jtag-b-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 1, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 4, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 5, 2)>;
		};
	};

	func-sdcard {
		sdcard_pins: group-sdcard-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 1, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 2, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 3, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 4, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 5, 1)>;
			bias-pull-up;
			drive-strength-microamp = <4000>;
		};

		sd_1bit_pins: group-sd-1bit-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 4, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 5, 1)>;
			bias-pull-up;
			drive-strength-microamp = <4000>;
		};

		sdcard_clk_gate_pins: group-sdcard-clk-gate-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 4, 0)>;
			bias-pull-down;
			drive-strength-microamp = <4000>;
		};
	};

	func-spisg-a {
		spisg_a_pins_d: group-spisg-a-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 2, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 3, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 4, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 5, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 6, 2)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 7, 2)>;
			bias-pull-up;
			drive-strength-microamp = <3000>;
		};

		spisg_a_pins_ao: group-spisg-a-pins2 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 0, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 1, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 2, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 3, 3)>;
			bias-pull-up;
			drive-strength-microamp = <3000>;
		};
	};

	func-spisg-b {
		spisg_b_pins_ao: group-spisg-b-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 4, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 5, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 6, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 7, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 8, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 9, 3)>;
			bias-pull-up;
			drive-strength-microamp = <3000>;
		};
	};

	func-spisg-d {
		spisg_d_pins_c: group-spisg-d-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 1, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 2, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 3, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 4, 3)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 5, 3)>;
			bias-pull-up;
			drive-strength-microamp = <3000>;
		};
	};

	func-rtc-32k {
		rtc_32k_pins: group-rtc-32k-pins1 {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 4, 3)>;
			bias-pull-up;
			input-enable;
		};
	};

	func-uart-b {
		b_ao_uart_pins: group-uart-b-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 0, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 1, 1)>;
			drive-strength = <3>;
			bias-pull-up;
		};
	};

	func-uart-c {
		c_ao_uart_pins: group-uart-c-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 2, 4)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 3, 4)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 4, 4)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 5, 4)>;
			drive-strength = <3>;
			bias-pull-up;
		};
	};

	func-uart-d {
		d_ao_uart_pins: group-uart-d-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_C, 0, 6)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 1, 6)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 5, 6)>,
				 <AML_PINMUX(AMLOGIC_GPIO_C, 6, 6)>;
			drive-strength = <3>;
			bias-pull-up;
		};
	};

	func-uart-e {
		e_ao_uart_pins: group-uart-e-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 8, 5)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 9, 5)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 10, 5)>,
				 <AML_PINMUX(AMLOGIC_GPIO_D, 11, 5)>;
			drive-strength = <3>;
			bias-pull-up;
		};
	};

	/* from mesona9_aduio.dtsi */
	func-audio {
		pdmin: group-aduio-pdmin-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_AO, 6, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 7, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 8, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 9, 1)>,
				 <AML_PINMUX(AMLOGIC_GPIO_AO, 10, 1)>;
		};

		spdifout_a: group-aduio-spdifout-a-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 13, 2)>;
		};

		spdifout_a_mute: group-aduio-spdifout-a-mute-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 13, 0)>;
		};
		spdifin_a: group-aduio-spdifin-a-pins {
			pinmux = <AML_PINMUX(AMLOGIC_GPIO_D, 13, 3)>;
		};
	};
};

&gpu{
	status = "okay";
	operating-points-v2 = <&gpu_opp_table>;
	reg =   <0x0 0xFD000000 0x0 0x800000>, /*mali APB bus base address*/
		<0x0 0xFE002000 0x0 0x01000>; /*reset register*/

	interrupts = <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 147 IRQ_TYPE_LEVEL_HIGH>,
		     <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "GPU", "MMU", "JOB";

	/* Protected memory allocator default not available*/
	//protected-memory-allocator = <&gpu_protected_memory_allocator>;

	qchannel-reg = <0xFE010404>;
	qchannel-enabled = <1>;
	qchannel-supported = <1>;

	num_of_pp = <1>;
	system-coherency = <31>;
	clocks = <&clkc CLKID_MALI>,
		 <&clkc CLKID_MALI_STACK>;
	clock-names = "gpu_mux", "gpu_stack";

	assigned-clocks = <&clkc CLKID_MALI>,
			  <&clkc CLKID_MALI_STACK>;
	assigned-clock-rates = <400000000>,
			       <400000000>;

};

#include "mesona9_cpufreq.dtsi"
