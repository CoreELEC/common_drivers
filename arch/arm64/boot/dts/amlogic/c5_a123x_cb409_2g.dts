/dts-v1/;

#include "meson-c5.dtsi"
//#include "hdr10plus.dtsi"
#include "mesonc5_drm.dtsi"
#include "mesonc5_audio.dtsi"
//#include "firmware_ab.dtsi"
#include "meson-c5-panel.dtsi"

/ {
	amlogic-dt-id = "c5_a123x_cb409-2g";
	compatible = "c5_a123x_cb409-2g";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial0 = &uart_AO_B;
		serial1 = &uart_E;
		serial2 = &uart_B;
		serial3 = &uart_C;
		serial4 = &uart_D;
		serial5 = &uart_F;
		serial6 = &uart_AO_A;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		spi0 = &spi_nfc;
		spi1 = &spisg_b;
		spi2 = &spisg_c;
		spi3 = &spisg_d;
		tsensor0 = &nna_tsensor;
		tsensor1 = &isp_tsensor;
		tsensor2 = &pll_tsensor;
	};

	memory@0 {
		device_type = "memory";
		linux,usable-memory = <0x0 0x0 0x0 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramdump_bl33z {
			compatible = "shared-dma-pool";
			size = <0x0 0x01800000>;
			alignment = <0x0 0x400000>;
			alloc-ranges = <0x0 0x05000000 0x0 0x07000000>;
			linux,contiguous-region;
			no-map;
			status = "disabled";
		};

		secmon_reserved:linux,secmon {
			compatible = "shared-dma-pool";
			no-map;
			alignment = <0x0 0x100000>;
			reg = <0x0 0x05000000 0x0 0x00b00000>;
		};

		nna_cma_reserved: linux,nna_cma {
			compatible = "shared-dma-pool";
			size = <0x0 0x1000000>;
			alignment = <0x0 0x400000>;
			reusable;
			status = "disabled";
		};

		logo_reserved:linux,meson-fb {
			compatible = "amlogic, meson-fb";
			alignment = <0x0 0x400000>;
			reg = <0x0 0x7f800000 0x0 0x800000>;
			status = "disabled";
		};

		ion_cma_reserved:linux,ion-dev {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x3000000>;
			alignment = <0x0 0x400000>;
			status = "disabled";
		};

		rtos_reserved:linux,rtos_reserved {
			compatible = "amlogic, aml_rtos_memory";
			status = "disabled";
			reg = <0x0 0x4800000 0x0 0x200000>;
			no-map;
		};

		dsp_fw_reserved:linux,dsp_fw {
			compatible = "amlogic, dsp";
			size = <0x0 0x800000>;
			reg = <0x0 0x30000000 0x0 0x800000>;
			status = "disabled";
		};

		ramoops@8400000 {
			compatible = "ramoops";
			status = "okay";
			reg = <0x0 0x08400000 0x0 0x00100000>;
			record-size = <0x20000>;
			console-size = <0x20000>;
			ftrace-size = <0x80000>;
			pmsg-size = <0x0>;
		};

		dmc_reserved:linux,dmc_monitor {
			compatible = "amlogic,dmc_monitor-reserved";
			reg = <0x0 0x0 0x0 0x0>;
			status = "disabled";
		};

		debug_reserved:linux,iotrace {
			compatible = "amlogic, iotrace";
			reg = <0x0 0x04f00000 0x0 0x00100000>;
			io-size = <0x1b000>;
			sched-size = <0x2000>;
			irq-size = <0x1000>;
			smc-size = <0x1000>;
			misc-size = <0x1000>;
			status = "disabled";
		};

		pmz_cma_a1_reserved:anonymous {
			compatible = "shared-dma-pool";
			no-map;
			size = <0x0 0x15E00000>;
			alignment = <0x0 0x400000>;
			status = "okay";
		};

		pmz_cma_a2_reserved:user_pmz {
			compatible = "shared-dma-pool";
			no-map;
			size = <0x0 0x1000000>;
			alignment = <0x0 0x400000>;
			status = "disabled";
		};

		codec_mm_cma:linux,codec_mm_cma {
			compatible = "shared-dma-pool";
			reusable;
			/* ion_codec_mm max can alloc size 80M*/
			size = <0x0 0xD000000>;
			alignment = <0x0 0x400000>;
			linux,contiguous-region;
			status = "disabled";
		};

		/* codec shared reserved */
		codec_mm_reserved:linux,codec_mm_reserved {
			compatible = "amlogic, codec-mm-reserved";
			size = <0x0 0x0>;
			alignment = <0x0 0x100000>;
			//no-map;
			status = "disabled";
		};

		jpegenc_cma_reserved:linux,jpegenc_cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x0>;
			alignment = <0x0 0x400000>;
			status = "disabled";
		};

		/* global autoconfigured region for contiguous allocations */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x800000>;
			alignment = <0x0 0x400000>;
			linux,cma-default;
			status = "disabled";
		};

		pcie_dma_ops_mm:linux,pcie_dma_ops {
			compatible = "shared-dma-pool";
			status = "disabled";
			reusable;
			size = <0x0 0x2000000>;
			swiotlb-size = <0x0 0x1c00000>;
			atomic-size = <0x0 0x40000>;
			alignment = <0x0 0x400000>;
			alloc-ranges = <0x0 0x0 0x0 0xe0000000>;
		};
	};

	sensor0: sensor0 {
		compatible = "amlogic, sensor0";
		status = "okay";
		clocks = <&clkc CLKID_MCLK_0>, <&clkc CLKID_MCLK_1>,
			 <&clkc CLKID_MCLK1_0>, <&clkc CLKID_MCLK1_1>;
		clock-names = "mclk", "mclk1", "mclk2", "mclk3";
		devices-type = <1>;
		reset-gpios = <&gpio_ao GPIOAO_8 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio_ao GPIOAO_18 GPIO_ACTIVE_HIGH>;
		reset-1-gpios = <&gpio_ao GPIOAO_8 GPIO_ACTIVE_HIGH>;
		pwdn-1-gpios = <&gpio_ao GPIOAO_18 GPIO_ACTIVE_HIGH>;
		reset-2-gpios = <&gpio_ao GPIOP_3 GPIO_ACTIVE_HIGH>;
		pwdn-2-gpios = <&gpio_ao GPIOP_2 GPIO_ACTIVE_HIGH>;
		reset-3-gpios = <&gpio_ao GPIOP_3 GPIO_ACTIVE_HIGH>;
		pwdn-3-gpios = <&gpio_ao GPIOP_2 GPIO_ACTIVE_HIGH>;
	};

	pmz_a1_dev {
		compatible = "amlogic, pmz_dev";
		memory-region = <&pmz_cma_a1_reserved>;
		pmz-allocator = "priv";
	};

/* Audio Related start */
	auge_sound {
		compatible = "amlogic, auge-sound-card";
		aml-audio-card,name = "AML-AUGESOUND";
		spk_mute-gpios = <&gpio GPIOD_10 GPIO_ACTIVE_LOW>;
		spk_mute_sleep_time = <800>;

		aml-audio-card,dai-link@0 {
			format = "dsp_b";
			mclk-fs = <512>;
			//continuous-clock;
			//bitclock-inversion;
			//frame-inversion;
			/* master mode */
			bitclock-master = <&tdma>;
			frame-master = <&tdma>;
			/* slave mode */
			/*
			 * bitclock-master = <&tdmacodec>;
			 * frame-master = <&tdmacodec>;
			 */
			/* suffix-name, sync with android audio hal used for */
			suffix-name = "alsaPORT-pcm";
			tdmacpu: cpu {
				sound-dai = <&tdma>;
				dai-tdm-slot-tx-mask =
							<1 1>;
				dai-tdm-slot-rx-mask =
							<1 1>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <16>;
				system-clock-frequency = <256000>;
			};
			tdmacodec: codec {
				sound-dai = <&dummy_codec>;
			};
		};

		aml-audio-card,dai-link@1 {
			format = "i2s";
			mclk-fs = <256>;
			continuous-clock;
			//bitclock-inversion;
			//frame-inversion;
			/* master mode */
			bitclock-master = <&tdmb>;
			frame-master = <&tdmb>;
			/* slave mode */
			//bitclock-master = <&tdmbcodec>;
			//frame-master = <&tdmbcodec>;
			/* suffix-name, sync with android audio hal used for */
			suffix-name = "alsaPORT-i2s";
			cpu {
				sound-dai = <&tdmb>;
				dai-tdm-slot-tx-mask = <1 1>;
				dai-tdm-slot-rx-mask = <1 1>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
				system-clock-frequency = <12288000>;
			};
			tdmbcodec: codec {
				sound-dai = <&acodec>;
			};
		};

		aml-audio-card,dai-link@2 {
			mclk-fs = <64>;
			/* suffix-name, sync with android audio hal used for */
			suffix-name = "alsaPORT-pdm-builtinmic";
			cpu {
				sound-dai = <&pdma>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};

		aml-audio-card,dai-link@3 {
			mclk-fs = <256>;
			continuous-clock;
			suffix-name = "alsaPORT-loopback";
			cpu {
				sound-dai = <&loopbacka>;
				system-clock-frequency = <12288000>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};
		//aml-audio-card,dai-link@4 {
		//	mclk-fs = <256>;
		//	suffix-name = "alsaPORT-Sed";
		//	cpu {
		//		sound-dai = <&sed>;
		//	};
		//	codec {
		//		sound-dai = <&dummy_codec>;
		//	};
		//};
	};
	/* Audio Related end */
	picdec {
		compatible = "amlogic, picdec";
		status = "disabled";
	};

	adc_keypad {
		compatible = "amlogic, adc_keypad";
		status = "okay";
		key_name = "update", "vol-", "vol+", "ok";
		key_num = <4>;
		io-channels = <&saradc SARADC_CH4>;
		io-channel-names = "key-chan-4";
		key_chan = <SARADC_CH4 SARADC_CH4 SARADC_CH4 SARADC_CH4>;
		key_code = <KEY_SETUP KEY_VOLUMEDOWN KEY_VOLUMEUP KEY_ENTER>;
		key_val = <0 252 468 684>;	// Unit: millivolt
		key_tolerance = <70 70 70 70>;	// Unit: millivolt
	};

	gpio_keypad {
		compatible = "amlogic, gpio_keypad";
		status = "okay";
		scan_period = <20>;
		key_num = <1>;
		key_name = "power";
		key_code = <KEY_ENTER>;
		key_type = <EV_KEY>;
		key-gpios = <&gpio_ao GPIOAO_9 GPIO_ACTIVE_HIGH>;
		amlogic,auto-bias-cfg;
		/* 0:polling mode, 1:irq mode */
		detect_mode = <0>;
	};
};

&periphs_pinctrl {
	/* Audio Related start */
		tdmout_a: tdmout_a {
		mux { /* GPIOX_11, GPIOX_10, GPIOX_9 */
			groups = "tdm_a_sclk",
				"tdm_a_fs",
				"tdm_a_dout0";
			function = "tdm_a";
		};
	};

	tdmin_a: tdmin_a {
		mux { /* GPIOX_8 */
			groups = "tdm_a_din1";
			function = "tdm_a";
		};
	};

	tdmb_mclk: tdmb_mclk {
		mux {
			groups = "mclk_0";
			function = "mclk_0";
			drive-strength = <2>;
		};
	};

	tdmout_b: tdmout_b {
		mux { /* GPIOA_1, GPIOA_2, GPIOA_3 */
			groups = "tdm_b_sclk",
				"tdm_b_fs",
				"tdm_b_dout0";
			function = "tdm_b";
			drive-strength = <2>;
		};
	};

	tdmin_b:tdmin_b {
		mux { /* GPIOA_7 */
			groups = "tdm_b_din0";
			function = "tdm_b";
			drive-strength = <2>;
		};
	};

	spdifin: spdifin {
		mux {/* GPIOF_6 */
			groups = "spdif_in_f6";
			function = "spdif_in";
		};
	};
	/* Audio Related end */
};

&vdd_npu2_sram {
	status = "okay";
};

&vdd_npu3_sram {
	status = "okay";
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c0_ao_pins1>;
	pinctrl-1 = <&i2c0_ao_pins1_sleep>;
	clock-frequency = <100000>; /* default 100k */
};

&i2c2 {
	status = "disabled";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c2_ao_pins1>;
	pinctrl-1 = <&i2c2_ao_pins1_sleep>;
	clock-frequency = <100000>; /* default 100k */
};

&i2c3 {
	status = "disabled";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&i2c3_pins2>;
	pinctrl-1 = <&i2c3_pins2_sleep>;
	clock-frequency = <100000>; /* default 100k */
};

&adla {
	status = "okay";
	//memory-region = <&nna_cma_reserved>;
};

/* SDIO */
&sd_emmc_a {
	status = "okay";
	pinctrl-0 = <&sdio_pins>;
	pinctrl-1 = <&sdio_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";
	#address-cells = <1>;
	#size-cells = <0>;

	bus-width = <4>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	max-frequency = <200000000>;

	non-removable;
	disable-wp;

	//vmmc-supply = <&vddao_3v3>;
	//vqmmc-supply = <&vddio_ao1v8>;

	brcmf: wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

/* SD card */
&sd_emmc_b {
	status = "okay";
	pinctrl-0 = <&sdcard_pins>;
	pinctrl-1 = <&sdcard_clk_gate_pins>;
	pinctrl-2 = <&sd_1bit_pins>;
	pinctrl-names = "sd_default",
			"clk-gate",
			"sd_1bit_pins";
	bus-width = <4>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	max-frequency = <200000000>;
	disable-wp;

	cd-gpios = <&gpio GPIOC_6 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&card_3v3>;
	vqmmc-supply = <&vddio_c>;
};

&sd_emmc_c {
	status = "okay";
	pinctrl-0 = <&emmc_pins>, <&emmc_ds_pins>;
	pinctrl-1 = <&emmc_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";

	bus-width = <8>;
	cap-mmc-highspeed;
	//mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	max-frequency = <200000000>;
	non-removable;
	disable-wp;

	//mmc-pwrseq = <&emmc_pwrseq>;
	//vmmc-supply = <&vddao_3v3>;
	//vqmmc-supply = <&vddao_1v8>;
};

&pdma {
	pinctrl-names = "pdm_pins";
	pinctrl-0 = <&pdmin>;
};

&aml_wifi {
	status = "okay";
	interrupt-gpios = <&gpio_ao  GPIOAO_13  GPIO_ACTIVE_HIGH>;
	power_on-gpios = <&gpio_ao   GPIOAO_17  GPIO_ACTIVE_HIGH>;
};

&aml_bt {
	status = "okay";
};

&uart_E {
	status = "okay";
};

&mtd_nand {
	status = "disabled";
	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-names = "nand_norb_mod","nand_cs_only";
	pinctrl-0 = <&all_nand_pins>;
	pinctrl-1 = <&nand_cs_pins>;
	bl_mode = <1>;
	fip_copies = <4>;
	fip_size = <0x200000>;
	ship_bad_block = <1>;
	disa_irq_flag = <1>;
	nand@bootloader {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-ecc-maximize;
		partition@0 {
			label = "bootloader";
			reg = <0x0 0x00000000>;
		};
	};
	nand@normal {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		nand-ecc-maximize;

		partition@0 {
			label = "tpl";
			reg = <0x0 0x00000000>;
		};
		partition@2 {
			label = "recovery";
			reg = <0x0 0x2000000>;
		};
		partition@3 {
			label = "boot";
			reg = <0x0 0x2000000>;
		};
		partition@4 {
			label = "system";
			reg = <0x0 0x13000000>;
		};
		partition@5 {
			label = "data";
			reg = <0x0 0xffffffff>;
		};
	};
};

&isp0 {
	assigned-clocks = <&clkc CLKID_MCLK_PLL>, <&clkc CLKID_MCLK_0_PRE>,
			  <&clkc CLKID_MCLK_1_PRE>,  <&clkc CLKID_MCLK1_PLL>,
			  <&clkc CLKID_MCLK1_0_PRE>, <&clkc CLKID_MCLK1_1_PRE>;
	assigned-clock-rates = <2376000000>, <74250000>, <74250000>,
			       <2376000000>, <74250000>, <74250000>;
};

&spi_nfc {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&spinf_pins>;
	spi-nand@0 {
		compatible = "spi-nand";
		status = "disabled";
		reg = <0>;
		spi-max-frequency = <83000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
	spi-nor@0 {
		compatible = "spi-nor";
		status = "disabled";
		reg = <0>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		spi-max-frequency = <83000000>;
		m25p,fast-read;
		/* partition info sram addr */
		param_sram_addr = <0xF3D36800>;
		param_sram_size = <0x400>;
	};
};

&drm_vpu {
	status = "okay";
	logo_addr = "0x3f800000";
	connectors_dev: port@1 {
		drm_to_lcd0: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&lcd0_to_drm>;
		};
	};
};

&lcd {
	ports {
		port {
			#address-cells = <1>;
			#size-cells = <0>;
			lcd0_to_drm: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&drm_to_lcd0>;
			};
		};
	};
};

&ethmac {
	status = "okay";
	pinctrl-0 = <&eth_pins>, <&eth_rgmii_pins>;
	pinctrl-names = "default";
	phy-mode = "rgmii";
	phy-handle = <&external_phy>;
	mc_val = <0x1621>;
	cali_val = <0x80000>;
	/* 1:inphy; 2:exphy; */
	internal_phy = <2>;
};

&saradc {
	status = "okay";
};

&freertos {
	status = "disabled";
};

&amlvecm {
	compatible = "amlogic, vecm-c5";
	dev_name = "aml_vecm";
	status = "okay";
	gamma_en = <0>;/*1:enable ;0:disable*/
	wb_en = <0>;/*1:enable ;0:disable*/
	vlock_en = <0>;/*1:enable;0:disable*/
};

&ir {
	status = "disabled";
	pinctrl-0 = <&remote_pins>;
	pinctrl-names = "default";
};

&usbphy0 {
		status = "okay";
		u2p@0 {
			status = "okay";
			gpio-vbus-power = "GPIOD_5";
			gpios = <&gpio GPIOD_5 GPIO_ACTIVE_HIGH>;
		};
		u3p@80 {
				status = "okay";
		};
};

&usbphy1 {
		status = "okay";
		u2p@0 {
				status = "okay";
		};
};

&dwc3otg1 {
		status = "disabled";
		dr_mode = "otg"; /*otg, host,peripheral */
		controller-type = <1>; /*3:otg, 1: host,2:peripheral */
};

&dwc3otg2 {
		status = "disabled";
		dr_mode = "otg"; /*otg, host,peripheral */
		controller-type = <1>; /*3:otg, 1: host,2:peripheral */
};

&dwc3a {
		status = "okay";
};

&dwc3b {
		status = "okay";
};

&spisg_b {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&spisg_b_pins_x>;
};

/*don't enable alsa config if mbd driver load*/
&mbd_audio {
	avout_mute-gpios = <&gpio GPIOD_10 GPIO_ACTIVE_HIGH>;
	// hp_mute-gpios = <&gpio GPIOD_10 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "mbd_audio_pins";
	pinctrl-0 = <&pdmin>;
	status = "okay";
};

&pcie_phy {
	status = "disabled";
};

&pcie {
	reset-gpio = <&gpio_ao GPIOF_5 GPIO_ACTIVE_HIGH>;
	max-link-speed=<2>;
	iommu-map = <0x100 &smmu 0x5 0x400>;
	status = "disable";
};
