&hdmirx {
	status = "okay";
	pinctrl-0 = <&hdmirx_a_mux>;
	en_4k_2_2k = <0>;
	hpd_low_cec_off = <1>;
	arc_port = <0>;
	/* bit4: enable feature, bit3~0: port number */
	disable_port = <0x0>;
};
/*if you want to use vdin just modify status to "ok"*/
&vdin0 {
	/*compatible = "amlogic, vdin-s6";*/
	/*memory-region = <&vdin0_cma_reserved>;*/
	/*status = "disabled";*/
	/* up to 1920x1080 yuv422 8bit and 5 buffers
	 * 1920x1080x2x5 = 20 M
	 */
	cma_size = <20>;
	/*vdin write mem color depth support:
	 *bit0:support 8bit
	 *bit1:support 9bit
	 *bit2:support 10bit
	 *bit3:support 12bit
	 *bit4:support yuv422 10bit full pack mode (from txl new add)
	 */
	tv_bit_mode = <0x1>;
};

&vdin1 {
	/*compatible = "amlogic, vdin-s6";*/
	memory-region = <&vdin1_cma_reserved>;
	frame_buff_num = <4>;
	/*status = "disabled";*/
	/*vdin write mem color depth support:
	 *bit0:support 8bit
	 *bit1:support 9bit
	 *bit2:support 10bit
	 *bit3:support 12bit
	 */
	tv_bit_mode = <1>;
};

&amlvideo2_1 {
	memory-region = <&amlvideo2_1_cma_reserved>;
	cma_mode = <0>;
};

&aml_wifi{
	status = "disabled";
	interrupt-gpios = <&gpio  GPIOX_7  GPIO_ACTIVE_HIGH>;
	power_on-gpios = <&gpio   GPIOX_6  GPIO_ACTIVE_HIGH>;
};

&aml_bt {
	status = "disabled";
	reset-gpios = <&gpio    GPIOX_17 GPIO_ACTIVE_HIGH>;
	// TODO: must check! // btwakeup-gpios = <&gpio    GPIOX_18 GPIO_ACTIVE_HIGH>;
	// TODO: must check! // hostwake-gpios = <&gpio GPIOX_19 GPIO_ACTIVE_HIGH>;
};

&pwm_e {
	pinctrl-0 = <&pwm_e_pins1>;
	pinctrl-names = "default";
	status = "okay";
};

&uart_A {
	status = "okay";
	uart-has-rtscts;
};

