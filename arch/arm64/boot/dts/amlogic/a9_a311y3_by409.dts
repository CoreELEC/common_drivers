/* MAC_B 1G exphy setting */
&ext_mdio_b {
	status = "disabled";
};

&ethmac_b {
	pinctrl-0 = <&eth_b_pins>, <&eth_b_rgmii_pins>;
	pinctrl-names = "default";
	status = "disabled";
	phy-mode = "rgmii";
	phy-handle = <&external_phy_b>;
	phy-mii-clk-sel = <0x3>;
	amlogic,tx-delay-ns = <2>;
	cali_val = <0x290000>;
	// wol = <1>;
	// mdns_wkup = <1>;
};

&ir {
	status = "okay";
	pinctrl-0 = <&remote_pins>;
	pinctrl-names = "default";
};

&spisg_c {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&spisg_c_pins_a>;
};

&spisg_e {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&spisg_e_pins_z>;
};

&spisg_f {
	status = "disabled";
	pinctrl-names = "default";
	pinctrl-0 = <&spisg_f_pins_z>;
};

&spifc {
	status = "disabled";
	spi-nor@0 {
		status = "disabled";
	};
};

&fb {
	status = "disabled";
	display_size_default = <1920 1080 1920 2160 32>;
	mem_size = <0x00800000 0x1980000 0x100000 0x100000>;
	logo_addr = "0x7f800000";
	mem_alloc = <0>;
	pxp_mode = <0>; /** 0:normal mode 1:pxp mode */
};

&amvideom {
	display_device_cnt = <2>;
	vpp0_layer_count = <2>;
	/* number of video layer display on vpp1 */
	vpp1_layer_count = <1>;
};

&drm_vpu {
	status = "okay";
	logo_addr = "0x7f800000";

	connectors_dev: port@1 {
		drm_to_lcd0: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&lcd0_to_drm>;
		};
		drm_to_lcd1: endpoint@2 {
			reg = <2>;
			remote-endpoint = <&lcd1_to_drm>;
		};
		drm_to_edptx0: endpoint@3 {
			reg = <3>;
			remote-endpoint = <&edptx0_to_drm>;
		};
	};
};

&drm_subsystem {
	status = "okay";
	fbdev_sizes = <1280 720 1280 1440 32>;
};

&amhdmitx {
	status = "okay";
};

&eDPTX0 {
	status = "okay";
	ports {
		port {
			#address-cells = <1>;
			#size-cells = <0>;
			edptx0_to_drm: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&drm_to_edptx0>;
			};
		};
	};
};

&lcd {
	status = "okay";
	ports {
		port {
			#address-cells = <1>;
			#size-cells = <0>;
			lcd0_to_drm: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&drm_to_lcd0>;
			};
		};
	};
};

&lcd1 {
	status = "okay";
	ports {
		port {
			lcd1_to_drm: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&drm_to_lcd1>;
			};
		};
	};
};

