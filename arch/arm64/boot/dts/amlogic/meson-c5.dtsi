	cve:mbd_cve {
		compatible = "amlogic, cve";
		reg = <0x0 0xFF561000 0x0 0x1000>;
		reg-names = "cve";
		interrupts = <GIC_SPI 218 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "cve";
		clocks = <&clkc CLKID_CVE>, <&clkc CLKID_VGE>;
		clock-names = "clk_cve", "clk_vge";
		power-domains = <&pwrdm PDID_C5_CVE>;
		status = "okay";
	};

	ge2d {
		compatible = "amlogic, mbp-ge2d-c5";
		status = "okay";
		interrupts = <GIC_SPI 217 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "ge2d";
		clocks = <&clkc CLKID_VAPB>,
			<&clkc CLKID_GE2D>,
			<&clkc CLKID_VGE>;
		clock-names = "clk_vapb_0",
			"clk_ge2d_gate",
			"cve_arb";
		reg = <0x0 0xff560000 0x0 0x1000>;
		power-domains = <&pwrdm PDID_C5_GE2D>;
	};

	amlgdc {
		#address-cells=<2>;
		#size-cells=<2>;
		status = "okay";
		compatible = "amlogic, mbp-dewarp-v2";
