	spisg_b_pins_p: spisg_b_pins_p {
		mux {
			 /* GPIOP_5/6/7/4 */
			groups = "spi1_mosi_p",
				 "spi1_miso_p",
				 "spi1_ss0_p",
				 "spi1_sclk_p";
			function = "spi1";
			drive-strength-microamp = <3000>;
		};
	};

	spisg_b_pins_b: spisg_b_pins_b {
		mux {
			 /* GPIOB_6/7/4/8/9/5 */
			groups = "spi1_mosi_b",
				 "spi1_miso_b",
				 "spi1_ss0_b",
				 "spi1_ss1_b",
				 "spi1_ss2_b",
				 "spi1_sclk_b";
			function = "spi1";
			drive-strength-microamp = <3000>;
		};
	};

	spisg_b_pins_c: spisg_b_pins_c {
		mux {
			 /* GPIOC_0/1/3/4/5/2 */
			groups = "spi1_mosi_c",
				 "spi1_miso_c",
				 "spi1_ss0_c",
				 "spi1_ss1_c",
				 "spi1_ss2_c",
				 "spi1_sclk_c";
			function = "spi1";
			drive-strength-microamp = <3000>;
		};
	};

	spisg_b_pins_d: spisg_b_pins_d {
		mux {
			 /* GPIOD_5/4/7/6 */
			groups = "spi1_mosi_d",
				 "spi1_miso_d",
				 "spi1_ss1_d",
				 "spi1_sclk_d";
			function = "spi1";
			drive-strength-microamp = <3000>;
		};
	};

	spisg_b_pins_x: spisg_b_pins_x {
		mux {
			 /* GPIOX_12/13/10/11 */
			groups = "spi1_mosi_x",
				 "spi1_miso_x",
				 "spi1_ss0_x",
				 "spi1_sclk_x";
			function = "spi1";
			drive-strength-microamp = <3000>;
		};
	};

	spisg_c_pins_d: spisg_c_pins_d {
		mux {
			 /* GPIOD_0/1/3/2 */
			groups = "spi2_mosi_d",
				 "spi2_miso_d",
				 "spi2_ss0_d",
				 "spi2_sclk_d";
			function = "spi2";
			drive-strength-microamp = <3000>;
		};
	};

	spisg_c_pins_x: spisg_c_pins_x {
		mux {
			 /* GPIOX_7/8/9/6 */
