	eth_pins: eth {
		mux {
			groups = "eth_a_mdio",
				 "eth_a_mdc",
				 "eth_a_rgmii_rx_clk",
				 "eth_a_rx_dv",
				 "eth_a_rxd0",
				 "eth_a_rxd1",
				 "eth_a_txen",
				 "eth_a_txd0",
				 "eth_a_txd1";
