	gp0_pll: pll-gp0@8200 {
		compatible = "amlogic,pll";
		reg = <0x0 0x8200 0x0 0x10>;
		pll-dco-range = <0 1400000000 0 2800000000>;  /* min_dco max_dco */
		clock-init-regs = <0x0  0x08010000 0>,  /* regoffset value delay_us */
				  <0x4  0x11480000 0>,
				  <0x8  0x1219b010 0>,
				  <0xc  0x00008010 0>;
		clock-flags = <AML_PLL_M_EN0P5 0>;
		pll-special-parms = <(AML_PLL_SPEC_PARM_FRAC | AML_PLL_SPEC_PARM_OD |
				      AML_PLL_SPEC_PARM_LOCK_DETECT)>;
		pll-max-frac = <131071>;  /* 2^17 - 1 */
		pll-max-od = <4>;
		clock-output-names = "gp0_pll";
		clocks = <&xtal>;
		#clock-cells = <0>;
	};

