		clock-reg-offsets = <0x0 11 1>,  /* regoffset shift width */
				    <0x0 10 1>,
				    <0x0 0  8>,
				    <0x0 12 1>;
		clock-indices = <CLKID_24M_IN>,
				<CLKID_12M_24M>,
				<CLKID_25M_DIV>,
				<CLKID_25M>;
		clock-parents = <&xtal>,
				<&clkc_12_24_25m CLKID_24M_IN>,
				<&scmi_clk CLKID_FIXED_PLL>,
				<&clkc_12_24_25m CLKID_25M_DIV>;
		clock-flags = <0 0>,  /* clkdata_flags clkhw_flags */
			      <0 0>,
			      <0 0>,
			      <0 CLK_SET_RATE_PARENT>;
		clocks = <&xtal>,
			 <&scmi_clk CLKID_FIXED_PLL>;
	};

