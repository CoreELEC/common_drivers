				<CLKID_MCLK_0_DIV>,
				<CLKID_MCLK_0>,
				<CLKID_MCLK_1_PRE_DIV>,
				<CLKID_MCLK_1_PRE>,
				<CLKID_MCLK_1_SEL>,
				<CLKID_MCLK_1_DIV>,
				<CLKID_MCLK_1>;
		clock-parents = <&mclk_pll>,
				<&clkc_mclk CLKID_MCLK_0_PRE_DIV>,
				<&mclk_0_parents>,
				<&clkc_mclk CLKID_MCLK_0_SEL>,
				<&clkc_mclk CLKID_MCLK_0_DIV>,
				<&mclk_pll>,
				<&clkc_mclk CLKID_MCLK_1_PRE_DIV>,
				<&mclk_1_parents>,
				<&clkc_mclk CLKID_MCLK_1_SEL>,
				<&clkc_mclk CLKID_MCLK_1_DIV>;
		clock-flags = <CLK_DIVIDER_POWER_OF_TWO 0>,
			      <CLK_DIVIDER_MAX_AT_ZERO CLK_SET_RATE_PARENT>,
			      <0 0>,
			      <CLK_DIVIDER_POWER_OF_TWO CLK_SET_RATE_PARENT>,
			      <0 CLK_SET_RATE_PARENT>,
			      <CLK_DIVIDER_POWER_OF_TWO 0>,
			      <CLK_DIVIDER_MAX_AT_ZERO CLK_SET_RATE_PARENT>,
			      <0 0>,
			      <CLK_DIVIDER_POWER_OF_TWO CLK_SET_RATE_PARENT>,
			      <0 CLK_SET_RATE_PARENT>;
		clocks = <&mclk_pll>,
			 <&xtal>,
			 <&scmi_clk CLKID_FCLK_50M>;
	};

	mclk1_pll: pll-mclk1@8344 {
		compatible = "amlogic,pll";
		reg = <0x0 0x8344 0x0 0xc>;
		pll-dco-range = <0 1400000000 0 2800000000>;  /* min_dco max_dco */
		clock-init-regs = <0x4  0x00422000 0>,  /* regoffset value delay_us */
				  <0x8  0x60000100 0>;
		clock-flags = <AML_PLL_M_EN0P5 0>;
		pll-special-parms = <AML_PLL_SPEC_PARM_LOCK_DETECT>;
		clock-output-names = "mclk1_pll";
		clocks = <&xtal>;
		#clock-cells = <0>;
	};

	clkc_mclk1: clock-mclk1@8350 {
		compatible = "amlogic,basic-clk";
		reg = <0x0 0x8350 0x0 0x8>;
		#clock-cells = <1>;
		clock-init-regs = <0x0  0x02000200 0>,  /* regoffset value delay_us */
				  <0x4  0xd616d616 0>;
		clock-output-names = "mclk1_0_pre_div",
				     "mclk1_0_pre",
				     "mclk1_0_sel",
				     "mclk1_0_div",
				     "mclk1_0",
				     "mclk1_1_pre_div",
				     "mclk1_1_pre",
				     "mclk1_1_sel",
				     "mclk1_1_div",
				     "mclk1_1";
		clock-basic-types = <AML_CLKTYPE_DIV>,
				    <AML_CLKTYPE_DIV>,
				    <AML_CLKTYPE_MUX>,
				    <AML_CLKTYPE_DIV>,
				    <AML_CLKTYPE_GATE>,
				    <AML_CLKTYPE_DIV>,
				    <AML_CLKTYPE_DIV>,
				    <AML_CLKTYPE_MUX>,
				    <AML_CLKTYPE_DIV>,
				    <AML_CLKTYPE_GATE>;
		clock-reg-offsets = <0x0 0  2>,  /* regoffset shift width */
				    <0x0 3  5>,
				    <0x0 12 3>,
				    <0x0 10 1>,
				    <0x0 8  1>,
				    <0x0 16 2>,
				    <0x0 19 5>,
				    <0x0 28 3>,
				    <0x0 26 1>,
				    <0x0 24 1>;
		clock-indices = <CLKID_MCLK1_0_PRE_DIV>,
				<CLKID_MCLK1_0_PRE>,
				<CLKID_MCLK1_0_SEL>,
				<CLKID_MCLK1_0_DIV>,
				<CLKID_MCLK1_0>,
				<CLKID_MCLK1_1_PRE_DIV>,
				<CLKID_MCLK1_1_PRE>,
				<CLKID_MCLK1_1_SEL>,
				<CLKID_MCLK1_1_DIV>,
				<CLKID_MCLK1_1>;
		clock-parents = <&mclk1_pll>,
				<&clkc_mclk1 CLKID_MCLK1_0_PRE_DIV>,
				<&mclk1_0_parents>,
				<&clkc_mclk1 CLKID_MCLK1_0_SEL>,
				<&clkc_mclk1 CLKID_MCLK1_0_DIV>,
				<&mclk1_pll>,
				<&clkc_mclk1 CLKID_MCLK1_0_PRE_DIV>,
				<&mclk1_1_parents>,
				<&clkc_mclk1 CLKID_MCLK1_1_SEL>,
				<&clkc_mclk1 CLKID_MCLK1_1_DIV>;
		clock-flags = <CLK_DIVIDER_POWER_OF_TWO 0>,
			      <CLK_DIVIDER_MAX_AT_ZERO CLK_SET_RATE_PARENT>,
			      <0 0>,
			      <CLK_DIVIDER_POWER_OF_TWO CLK_SET_RATE_PARENT>,
			      <0 CLK_SET_RATE_PARENT>,
			      <CLK_DIVIDER_POWER_OF_TWO 0>,
			      <CLK_DIVIDER_MAX_AT_ZERO CLK_SET_RATE_PARENT>,
			      <0 0>,
			      <CLK_DIVIDER_POWER_OF_TWO CLK_SET_RATE_PARENT>,
			      <0 CLK_SET_RATE_PARENT>;
		clocks = <&mclk1_pll>,
			 <&xtal>,
			 <&scmi_clk CLKID_FCLK_50M>;
	};
};

&aobus {
	clkc_ao_cecb: clock-ao_cecb@38 {
		compatible = "amlogic,dualdiv-mux-clk";
		reg = <0x0 0x38 0x0 0x8>;
		#clock-cells = <1>;
		clock-output-names = "ao_cecb_dualdiv",
				     "ao_cecb_clk";
		clock-indices = <CLKID_AO_CECB_DUAL>,
				<CLKID_AO_CECB_CLK>;
		clock-dualdiv-tables = <1 732 7 731 10>;  /* div_mode n0 m0 n1 m1 */
		clock-parents = <&xtal>,
				<&cecb_parents>;
		clocks = <&xtal>,
			 <&clkc_ao_rtc CLKID_AO_RTC_CLK>;
	};

	clkc_ao_pwm: clock-ao_pwm@1c {
		compatible = "amlogic,general-clk";
		reg = <0x0 0x1c 0x0 0x1c>;
		#clock-cells = <1>;
		clock-output-names = "ao_pwm_a",
				     "ao_pwm_b",
				     "ao_pwm_c",
				     "ao_pwm_d",
				     "ao_pwm_e",
				     "ao_pwm_f",
				     "ao_pwm_g";
		clock-reg-offsets = <0x0 0>,
				    <0x4 0>,
				    <0x8 0>,
				    <0xc 0>,
				    <0x10 0>,
				    <0x14 0>,
				    <0x18 0>;
		clock-indices = <CLKID_AO_PWM_A>,
				<CLKID_AO_PWM_B>,
				<CLKID_AO_PWM_C>,
				<CLKID_AO_PWM_D>,
				<CLKID_AO_PWM_E>,
				<CLKID_AO_PWM_F>,
				<CLKID_AO_PWM_G>;
		clock-parents = <&pwm_parents>;
		clocks = <&xtal>,
			 <&scmi_clk CLKID_FCLK_DIV5>,
			 <&scmi_clk CLKID_FCLK_DIV4>,
			 <&scmi_clk CLKID_FCLK_DIV3>;
	};

	clkc_sys_ao: clock-sys-ao@4 {
		compatible = "amlogic,basic-clk";
		reg = <0x0 0x4 0x0 0x4>;
		#clock-cells = <1>;
		clock-output-names = "ao_sys_i3c",
				     "ao_sys_rtc_reg",
				     "ao_sys_clk_tree",
				     "ao_sys_rst_ctrl",
				     "ao_sys_pad",
				     "ao_sys_rtc_dig",
				     "ao_sys_irq",
				     "ao_sys_pwr_ctrl",
				     "ao_sys_pwm_a",
				     "ao_sys_pwm_b",
				     "ao_sys_pwm_c",
				     "ao_sys_pwm_d",
				     "ao_sys_pwm_e",
				     "ao_sys_pwm_f",
				     "ao_sys_pwm_g",
				     "ao_sys_i2c_m_a",
				     "ao_sys_i2c_m_b",
				     "ao_sys_i2c_m_c",
				     "ao_sys_i2c_m_d",
				     "ao_sys_sed",
				     "ao_sys_ir_ctrl",
				     "ao_sys_uart_b",
				     "ao_sys_uart_c",
				     "ao_sys_uart_d",
				     "ao_sys_uart_e",
				     "ao_sys_spisg_0",
				     "ao_sys_rtc_sec",
				     "ao_sys_cec",
				     "ao_sys_aocpu",
				     "ao_sys_sram",
				     "ao_sys_spisg_1",
				     "ao_sys_spisg_2";
		clock-basic-types = <AML_CLKTYPE_GATE>;
		clock-reg-offsets = <0x0 0  1>,  /* regoffset shift width */
				    <0x0 1  1>,
				    <0x0 2  1>,
				    <0x0 3  1>,
				    <0x0 4  1>,
				    <0x0 5  1>,
				    <0x0 6  1>,
				    <0x0 7  1>,
				    <0x0 8  1>,
				    <0x0 9  1>,
				    <0x0 10 1>,
				    <0x0 11 1>,
				    <0x0 12 1>,
				    <0x0 13 1>,
				    <0x0 14 1>,
				    <0x0 15 1>,
				    <0x0 16 1>,
				    <0x0 17 1>,
				    <0x0 18 1>,
				    <0x0 19 1>,
				    <0x0 19 1>,
				    <0x0 21 1>,
				    <0x0 22 1>,
				    <0x0 23 1>,
				    <0x0 24 1>,
				    <0x0 25 1>,
				    <0x0 26 1>,
				    <0x0 27 1>,
				    <0x0 28 1>,
				    <0x0 29 1>,
				    <0x0 30 1>,
				    <0x0 31 1>;
		clock-indices = <CLKID_AO_SYS_I3C>,
				<CLKID_AO_SYS_RTC_REG>,
				<CLKID_AO_SYS_CLK_TREE>,
				<CLKID_AO_SYS_RST_CTRL>,
				<CLKID_AO_SYS_PAD>,
				<CLKID_AO_SYS_RTC_DIG>,
				<CLKID_AO_SYS_IRQ>,
				<CLKID_AO_SYS_PWR_CTRL>,
				<CLKID_AO_SYS_PWM_A>,
				<CLKID_AO_SYS_PWM_B>,
				<CLKID_AO_SYS_PWM_C>,
				<CLKID_AO_SYS_PWM_D>,
				<CLKID_AO_SYS_PWM_E>,
				<CLKID_AO_SYS_PWM_F>,
				<CLKID_AO_SYS_PWM_G>,
				<CLKID_AO_SYS_I2C_M_A>,
				<CLKID_AO_SYS_I2C_M_B>,
				<CLKID_AO_SYS_I2C_M_C>,
				<CLKID_AO_SYS_I2C_M_D>,
				<CLKID_AO_SYS_SED>,
				<CLKID_AO_SYS_IR_CTRL>,
				<CLKID_AO_SYS_UART_B>,
				<CLKID_AO_SYS_UART_C>,
				<CLKID_AO_SYS_UART_D>,
				<CLKID_AO_SYS_UART_E>,
				<CLKID_AO_SYS_SPISG_0>,
				<CLKID_AO_SYS_RTC_SEC>,
				<CLKID_AO_SYS_CEC>,
				<CLKID_AO_SYS_AOCPU>,
				<CLKID_AO_SYS_SRAM>,
				<CLKID_AO_SYS_SPISG_1>,
				<CLKID_AO_SYS_SPISG_2>;
		clocks = <&scmi_clk CLKID_SYS_CLK>;
	};

	clkc_rtc: clock-rtc@8014c {
		compatible = "amlogic,dualdiv-mux-clk";
		reg = <0x0 0x8014c 0x0 0x8>;
		#clock-cells = <1>;
		clock-output-names = "rtc_dualdiv",
				     "rtc_clk";
		clock-indices = <CLKID_RTC_DUAL>,
				<CLKID_RTC_CLK>;
		clock-dualdiv-tables = <1 732 7 731 10>;  /* div_mode n0 m0 n1 m1 */
		clock-parents = <&xtal>,
				<&rtc_parents>;
		clocks = <&xtal>;
	};

	clkc_ao_rtc: clock-ao-rtc@50 {
		compatible = "amlogic,dualdiv-mux-clk";
		reg = <0x0 0x50 0x0 0x8>;
		#clock-cells = <1>;
		clock-output-names = "ao_rtc_dualdiv",
				     "ao_rtc_clk";
		clock-indices = <CLKID_AO_RTC_DUAL>,
				<CLKID_AO_RTC_CLK>;
		clock-dualdiv-tables = <1 732 7 731 10>;  /* div_mode n0 m0 n1 m1 */
		clock-parents = <&xtal>,
				<&ao_rtc_parents>;
		clocks = <&xtal>;
	};
};
