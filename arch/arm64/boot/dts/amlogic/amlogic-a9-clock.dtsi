				<&scmi_clk CLKID_FCLK_DIV7>,
				<&hifi_pll>,
				<&scmi_clk CLKID_GP1_PLL>,
				<&xtal>;
		#clock-cells = <0>;
	};

	hcodec_parents: hcodec_parents {
