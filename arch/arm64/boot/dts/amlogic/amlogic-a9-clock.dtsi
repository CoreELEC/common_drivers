				//<&vid1_pll>,
				<&scmi_clk CLKID_FCLK_DIV2>,
				//<&vid_pll>,
				//<&vid2_pll>,
				<&scmi_clk CLKID_GP1_PLL>;
		clock-parent-indices = <0>,
				       <1>,
				       <2>,
				//       <3>,
				       <4>,
				//       <5>,
				//       <6>,
				       <7>;
		#clock-cells = <0>;
	};

	vpu_clkb_parents: vpu_clkb_parents {
