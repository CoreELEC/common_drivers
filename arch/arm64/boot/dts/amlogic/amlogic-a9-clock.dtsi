#include "aml-clock-func.h"

/ {
	clk_eth_125m_div: clock-eth_125m_div {
		compatible = "fixed-factor-clock";
		clock-div = <8>;
		clock-mult = <1>;
		clock-output-names = "eth_125m_div";
		clocks = <&scmi_clk CLKID_FCLK_DIV2>;
		#clock-cells = <0>;
	};

	rtc_parents: rtc_parents {
		clock-mult-parents;
		clock-parents = <&xtal>,
				<&clkc_rtc CLKID_RTC_DUAL>;
		#clock-cells = <0>;
	};

	sar_adc_parents: sar_adc_parents {
		clock-mult-parents;
		clock-parents = <&xtal>,
				<&scmi_clk CLKID_SYS_CLK>;
		#clock-cells = <0>;
	};

	sc_parents: sc_parents {
		clock-mult-parents;
		clock-parents = <&scmi_clk CLKID_FCLK_DIV2>,
				<&scmi_clk CLKID_FCLK_DIV3>,
				<&scmi_clk CLKID_FCLK_DIV5>,
				<&xtal>;
		#clock-cells = <0>;
	};

	mali_parents: mali_parents {
		clock-mult-parents;
		clock-parents = <&xtal>,
				<&scmi_clk CLKID_GP1_PLL>,
				<&scmi_clk CLKID_FCLK_DIV2>,
				<&scmi_clk CLKID_FCLK_DIV2P5>,
				<&scmi_clk CLKID_FCLK_DIV3>,
				<&scmi_clk CLKID_FCLK_DIV4>,
				<&scmi_clk CLKID_FCLK_DIV5>,
				<&scmi_clk CLKID_FCLK_DIV7>;
		#clock-cells = <0>;
	};

	hevcf_parents: hevcf_parents {
