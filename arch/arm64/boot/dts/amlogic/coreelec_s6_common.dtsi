#include "coreelec_common.dtsi"

/ {
	compatible = "amlogic, s6";

	amhdmitx: amhdmitx{
		vend_data: vend_data { /* Should modified by Customer */
			product_desc = "S6"; /* Max Chars: 16 */
		};
	};

	reserved-memory {
		// for 4k fb
		dmaheap_fb_reserved:heap-fb {
			size = <0x0 0xE000000>;
		};

		pcie_dma_ops_mm:linux,pcie_dma_ops {
			size = <0x0 0x5000000>;
		};
	};

	bl30_manager {
		mboxes = <&mbox_fifo S6_REE2AO_DEV>;
	};

	mbox_devfs {
		status = "disabled";
	};

	amvdec_csi {
		status = "disabled";
	};

	gpu:valhall {
		compatible = "arm,mali-valhall-csf";
	};

	/delete-node/ auge_sound;
	auge_sound {
		compatible = "amlogic, auge-sound-card";
		aml-audio-card,name = "AML-AUGESOUND";

		avout_mute-gpios = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;

		aml-audio-card,dai-link@0 {
			mclk-fs = <128>;
			continuous-clock;
			cpu {
				system-clock-frequency = <6144000>;
				sound-dai = <&spdifb>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};

		aml-audio-card,dai-link@1 {
			format = "i2s";
			mclk-fs = <256>;
			bitclock-master = <&tdmc>;
			frame-master = <&tdmc>;
			cpu {
				dai-tdm-slot-tx-mask = <1 1>;
				dai-tdm-slot-rx-mask = <1 1>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
				system-clock-frequency = <12288000>;
				sound-dai = <&tdmc>;
			};
			codec {
				sound-dai = <&amlogic_codec>;
			};
		};

		aml-audio-card,dai-link@2 {
			mclk-fs = <128>;
			continuous-clock;
			cpu {
				system-clock-frequency = <6144000>;
				sound-dai = <&spdifa>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};

		aml-audio-card,dai-link@3 {
			format = "i2s";
			mclk-fs = <256>;
			bitclock-master = <&aml_i2s2hdmi>;
			frame-master = <&aml_i2s2hdmi>;
			cpu {
				sound-dai = <&aml_i2s2hdmi>;
				dai-tdm-slot-tx-mask = <1 1>;
				dai-tdm-slot-rx-mask = <1 1>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
				system-clock-frequency = <12288000>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};
	};

	meson-ir {
		/* Multi-format IR controller */
		reg = <0x0 0xfe084080 0x0 0xA4>;
		interrupts = <GIC_SPI 80 IRQ_TYPE_EDGE_RISING>;
	};

	meson-remote {
		reg = <0x0 0xfe084080 0x0 0xA4>, /*Multi-format IR controller*/
		      <0x0 0xfe084000 0x0 0x58>; /*Legacy IR controller*/
		interrupts = <GIC_SPI 80 IRQ_TYPE_EDGE_RISING>;
	};

	drm_vpu: drm-vpu@0xff900000  {
		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>,
				<GIC_SPI 194 IRQ_TYPE_EDGE_RISING>;
	};

	aml_watermark {
		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>; //=viu-vsync
	};

	soc {
		apb4: apb4@fe000000 {
			i2c0: i2c@66000 {
				interrupts = <GIC_SPI 160 IRQ_TYPE_EDGE_RISING>;
			};

			i2c1: i2c@66400 {
				interrupts = <GIC_SPI 161 IRQ_TYPE_EDGE_RISING>;
			};

			i2c2: i2c@66800 {
				interrupts = <GIC_SPI 162 IRQ_TYPE_EDGE_RISING>;
			};

			i2c3: i2c@66c00 {
				interrupts = <GIC_SPI 163 IRQ_TYPE_EDGE_RISING>;
			};

			i2c4: i2c@67000 {
				interrupts = <GIC_SPI 164 IRQ_TYPE_EDGE_RISING>;
			};

			i2c5: i2c@67400 {
				interrupts = <GIC_SPI 165 IRQ_TYPE_EDGE_RISING>;
			};
		};
	};

	vdec {
		interrupts = <0 3 1
			0 23 1
			0 32 1
			0 91 1
			0 92 1
			0 93 1
			0 72 1>;
	};

	amhdmitx: amhdmitx{
		interrupts = <GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH
			GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
	};

	rdma {
		interrupts = <GIC_SPI 215 IRQ_TYPE_EDGE_RISING>;
	};

	multi-di {
		interrupts = <0 203 1
				0 202 1>;
	};

	meson-amvideom {
		interrupts = <GIC_SPI 197 IRQ_TYPE_EDGE_RISING>;
	};

	ge2d {
		interrupts = <GIC_SPI 217 IRQ_TYPE_EDGE_RISING>;
	};

	amlgdc {
		interrupts = <GIC_SPI 147 IRQ_TYPE_EDGE_RISING>;
	};
};

&audiobus {
	/delete-node/ tdm@1;
	/delete-node/ resample@0;
	/delete-node/ resample@1;
	/delete-node/ loopback@0;
	/delete-node/ loopback@1;
	/delete-node/ extn;
	/delete-node/ effect;
	/delete-node/ vad;

	aml_i2s2hdmi: i2s2hdmi {
		compatible = "amlogic, tm2-revb-snd-tdmb";
		dai-tdm-lane-slot-mask-in = <1 1 1 1>;
		dai-tdm-lane-slot-mask-out = <1 1 1 1>;
		dai-tdm-clk-sel = <1>;
		clocks = <&clkaudio CLKID_AUDIO_MCLK_B
				&clkc CLKID_HIFI_PLL
				&clkc CLKID_HIFI1_PLL>;
		clock-names = "mclk", "clk_srcpll", "clk_src_cd";
		i2s2hdmi = <1>;
	};
};

&ext_mdio {
	/delete-node/ ethernet-phy@0;
	external_phy: ethernet_phy@0 {
		/delete-property/ reg;
	};
};

&drm_amhdmitx {
	status = "okay";
};

&i2c0 {
	/delete-node/ sy602x_54@2a;
	/delete-node/ aw9523_led@5b;
};

&i2c5 {
	/delete-node/ sensor0@1a;
};

&apb4 {
	watchdog@2100 {
		amlogic,feed_watchdog_mode = <0>;
	};
};

&aml_wifi {
	status = "okay";
	wifi_static_buf = <2>;  /* dhd wifi for android */
};
