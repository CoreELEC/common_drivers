#include "coreelec_common.dtsi"
#include "coreelec_g12b_cache.dtsi"

/ {
	compatible = "amlogic, g12b";

	/delete-node/ ir@ff808040;
	/delete-node/ optee;

	/delete-node/ cpufreq-meson;

	meson-cpufreq {
		compatible = "amlogic, aml-cpufreq";
		status = "okay";

		cluster0-cpu-supply = <&vddcpu0>;
		cluster1-cpu-supply = <&vddcpu1>;

		cluster0 {
			clocks = <&clkc CLKID_CPU_CLK>;
			clock-names = "cpuclk";
			voltage-tolerance = <0>;
			transition_delay_us = <10000>;
			cluster_cores = <0 1>;
		};

		cluster1 {
			clocks = <&clkc CLKID_CPUB_CLK>;
			clock-names = "cpuclk";
			voltage-tolerance = <0>;
			transition_delay_us = <10000>;
			cluster_cores = <2 3 4 5>;
		};
	};

	reserved-memory {
		galcore_reserved:linux,galcore {
			size = <0x0 0x1000000>;
		};
	};

	cpu_opp_table0: cpu_opp_table0 {
		opp08 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <1020000>;
		};
	};

	cpu_opp_table1: cpu_opp_table1 {
		opp02 {
			opp-microvolt = <820000>;
		};
		opp03 {
			opp-microvolt = <820000>;
		};
		opp08 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <830000>;
		};
		opp09 {
			opp-hz = /bits/ 64 <1908000000>;
			opp-microvolt = <860000>;
		};
		opp10 {
			opp-hz = /bits/ 64 <2016000000>;
			opp-microvolt = <910000>;
		};
		opp11 {
			opp-hz = /bits/ 64 <2100000000>;
			opp-microvolt = <960000>;
		};
		opp12 {
			opp-hz = /bits/ 64 <2208000000>;
			opp-microvolt = <1030000>;
		};
	};

	aml_wifi {
		status = "okay";
		/delete-property/ pwm_config;

		pwm_channel1_conf {
			pwms = <&pwm_ef MESON_PWM_0 30541 0>;
			duty-cycle = <15270>;
			times = <10>;
		};
		pwm_channel2_conf {
			pwms = <&pwm_ef MESON_PWM_2 30500 0>;
			duty-cycle = <15250>;
			times = <12>;
		};
	};

	amhdmitx: amhdmitx{
		status = "okay";
		hdmitx-gpios-hpd = <&gpio GPIOH_2 0>;
		hdmitx-gpios-scl = <&gpio GPIOH_1 0>;
		hdmitx-gpios-sda = <&gpio GPIOH_0 0>;
		vend_data: vend_data{ /* Should modified by Customer */
			product_desc = "G12B"; /* Max Chars: 16 */
		};
	};

	drm_vpu: drm-vpu@900000  {
		osd_ver = /bits/ 8 <OSD_V3>;
	};

	multi-di {
		compatible = "amlogic, dim-g12b";
	};

	bl30_manager {
		mboxes = <&mbox_pl G12B_REE2AO_DEV>;
	};

	meson-ir {
		reg = <0x0 0xff808040 0x00 0x44>, /*Multi-format IR controller*/
			<0x0 0xff808000 0x00 0x20>; /*Legacy IR controller*/
		interrupts = <GIC_SPI 196 IRQ_TYPE_EDGE_RISING>;
	};

	meson-remote {
		reg = <0x0 0xff808040 0x00 0x44>, /*Multi-format IR controller*/
			<0x0 0xff808000 0x00 0x20>; /*Legacy IR controller*/
		interrupts = <GIC_SPI 196 IRQ_TYPE_EDGE_RISING>;
	};

	gpu:bifrost {
		compatible = "arm,mali-bifrost";
	};

	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio BOOT_12 GPIO_ACTIVE_LOW>;
	};

	/* the legacy usb2/usb3 v2 phy drivers are no longer registered */
	usbphy0: usbphy0@ffe09000 {
		compatible = "amlogic,uphy-sm1";
		#address-cells = <1>;
		#size-cells = <1>;
		status = "okay";

		u2p0port0: u2p@0 {
			#phy-cells = <0>;
			port-speed = <0x0>;
			reg = <0xffe09000 0x20
					0xffd01008 0x100
					0x0 0x0
					0xff636000 0x60>;
			reset-level = <0x84>;
			phy-reset-level-bits = <16>;
			usb-reset-bit = <2>;
			pll-settings = <0x09400414
							0x927E0000
							0xac5f69e5
							0xfe18
							0x8000fff
							0x78000
							0xe0004
							0xe000c>;
			version = <2>;
		};

		u2p0port1: u2p@20 {
			#phy-cells = <0>;
			port-speed = <0x0>;
			reg = <0xffe09020 0x20
					0xffd01008 0x100
					0x0 0x0
					0xff63a000 0x60
					0xffe09080 0x20>;
			reset-level = <0x84>;
			phy-reset-level-bits = <17>;
			usb-reset-bit = <2>;
			pll-settings = <0x09400414
							0x927E0000
							0xac5f69e5
							0xfe18
							0x8000fff
							0x78000
							0xe0004
							0xe000c>;
			version = <2>;
			gpio-vbus-power = "GPIOH_6";
			gpios = <&gpio GPIOH_6 GPIO_ACTIVE_HIGH>;
			phy-otg;
			otg-type = <0>;
			iddig-type = <1>;
			controller-type = <3>;
			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
		};

		u3p0port0: u3p@80 {
			#phy-cells = <0>;
			port-speed = <0x3>;
			reg = <0xffe09080 0x20
					0xff646000 0x2000>;
			clocks = <&clkc CLKID_PCIE_PLL>;
			clock-names = "pcie_refpll";
		};
	};

	/delete-node/ auge_sound;
	auge_sound {
		compatible = "amlogic, auge-sound-card";
		aml-audio-card,name = "AML-AUGESOUND";

		/*avout mute gpio*/
		avout_mute-gpios = <&gpio_ao GPIOAO_2 GPIO_ACTIVE_HIGH>;

		aml-audio-card,dai-link@0 {
			mclk-fs = <128>;
			continuous-clock;
			cpu {
				system-clock-frequency = <6144000>;
				sound-dai = <&aml_spdif_b>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};

		aml-audio-card,dai-link@1 {
			format = "i2s";
			mclk-fs = <256>;
			bitclock-master = <&aml_tdmb>;
			frame-master = <&aml_tdmb>;
			continuous-clock;
			cpu {
				dai-tdm-slot-tx-mask = <1 1>;
				dai-tdm-slot-rx-mask = <1 1>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
				system-clock-frequency = <12288000>;
				sound-dai = <&aml_tdmb>;
			};
			codec {
				sound-dai = <&amlogic_codec>;
			};
		};

		aml-audio-card,dai-link@2 {
			mclk-fs = <128>;
			continuous-clock;
			cpu {
				system-clock-frequency = <6144000>;
				sound-dai = <&aml_spdif>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};

		aml-audio-card,dai-link@3 {
			format = "i2s";
			mclk-fs = <256>;
			bitclock-master = <&aml_i2s2hdmi>;
			frame-master = <&aml_i2s2hdmi>;
			continuous-clock;
			cpu {
				sound-dai = <&aml_i2s2hdmi>;
				dai-tdm-slot-tx-mask = <1 1>;
				dai-tdm-slot-rx-mask = <1 1>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
				system-clock-frequency = <12288000>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};
	};

	gpio_keypad {
		key_num = <1>;
		key_name = "power";
		key_code = <116>;
	};

	soc {
		demux: demux {
			compatible = "amlogic, dmx";
			status = "disabled";

			interrupts = <GIC_SPI 23 IRQ_TYPE_EDGE_RISING
				GIC_SPI 5 IRQ_TYPE_EDGE_RISING
				GIC_SPI 21 IRQ_TYPE_EDGE_RISING
				GIC_SPI 19 IRQ_TYPE_EDGE_RISING
				GIC_SPI 25 IRQ_TYPE_EDGE_RISING>;
			interrupt-names = "demux0_irq",
				"demux1_irq",
				"demux2_irq",
				"dvr0_irq",
				"dvr1_irq";
		};
	};

	dvb-demux {
		compatible = "amlogic, dvb-demux";
		dev_name = "dvb-demux";
		status = "disabled";
		dmx =<&demux>;

		ts1 = "parallel";
		ts1_control = <0x00>;
		ts1_invert = <0x00>;
		pinctrl-names = "p_ts1";
		pinctrl-0 = <&dvb_p_ts1_pins>;
	};
};

&aocec {
	ee_cec; /*use cec a or b*/
	cec_sel = <1>;/*1:use one ip, 2:use 2 ip*/
	port_num = <4>;
};

&lcd {
	status = "disabled";
};

&vdin0 {
	status = "disabled";
};

&vdin1 {
	status = "disabled";
};

&pinctrl_periphs {
	/delete-node/ spdifin;

	dvb_p_ts1_pins: dvb_p_ts1_pins {
		tsin_b {
			groups = "tsin_b_sop_z",
			"tsin_b_valid_z",
			"tsin_b_clk_z",
			"tsin_b_din0_z",
			"tsin_b_din1",
			"tsin_b_din2",
			"tsin_b_din3",
			"tsin_b_din4",
			"tsin_b_din5",
			"tsin_b_din6",
			"tsin_b_din7";
			function = "tsin_b";
		};
	};
};

&audiobus {
	/delete-node/ tdm@1;
	/delete-node/ tdmc;
	/delete-node/ tdm@2;
	/delete-node/ spdif@0;
	/delete-node/ spdif@1;

	aml_i2s2hdmi: i2s2hdmi {
		compatible = "amlogic, g12a-snd-tdmc";
		clocks = <&clkaudio CLKID_AUDIO_MCLK_C
				 &clkc CLKID_MPLL2>;
		clock-names = "mclk", "clk_srcpll";
	};

	aml_tdmb: tdmb {
		suspend-clk-off = <0>;
	};

	aml_spdif: spdif {
		pinctrl-0 = <&spdifout>;
		suspend-clk-off = <0>;
	};

	aml_spdif_b: spdif_b {
		suspend-clk-off = <0>;
	};
};

&i2c0 {
	status = "disabled";
};

&i2c3 {
	/delete-node/ ad82584f_62@31;
	/delete-node/ tlv320adc3101_32@19;
};

&usb2_phy_v2 {
	status = "disabled";
};

&usb3_phy_v2 {
	status = "disabled";
};

&dwc3 {
	/delete-property/ usb-phy;
	phys = <&u2p0port0>, <&u2p0port1>, <&u3p0port0>;
	phy-names = "usb2-0", "usb2-1", "usb3-phy";
};

&dwc2_a {
	use-gphy;
	phys = <&u2p0port1>;
};

&ext_mdio {
	external_phy: ethernet-phy@0 {
		max-speed = <1000>;
	};
};

&ethmac {
	pinctrl-0 = <&external_eth_pins>;
	pinctrl-names = "default";
	status = "okay";
	phy-mode = "rgmii";
	phy-handle = <&external_phy>;
	internal_phy = <0>;
	amlogic,tx-delay-ns = <2>;
};

&sd_emmc_c {
	mmc-pwrseq = <&emmc_pwrseq>;
};

&sd_emmc_b {
	max-frequency = <50000000>;
	cap-mmc-highspeed;
	/delete-property/ sd-uhs-sdr12;
	/delete-property/ sd-uhs-sdr25;
	/delete-property/ sd-uhs-sdr50;
	/delete-property/ sd-uhs-sdr104;
};

&sd_emmc_a {
	/delete-property/ sd-uhs-sdr104;
};

&vddio_c {
	/delete-property/ gpio;
};
