};

&drm_vpu {
	status = "okay";
	logo_addr = "0x7f800000";
	assigned-clock-rates = <250000000>;

	connectors_dev: port@1 {
		drm_to_lcd0: endpoint@2 {
			reg = <2>;
			remote-endpoint = <&lcd0_to_drm>;
		};
	};
};

&lcd {
	ports {
		port {
			#address-cells = <1>;
			#size-cells = <0>;
