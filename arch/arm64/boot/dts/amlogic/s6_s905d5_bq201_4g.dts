				reg = <0>;
				remote-endpoint = <&drm_to_lcd0>;
			};
		};
	};
};

&drm_subsystem {
	status = "okay";
	crtc_max_out_size = <1 0>; /** 0:1080p fb 1:4k fb */
	vpu_block_select = <&vpu_blocks_viu2>;
	gfcd_enable = /bits/ 8  <0>;
	crtc_masks = <3 3 1>; /*for encoder: 0:hdmi 1:lcd 2:cvbs*/
