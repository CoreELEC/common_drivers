	status = "okay";
	uart-has-rtscts;
};

&amlogic_codec {
	tocodec_inout = <1>;
	tdmout_index = <1>;
};

&pdma {
	/*on the board use sd card*/
	//pinctrl-names = "pdm_pins";
	//pinctrl-0 = <&pdminc_pins>;
};

&tdmc {
	clocks = <&clkaudio CLKID_AUDIO_MCLK_C
				&clkc CLKID_HIFI_PLL
				&clkc CLKID_HIFI1_PLL
				&clkaudio CLKID_AUDIO_MCLK_PAD1>;
	clock-names = "mclk", "clk_srcpll", "clk_src_cd", "mclk_pad";
	pinctrl-names = "tdm_pins";
	pinctrl-0 = <&i2s_gpio_a_pins_1
		&tdm_d4_pins
		&tdm_d5_pins
		&tdmc_clk_pins
		&mclk2_pins>;
};

&spdifa {
		pinctrl-names = "spdif_pins", "spdif_pins_mute";
		pinctrl-0 = <&spdif_out_a_h4_pins>;
		pinctrl-1 = <&spdif_out_a_h4_mute_pins>;
};

&pinctrl_audio {
	tdm_d4_pins: tdm_d4_pin {
		mux {
			groups = "tdm_d2";
			function = "tdmoutc_lane0";
		};
	};

	tdm_d5_pins: tdm_d5_pin {
		mux {
			groups = "tdm_d2";
			function = "tdmoutc_lane1";
		};
	};

	tdmc_clk_pins: tdmc_clk_pin {
		mux {
			groups = "tdm_sclk2", "tdm_lrclk2";
			function = "tdm_clk_outc";
		};
	};
};

&periphs_pinctrl {
	i2s_gpio_a_pins_1: i2s_gpio_a_1 {
		mux { /* GPIOA_6 GPIOA_7 GPIOA_2 GPIOA_3 */
			groups = "tdm_fs2_a",
				"tdm_sclk2_a",
				"tdm_d4_a",
				"tdm_d5_a";
			function = "tdm";
		};
	};

	mclk2_pins: mclk_2 {
		mux { /* GPIOA_8 */
			groups = "mclk_2_a";
			function = "mclk";
		};
	};
};

&amlvecm {
	compatible = "amlogic, vecm-s6";
	dev_name = "aml_vecm";
	status = "okay";
	gamma_en = <0>;/*1:enable ;0:disable*/
	wb_en = <0>;/*1:enable ;0:disable*/
	/*0: 709/601  1: bt2020*/
	tx_op_color_primary = <0>;
};
