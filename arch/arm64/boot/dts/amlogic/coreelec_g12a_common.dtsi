#include "coreelec_common.dtsi"

/ {
	/delete-node/ optee;

	/delete-node/ cpufreq-meson;

	meson-cpufreq {
		compatible = "amlogic, aml-cpufreq";
		status = "okay";

		cluster0-cpu-supply = <&vddcpu0>;

		cluster0 {
			clocks = <&clkc CLKID_CPU_CLK>;
			clock-names = "cpuclk";
			voltage-tolerance = <0>;
			transition_delay_us = <10000>;
			cluster_cores = <0 1 2 3>;
		};
	};

	amhdmitx: amhdmitx{
		status = "okay";
		hdmitx-gpios-hpd = <&gpio GPIOH_2 0>;
		hdmitx-gpios-scl = <&gpio GPIOH_1 0>;
		hdmitx-gpios-sda = <&gpio GPIOH_0 0>;
		vend_data: vend_data{ /* Should modified by Customer */
			product_desc = "G12A"; /* Max Chars: 16 */
		};
	};

	secmon {
		clear_range = <0x05100000 0x02a00000>;
	};

	gpioleds {
		/delete-node/ net_red;
		/delete-node/ net_green;
		/delete-node/ remote_led;
	};

	meson-ir {
		reg = <0x0 0xff808040 0x00 0x44>, /*Multi-format IR controller*/
			<0x0 0xff808000 0x00 0x20>; /*Legacy IR controller*/
		interrupts = <GIC_SPI 196 IRQ_TYPE_EDGE_RISING>;
	};

	meson-remote {
		reg = <0x0 0xff808040 0x00 0x44>, /*Multi-format IR controller*/
			<0x0 0xff808000 0x00 0x20>; /*Legacy IR controller*/
		interrupts = <GIC_SPI 196 IRQ_TYPE_EDGE_RISING>;
	};

	gpu:bifrost {
		compatible = "arm,mali-bifrost";
	};

	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio BOOT_12 GPIO_ACTIVE_LOW>;
	};

	/delete-node/ auge_sound;
	auge_sound {
		compatible = "amlogic, auge-sound-card";
		aml-audio-card,name = "AML-AUGESOUND";

		/*avout mute gpio*/
		avout_mute-gpios = <&gpio_ao GPIOAO_2 GPIO_ACTIVE_HIGH>;

		aml-audio-card,dai-link@0 {
			mclk-fs = <128>;
			continuous-clock;
			cpu {
				system-clock-frequency = <6144000>;
				sound-dai = <&aml_spdif_b>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};

		aml-audio-card,dai-link@1 {
			format = "i2s";
			mclk-fs = <256>;
			bitclock-master = <&aml_tdmb>;
			frame-master = <&aml_tdmb>;
			continuous-clock;
			cpu {
				dai-tdm-slot-tx-mask = <1 1>;
				dai-tdm-slot-rx-mask = <1 1>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
				system-clock-frequency = <12288000>;
				sound-dai = <&aml_tdmb>;
			};
			codec {
				sound-dai = <&amlogic_codec>;
			};
		};

		aml-audio-card,dai-link@2 {
			mclk-fs = <128>;
			continuous-clock;
			cpu {
				system-clock-frequency = <6144000>;
				sound-dai = <&aml_spdif>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};

		aml-audio-card,dai-link@3 {
			format = "i2s";
			mclk-fs = <256>;
			bitclock-master = <&aml_i2s2hdmi>;
			frame-master = <&aml_i2s2hdmi>;
			continuous-clock;
			cpu {
				sound-dai = <&aml_i2s2hdmi>;
				dai-tdm-slot-tx-mask = <1 1>;
				dai-tdm-slot-rx-mask = <1 1>;
				dai-tdm-slot-num = <2>;
				dai-tdm-slot-width = <32>;
				system-clock-frequency = <12288000>;
			};
			codec {
				sound-dai = <&dummy_codec>;
			};
		};
	};
};

&audiobus {
	/delete-node/ tdmc;
	/delete-node/ tdm@2;

	aml_i2s2hdmi: i2s2hdmi {
		compatible = "amlogic, g12a-snd-tdmc";
		clocks = <&clkaudio CLKID_AUDIO_MCLK_C
				 &clkc CLKID_MPLL2>;
		clock-names = "mclk", "clk_srcpll";
	};

	aml_tdmb: tdmb {
		/delete-property/ start_clk_enable;
		/delete-property/ clk_tuning_enable;
	};
};

&sd_emmc_c {
	compatible = "amlogic,meson-axg-mmc";
	mmc-pwrseq = <&emmc_pwrseq>;
};

&sd_emmc_b2 {
	status = "disabled";
};

/ {
	/* the time-sharing meson-g12a-mmc driver is gone, use one controller per function */
	sd_emmc_b: sd@ffe05000 {
		status = "okay";
		compatible = "amlogic,meson-axg-mmc";
		reg = <0x0 0xffe05000 0x0 0x800>,
			<0x0 0xffe05000 0x0 0x800>,
			<0x0 0xffe05000 0x0 0x800>;
		interrupts = <GIC_SPI 190 IRQ_TYPE_EDGE_RISING>;
		clocks = <&clkc CLKID_SD_EMMC_B>,
			<&clkc CLKID_SD_EMMC_B_CLK0_SEL>,
			<&clkc CLKID_SD_EMMC_B_CLK0>,
			<&xtal>,
			<&clkc CLKID_FCLK_DIV2>,
			<&clkc CLKID_FCLK_DIV2>;
		clock-names = "core", "mux0", "mux1", "clkin0", "clkin1";
		card_type = <5>;
		mmc_debug_flag;
		pinctrl-0 = <&sdcard_pins>;
		pinctrl-1 = <&sdcard_clk_gate_pins>;
		pinctrl-2 = <&sd_1bit_pins>;
		pinctrl-names = "sd_default", "clk-gate", "sd_1bit_pins";
		bus-width = <4>;
		cap-sd-highspeed;
		cap-mmc-highspeed;
		max-frequency = <50000000>;
		disable-wp;
		cd-gpios = <&gpio GPIOC_6 GPIO_ACTIVE_HIGH>;
		vmmc-supply = <&vddao3v3_reg>;
	};

	sd_emmc_a: sdio@ffe03000 {
		status = "okay";
		compatible = "amlogic,meson-axg-mmc";
		reg = <0x0 0xffe03000 0x0 0x800>,
			<0x0 0xffe03000 0x0 0x800>,
			<0x0 0xffe03000 0x0 0x800>;
		interrupts = <GIC_SPI 189 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&clkc CLKID_SD_EMMC_A>,
			<&clkc CLKID_SD_EMMC_A_CLK0_SEL>,
			<&clkc CLKID_SD_EMMC_A_CLK0>,
			<&xtal>,
			<&clkc CLKID_FCLK_DIV2>,
			<&clkc CLKID_FCLK_DIV2>;
		clock-names = "core", "mux0", "mux1", "clkin0", "clkin1";
		card_type = <3>;
		ocr_avail = <0x200080>;
		mmc_debug_flag;
		pinctrl-0 = <&sdio_a_pins>;
		pinctrl-1 = <&sdio_clk_gate_pins>;
		pinctrl-names = "default", "clk-gate";
		bus-width = <4>;
		cap-sd-highspeed;
		max-frequency = <200000000>;
		non-removable;
		disable-wp;
		cap-sdio-irq;
		keep-power-in-suspend;
		no-mmc;
		no-sd;
		amlogic,dram-access-quirk;
	};
};

&pinctrl_periphs {
	sdio_a_pins: sdio_a_pins {
		mux {
			groups = "sdio_d0",
				"sdio_d1",
				"sdio_d2",
				"sdio_d3",
				"sdio_clk",
				"sdio_cmd";
			function = "sdio";
			input-enable;
			bias-pull-up;
			drive-strength-microamp = <4000>;
		};
	};
};

&aml_wifi {
	status = "okay";
	wifi_static_buf = <1>;
	/delete-property/ pwm_config;

	pwm_channel1_conf {
		pwms = <&pwm_ef MESON_PWM_0 30541 0>;
		duty-cycle = <15270>;
		times = <10>;
	};
	pwm_channel2_conf {
		pwms = <&pwm_ef MESON_PWM_2 30500 0>;
		duty-cycle = <15250>;
		times = <12>;
	};
};

/ {
	/* the legacy usb2/usb3 v2 phy drivers are no longer registered */
	usbphy0: usbphy0@ffe09000 {
		compatible = "amlogic,uphy-sm1";
		#address-cells = <1>;
		#size-cells = <1>;
		status = "okay";

		u2p0port0: u2p@0 {
			#phy-cells = <0>;
			port-speed = <0x0>;
			reg = <0xffe09000 0x20
					0xffd01008 0x100
					0x0 0x0
					0xff636000 0x60>;
			reset-level = <0x84>;
			phy-reset-level-bits = <16>;
			usb-reset-bit = <2>;
			pll-settings = <0x09400414
							0x927E0000
							0xac5f49e5
							0xfe18
							0x8000fff
							0x78000
							0xe0004
							0xe000c>;
			version = <2>;
		};

		u2p0port1: u2p@20 {
			#phy-cells = <0>;
			port-speed = <0x0>;
			reg = <0xffe09020 0x20
					0xffd01008 0x100
					0x0 0x0
					0xff63a000 0x60
					0xffe09080 0x20>;
			reset-level = <0x84>;
			phy-reset-level-bits = <17>;
			usb-reset-bit = <2>;
			pll-settings = <0x09400414
							0x927E0000
							0xac5f49e5
							0xfe18
							0x8000fff
							0x78000
							0xe0004
							0xe000c>;
			version = <2>;
			phy-otg;
			otg-type = <0>;
			iddig-type = <1>;
			controller-type = <3>;
			interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
		};

		u3p0port0: u3p@80 {
			#phy-cells = <0>;
			port-speed = <0x3>;
			reg = <0xffe09080 0x20
					0xff646000 0x2000>;
			clocks = <&clkc CLKID_PCIE_PLL>;
			clock-names = "pcie_refpll";
		};
	};
};

&usb2_phy_v2 {
	status = "disabled";
};

&usb3_phy_v2 {
	status = "disabled";
};

&dwc3 {
	/delete-property/ usb-phy;
	phys = <&u2p0port0>, <&u2p0port1>, <&u3p0port0>;
	phy-names = "usb2-0", "usb2-1", "usb3-phy";
};

&dwc2_a {
	controller-type = <3>;
	use-gphy;
	phys = <&u2p0port1>;
};
