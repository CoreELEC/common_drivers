#include "sm1_s905x3_4g_1gbit.dts"

/{
	model = "Sinovoip Bananapi-M5";
	/delete-property/ amlogic-dt-id;
	coreelec-dt-id = "sm1_s905x3_bananapi_m5";

	/delete-node/ rtc;
	/delete-node/ aml_bt;
	/delete-node/ aml_wifi;
	/delete-node/ wifi_pwm_conf;

	auge_sound {
		/delete-property/ avout_mute-gpios;
	};

	cpu_opp_table0: cpu_opp_table0 {
		opp12 {
			opp-hz = /bits/ 64 <2016000000>;
			opp-microvolt = <1010000>;
		};
		opp13 {
			opp-hz = /bits/ 64 <2100000000>;
			opp-microvolt = <1030000>;
		};
	};

	cpus:cpus {
		cpu-map {
			cluster0:cluster0 {
				stock_freq = <1908>;
			};
		};
	};

	gpioleds {
		sys_led {
			gpios = <&gpio_ao GPIOAO_11 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
		green_led {
			gpios = <&gpio_ao GPIOAO_2 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "none";
		};
	};

	gpio-reset {
		compatible = "linux,gpio-reset";
		usb_hub {
			gpios = <&gpio GPIOH_4 GPIO_ACTIVE_HIGH>;
			asserted-state = <0>;
			duration-ms = <100>;
		};
	};

	unifykey {
		unifykey-num = <1>;
		unifykey-index-0 = <&keysn_0>;

		keysn_0: key_0 {
			key-name = "usid";
			key-device = "normal";
			key-permit = "read","write","del";
		};
	};

	onewire {
		compatible = "w1-gpio";
		pinctrl-names = "default";
		gpios = <&gpio GPIOX_7 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};
};

&i2c0 {
	status = "disabled";
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	/delete-node/ gt9xx@5d;
	/delete-node/ ftxx@38;
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_master_pins1>;
	clock-frequency = <400000>;
};

&i2c3 {
	status = "okay";
	clock-frequency = <100000>;
	pcf8563: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
	};
};

&audiobus {
	tdmb: tdm@1 {
		/delete-property/ pinctrl-names;
		/delete-property/ pinctrl-0;
	};
};

&pinctrl_periphs {
	/delete-node/ spdifout;

	i2c3_master_pins2: i2c3_pins2 {
		mux {
			drive-strength = <3>;
		};
	};
};

&pinctrl_aobus {
	spdifout: spdifout {
		mux { /* GPIOAO_10 */
			groups = "spdif_ao_out";
			function = "spdif_ao_out";
		};
	};
};

&usb3_phy_v2 {
	otg = <1>;
};

&sd_emmc_a {
	 status = "disabled";
};
