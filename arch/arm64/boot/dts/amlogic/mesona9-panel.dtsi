/ {
	lcd_resman {
		compatible = "amlogic, lcd-resman";
		status = "okay";
		memory-region = <&lcd_cma_reserved>;
		memory-region-names = "lcd_cma_reserved";
	};

	Panel_Groups {
		eDP_0 {
			model_name = "eDP-LM156LFGL";
			interface = "eDP"; /*lcd_interface(lvds, vbyone)*/
			HPD-ignore = <100>;

			assigned-link-rate = <0>;
			assigned-lane-count = <0>;
			assigned-port-count = <0>;
			assigned-vmode = <0>;
			assigned-disable-PSR = <0>;
			use-aux-backlight = <0>;

			assigned-preset-timing = <0>;

			///*h(period active sync bp pol) v(period active sync bp pol) dft fr*/
			//timing-0 = <2180 1920 32 180 0 1282 1080 5 194 0 24 48>;
			//timing-0-fr = <48 50 60>; /* timing with fixed fr */
			//timing-0-range-limit = <
			//	2132 2650  /*h_period_min,max*/
			//	1120 1480  /*v_period_min,max*/
			//	120000000 160000000>; /*pclk_min,max*/
			//timing-0-range = <48 60>; /* timing with fixed fr */

			phy_attr=<1 2 0>; /*Fast-LT vswing, Pre-Em, Post-Cur*/
			bl-wrapper-id = <0xff000000>;
		};
	};

	eDPTX0:eDPTX0 {
		compatible = "amlogic, eDPTX-A9";
		status = "okay";
		index = <0>;

		reg = <0x0 0xfe016000 0x0 0x0f9>,    /* combo dphy */
		      <0x0 0xfe074000 0x0 0x1000>;  /* edp_a host */
		//power-domains = <&pwrdm PDID_T7_EDP0>;
		interrupts = <0 197 1>,<0 194 1>,<0 287 1>;
		interrupt-names = "vsync","vsync2","eDPTX-HPD";
		pinctrl-names = "edptx_hpd","edptx_hpd_off";
		pinctrl-0 = <&edptx_0_hpd_pins>;
		pinctrl-1 = <&edptx_0_hpd_off_pins>;
		device_name = "amlogic-eDPTX0";

		HPD-ignore = <100>;

		//edptx_vcc-gpio      = <&gpio GPIOY_0 GPIO_ACTIVE_HIGH>;
		//edptx_vcc-gpio-name = "GPIOY_0";
		//edptx_vcc_on_dir = <1>;
		//edptx_vcc-off_dir = <0>;

		edptx_bl_en-gpio      = <&gpio GPIOY_0 GPIO_ACTIVE_HIGH>;
		edptx_bl_en-gpio-name = "GPIOY_0";
		edptx_bl_en_on_dir = <1>;
		edptx_bl_en-off_dir = <0>;
		edptx_bl_pwm-gpio      = <&gpio GPIOY_1 GPIO_ACTIVE_HIGH>;
		edptx_bl_pwm-gpio-name = "GPIOY_1";
		edptx_bl_pwm_on_dir = <1>;
		edptx_bl_pwm-off_dir = <0>;

		edptx_bist-gpio      = <&gpio GPIOY_3 GPIO_ACTIVE_HIGH>;
		edptx_bist-gpio-name = "GPIOY_3";
		edptx_bist_on_dir = <1>;
		edptx_bist-off_dir = <0>;

		//edptx_hpd-gpio      = <&gpio GPIOY_7 GPIO_ACTIVE_HIGH>;
		//edptx_hpd-gpio-name = "GPIOY_7";

		drive-strength-lut =
			<0x3 0x3 0x0>,<0x3 0x7 0x0>,<0x3 0xb 0x0>,<0x3 0xf 0x0>,
			<0x7 0x3 0x0>,<0x7 0x8 0x0>,<0x8 0xc 0x0>,
			<0xa 0x4 0x0>,<0xa 0x8 0x0>,
			<0xf 0x5 0x0>;

		ports {
			port {
				#address-cells = <1>;
				#size-cells = <0>;
				edptx0_to_drm: endpoint@0 {
					reg = <0>;
					remote-endpoint = <0>;
				};
			};
		};
	};

	lcd:lcd {
		compatible = "amlogic, lcd-a9";
		status = "okay";
		index = <0>;
		mode = "tablet";
		fr_auto_policy = <0>; /* 0=disable, 1=60/50hz, 2=60/50/48hz */
		key_valid = <0>;
		reg = <0x0 0xfe01e000 0x0 0x400   /* mipi_dsi0-A host */
			0x0 0xfe01c000 0x0 0x200   /* mipi_dsi0-A phy */
			0x0 0xfe072000 0x0 0x400   /* mipi_dsi0-B host */
			0x0 0xfe018000 0x0 0x200   /* mipi_dsi0-B phy */
			0x0 0xfe016000 0x0 0x3e4
			0x0 0xfe004000 0x0 0x070>;  /* vx1_lvds_ctrl */
		interrupts = <0 197 1>, <0 194 1>, <0 208 1>;
		interrupt-names = "vsync","vsync2","vbyone";
		pinctrl-names = "vbyone","vbyone_off";
		pinctrl-0 = <&lcd_vbyone_a_pins>;
		pinctrl-1 = <&lcd_vbyone_a_off_pins>;

		config_check_glb = <1>;
		display_timing_req_min = <1  /*alert_level: 0:disable, 1:warning, 2:fatal error*/
			45   /*hsw+hbp*/
			0    /*hfp, 0 for no need*/
			20   /*vsw+vbp*/
			15>; /*vfp*/
		lvds_0{
			model_name = "1080p-vfreq";
			interface = "lvds"; /*lcd_interface(lvds, vbyone)*/
			basic_setting = <
				1920 1080 /*h_active, v_active*/
				2200 1125 /*h_period, v_period*/
				8      /*lcd_bits */
				16 9>; /*screen_widht, screen_height*/
			range_setting = <
				2132 2650  /*h_period_min,max*/
				1120 1480  /*v_period_min,max*/
				120000000 160000000>; /*pclk_min,max*/
			lcd_timing = <
				44 148 0  /*hs_width, hs_bp, hs_pol*/
				5  20 0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <
				2 /*fr_adj_type: 0=clk, 1=htotal, 2=vtotal, 3=auto, 4=hdmi */
				0 /*clk_ss: [0:7]:level, [8:11]:freq, [12:15]: mode*/
				1 /*clk_auto_generate*/
				0>; /*pixel_clk(unit in Hz)*/
			lvds_attr = <
				1  /*lvds_repack*/
				1  /*dual_port*/
				0  /*pn_swap*/
				0  /*port_swap*/
				0>; /*lane_reverse*/
			phy_attr=<0x3 0>; /*vswing_level, preem_level*/
			hw_filter=<0 0>;  /* filter_time, filter_cnt*/

			/* power step: type, index, value, delay(ms) */
			power_on_step = <
				2 0 0 0   /*signal enable*/
				0xff 0 0 0>; /*ending*/
			power_off_step = <
				2 0 0 10  /*signal disable*/
				0xff 0 0 0>; /*ending*/
			backlight_index = <0xff>;
		};
		vbyone_0{
			model_name = "public_2region";
			interface = "vbyone"; /*lcd_interface(lvds, vbyone)*/
			basic_setting = <
				3840 2160 /*h_active, v_active*/
				4400 2250 /*h_period, v_period*/
				10     /*lcd_bits */
				1210 680>; /*screen_widht, screen_height*/
			range_setting = <
				4370 4800 /*h_period_min, max*/
				2246 2760 /*v_period_min, max*/
				480000000 624000000>; /*pclk_min, max*/
			lcd_timing = <
				33 477 0  /*hs_width, hs_bp, hs_pol*/
				6  65 0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <
				2 /*fr_adj_type: 0=clk, 1=htotal, 2=vtotal, 3=auto, 4=hdmi */
				0 /*clk_ss: [0:7]:level, [8:11]:freq, [12:15]: mode*/
				1 /*clk_auto_generate*/
				0>; /*pixel_clk(unit in Hz)*/
			vbyone_attr = <
				8 /*lane_count*/
				2 /*region_num*/
				4 /*byte_mode*/
				4>; /*color_fmt*/
			vbyone_intr_enable = <
				1 /*vbyone_intr_enable */
				3>; /*vbyone_vsync_intr_enable*/
			phy_attr=<0x8 0xf>; /* vswing_level, preem_level */
			hw_filter=<0 0>;  /* filter_time, filter_cnt*/

			/* power step: type, index, value, delay(ms) */
			power_on_step = <
				0 0 1 200  /*panel power on*/
				2 0 0 10  /*signal enable*/
				0xff 0 0 0>; /*ending*/
			power_off_step = <
				2 0 0 10 /*signal disable*/
				0 0 0 500 /*panel power off*/
				0xff 0 0 0>; /*ending*/
			backlight_index = <0>;
		};
		vbyone_1{
			model_name = "public_1region";
			interface = "vbyone"; /*lcd_interface(lvds, vbyone)*/
			basic_setting = <
				3840 2160 /*h_active, v_active*/
				4400 2250 /*h_period, v_period*/
				10     /*lcd_bits*/
				1270 721>; /*screen_widht, screen_height*/
			range_setting = <
				4370 4800 /*h_period_min, max*/
				2246 2790 /*v_period_min, max*/
				552000000 632000000>; /*pclk_min,max*/
			lcd_timing = <
				33 477 0   /*hs_width, hs_bp, hs_pol*/
				6  65  0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <
				2 /*fr_adj_type: 0=clk, 1=htotal, 2=vtotal, 3=auto, 4=hdmi */
				0 /*clk_ss: [0:7]:level, [8:11]:freq, [12:15]: mode*/
				1 /*clk_auto_generate*/
				0>; /*pixel_clk(unit in Hz)*/
			vbyone_attr = <
				8 /*lane_count*/
				1 /*region_num*/
				4 /*byte_mode*/
				4>; /*color_fmt*/
			vbyone_intr_enable = <
				1   /*vbyone_intr_enable*/
				3>; /*vbyone_vsync_intr_enable*/
			phy_attr=<0x8 0xf>; /* vswing_level, preem_level */
			hw_filter=<0 0>;  /* filter_time, filter_cnt*/

			/* power step: type, index, value, delay(ms) */
			power_on_step = <
				0 0 1 200  /*panel power on*/
				2 0 0 10 /*signal enable*/
				0xff 0 0 0>; /*ending*/
			power_off_step = <
				2 0 0 10  /*signal disable*/
				0 0 0 500 /*panel power off*/
				0xff 0 0 0>; /*ending*/
			backlight_index = <0>;
		};
		vbyone_2{
			model_name = "vbyone_1region_hdmi";
			interface = "vbyone"; /*lcd_interface(lvds, vbyone)*/
			basic_setting = <
				3840 2160 /*h_active, v_active*/
				4400 2250 /*h_period, v_period*/
				10     /*lcd_bits */
				1210 680>; /*screen_widht, screen_height*/
			range_setting = <
				4370 4800 /*h_period_min, max*/
				2246 2760 /*v_period_min, max*/
				480000000 624000000>; /*pclk_min, max*/
			lcd_timing = <
				33 477 0  /*hs_width, hs_bp, hs_pol*/
				6  65 0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <
				4 /*fr_adj_type: 0=clk, 1=htotal, 2=vtotal, 3=auto, 4=hdmi */
				0 /*clk_ss: [0:7]:level, [8:11]:freq, [12:15]: mode*/
				1 /*clk_auto_generate*/
				0>; /*pixel_clk(unit in Hz)*/
			vbyone_attr = <
				8 /*lane_count*/
				1 /*region_num*/
				4 /*byte_mode*/
				4>; /*color_fmt*/
			vbyone_intr_enable = <
				1 /*vbyone_intr_enable */
				3>; /*vbyone_vsync_intr_enable*/
			phy_attr=<0x8 0xf>; /* vswing_level, preem_level */
			hw_filter=<0 0>;  /* filter_time, filter_cnt*/
			//vlock_attr: <vlock_en vlock_mode pll_m limit line_limit>
			vlock_attr = <0 4 0 3>;
			/* power step: type, index, value, delay(ms) */
			power_on_step = <
				0 0 1 20  /*panel power on*/
				2 0 0 0  /*signal enable*/
				0xff 0 0 0>; /*ending*/
			power_off_step = <
				2 0 0 20 /*signal disable*/
				0 0 0 100 /*panel power off*/
				0xff 0 0 0>; /*ending*/
			backlight_index = <0xff>;
		};
		vbyone_3{
			model_name = "vbyone_2region_hdmi";
			interface = "vbyone"; /*lcd_interface(lvds, vbyone)*/
			basic_setting = <
				3840 2160 /*h_active, v_active*/
				4400 2250 /*h_period, v_period*/
				10     /*lcd_bits */
				1210 680>; /*screen_widht, screen_height*/
			range_setting = <
				4370 4800 /*h_period_min, max*/
				2246 2760 /*v_period_min, max*/
				480000000 624000000>; /*pclk_min, max*/
			lcd_timing = <
				33 477 0  /*hs_width, hs_bp, hs_pol*/
				6  65 0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <
				4 /*fr_adj_type: 0=clk, 1=htotal, 2=vtotal, 3=auto, 4=hdmi */
				0 /*clk_ss: [0:7]:level, [8:11]:freq, [12:15]: mode*/
				1 /*clk_auto_generate*/
				0>; /*pixel_clk(unit in Hz)*/
			vbyone_attr = <
				8 /*lane_count*/
				2 /*region_num*/
				4 /*byte_mode*/
				4>; /*color_fmt*/
			vbyone_intr_enable = <
				1 /*vbyone_intr_enable */
				3>; /*vbyone_vsync_intr_enable*/
			phy_attr=<0x8 0xf>; /* vswing_level, preem_level */
			hw_filter=<0 0>;  /* filter_time, filter_cnt*/
			//vlock_attr: <vlock_en vlock_mode pll_m limit line_limit>
			vlock_attr = <0 4 0 3>;
			/* power step: type, index, value, delay(ms) */
			power_on_step = <
				0 0 1 20  /*panel power on*/
				2 0 0 0  /*signal enable*/
				0xff 0 0 0>; /*ending*/
			power_off_step = <
				2 0 0 20 /*signal disable*/
				0 0 0 100 /*panel power off*/
				0xff 0 0 0>; /*ending*/
			backlight_index = <0xff>;
		};
		vbyone_4{/*for localdimming*/
			model_name = "public_2region_ldim";
			interface = "vbyone"; /*lcd_interface(lvds, vbyone)*/
			basic_setting = <
				3840 2160 /*h_active, v_active*/
				4400 2250 /*h_period, v_period*/
				10     /*lcd_bits */
				160 90>; /*screen_widht, screen_height*/
			range_setting = <
				4370 4800 /*h_period_min, max*/
				2246 2760 /*v_period_min, max*/
				480000000 624000000>; /*pclk_min, max*/
			lcd_timing = <
				33 477 0  /*hs_width, hs_bp, hs_pol*/
				6  65 0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <
				2 /*fr_adj_type: 0=clk, 1=htotal, 2=vtotal, 3=auto, 4=hdmi */
				0 /*clk_ss: [0:7]:level, [8:11]:freq, [12:15]: mode*/
				1 /*clk_auto_generate*/
				0>; /*pixel_clk(unit in Hz)*/
			vbyone_attr = <
				8 /*lane_count*/
				2 /*region_num*/
				4 /*byte_mode*/
				4>; /*color_fmt*/
			vbyone_intr_enable = <
				1 /*vbyone_intr_enable */
				3>; /*vbyone_vsync_intr_enable*/
			hw_filter=<0 0>;  /* filter_time, filter_cnt*/
			phy_attr=<0x8 0xf>; /* vswing_level, preem_level */

			phy_adv_attr=<0x100a 0 0x2f 0 0x2>; /*flag, vswing, vcm, bias, odt*/
			phy_lane_ctrl = </*bit[31:16]amp, bit[15:0]preem*/
				0x000000e7 0x000000e7 0x000000e7 0x000000e7
				0x000000e7 0x000000e7 0x000000e7 0x000000e7>;

			/* power step: type, index, value, delay(ms) */
			power_on_step = <
				0 2 1 200  /*panel power on*/
				2 0 0 10  /*signal enable*/
				0xff 0 0 0>; /*ending*/
			power_off_step = <
				2 0 0 10 /*signal disable*/
				0 2 0 500 /*panel power off*/
				0xff 0 0 0>; /*ending*/
			backlight_index = <3>;
		};

		vbyone_5{
			model_name = "2region_var_res";
			interface = "vbyone"; /*lcd_interface(lvds, vbyone)*/
			basic_setting = <
				3840 2160 /*h_active, v_active*/
				4400 2250 /*h_period, v_period*/
				10     /*lcd_bits */
				160 90>; /*screen_widht, screen_height*/
			lcd_timing = <
				33 477 0  /*hs_width, hs_bp, hs_pol*/
				6  65 0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <
				0xff /*fr_adj_type: 0=clk, 1=htotal, 2=vtotal, 3=auto, 4=hdmi */
				0 /*clk_ss: [0:7]:level, [8:11]:freq, [12:15]: mode*/
				1 /*clk_auto_generate*/
				594000000>; /*pixel_clk(unit in Hz)*/
			vbyone_attr = <
				8 /*lane_count*/
				2 /*region_num*/
				4 /*byte_mode*/
				4>; /*color_fmt*/
			vbyone_intr_enable = <
				1 /*vbyone_intr_enable */
				3>; /*vbyone_vsync_intr_enable*/
			cus_ctrl_0_attr = <0x02 0x03>;
			extend_tmg_0 = <2720 2560 60 40  0 1481 1440 5 20 0 8 344 193 241500000>;
			extend_tmg_1 = <2200 1920 44 148 0 1125 1080 4  5 0 8 344 193 148500000>;
			extend_tmg_2 = <1650 1280 40 220 0 750  720  5  5 0 8 344 193  74250000>;
			extend_tmg_3 = <800  640  96 40  0 525  480  2 25 0 8 344 193  25175000>;

			phy_attr=<0x8 0xf>; /* vswing_level, preem_level */
			hw_filter=<0 0>;  /* filter_time, filter_cnt*/

			/* power step: type, index, value, delay(ms) */
			power_on_step = <
				0 2 1 200  /*panel power on*/
				2 0 0 10  /*signal enable*/
				0xff 0 0 0>; /*ending*/
			power_off_step = <
				2 0 0 10 /*signal disable*/
				0 2 0 100 /*panel power off*/
				0xff 0 0 0>; /*ending*/
			backlight_index = <0xff>;
		};

		edp_0{
			model_name = "edp_1080p60";
			interface = "edp"; /*lcd_interface(lvds, vbyone)*/
			basic_setting = <
				1920 1080 /*h_active, v_active*/
				2200 1125 /*h_period, v_period*/
				8      /*lcd_bits*/
				344 193>; /*screen_widht, screen_height*/
			range_setting = <
				2132 2720 /*h_period min, max*/
				1120 1380 /*v_period min, max*/
				133940000 156000000>; /*pclk_min, max*/
			lcd_timing = <
				44 148 0   /*hs_width, hs_bp, hs_pol*/
				5  20  0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <
				0 /*fr_adj_type: 0=clk, 1=htotal, 2=vtotal, 3=auto, 4=hdmi */
				0 /*clk_ss_level */
				1 /*clk_auto_generate*/
				0>; /*pixel_clk(unit in Hz)*/
			edp_attr = <
				2 /*max_lane_count: 0:auto, 1, 2, 4*/
				0xa /*max_link_rate: 0:auto, 0x6:1.62G, 0xa:2.7G*/
				0 /*training_mode: 0:auto, 1:fast, 2:full*/
				0 /*edid_en, auto timing by edid*/
				0 /*reserved */
				0 /*reserved */
				0 /*reserved */
				0 /*reserved */
				0>; /*reserved*/
			phy_attr=<0x5 1>; /*vswing_level, preem_level*/

			/* power step: type, index, value, delay(ms) */
			power_on_step = <
				0 0 1 50  /*panel power on*/
				2 0 0 0   /*signal enable*/
				0xff 0 0 0>; /*ending*/
			power_off_step = <
				2 0 0 10  /*signal disable*/
				0 0 0 200  /*panel power on*/
				0xff 0 0 0>; /*ending*/
			backlight_index = <0x0>;
		};
		edp_1{
			model_name = "edp_edid";
			interface = "edp"; /*lcd_interface(lvds, vbyone)*/
			basic_setting = <
				2560 1440 /*h_active, v_active*/
				2640 1481 /*h_period, v_period*/
				8      /*lcd_bits*/
				344 193>; /*screen_widht, screen_height*/
			lcd_timing = <
				32 40 0   /*hs_width, hs_bp, hs_pol*/
				8  16  0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <
				2 /*fr_adj_type: 0=clk, 1=htotal, 2=vtotal, 3=auto, 4=hdmi */
				0 /*clk_ss_level */
				1 /*clk_auto_generate*/
				235000000>; /*pixel_clk(unit in Hz)*/
			edp_attr = <
				0 /*max_lane_count: 0:auto, 1, 2, 4*/
				0 /*max_link_rate: 0:auto, 0x6:1.62G, 0xa:2.7G*/
				0 /*training_mode: 0:auto, 1:fast, 2:full*/
				1 /*edid_en, auto timing by edid*/
				0 /*reserved */
				0 /*reserved */
				0 /*reserved */
				0 /*reserved */
				0>; /*reserved*/
			phy_attr=<0x5 1>; /*vswing_level, preem_level*/

			/* power step: type, index, value, delay(ms) */
			power_on_step = <
				0 0 1 50  /*panel power on*/
				2 0 0 0   /*signal enable*/
				0xff 0 0 0>; /*ending*/
			power_off_step = <
				2 0 0 10  /*signal disable*/
				0 0 0 200  /*panel power on*/
				0xff 0 0 0>; /*ending*/
			backlight_index = <0x0>;
		};

		mipi_0{
			model_name = "TL070WSH27";
			interface = "mipi";
			/*h_active, v_active, h_period, v_period, color_bit, width, height*/
			basic_setting = <1024 600 1250 630 8 154 86>;
			/*hs_width, hs_bp, hs_pol, vs_width, vs_bp, vs_pol*/
			lcd_timing = <80 100 0 5 20 0>;
			/* fr_adj_type(0=clk, 1=htotal, 2=vtotal), clk_ss_level, 1, pixel_clk */
			clk_attr = <0 0 1 47250000>;
			/* <lane, bit_rate, /, mode_init(0=video,1=cmd), mode_disp(0=video,1=cmd)*/
			/* video_mode(0=sync_pulse,1=sync_event,2=burst), clk_hs, />*/
			mipi_attr = <4 300 0 1 0 2 1 0>;
			/* dsi_init: data_type, num, data... */
			dsi_init_on = <
				0x05 1 0x11
				0xfd 1 20 /*delay(ms)*/
				0x05 1 0x29
				0xfd 1 20 /*delay(ms)*/
				0xff 0>; /*ending*/
			dsi_init_off = <0x05 1 0x28
				0xfd 1 10 /*delay(ms)*/
				0x05 1 0x10
				0xfd 1 10 /*delay(ms)*/
