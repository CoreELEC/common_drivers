				630 788 /*v_period min, max*/
				47250000 47250000>; /*pclk_min, max*/
			lcd_timing = <80 100 0 /*hs_width, hs_bp, hs_pol*/
				5 20 0>; /*vs_width, vs_bp, vs_pol*/
			clk_attr = <2 /*fr_adj_type(0=clk, 1=htotal, 2=vtotal)*/
