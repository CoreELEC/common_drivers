#include "g12b_a311d_w400_linux.dts"
#include "coreelec_g12b_common.dtsi"

/ {
	model = "Hardkernel ODROID-N2Plus";
	coreelec-dt-id = "g12b_s922x_odroid_n2plus";
	amlogic-dt-id = "g12b_w400_b";

	/delete-node/ memory@00000000;

	reserved-memory {
		secmon_reserved:linux,secmon {
			size = <0x0 0x300000>;
			alloc-ranges = <0x0 0x05000000 0x0 0x300000>;
		};
	};

	bt-dev {
		status = "disabled";
	};

	wifi {
		status = "disabled";
	};

	/delete-node/ rtc;

	gpio_keypad {
		/delete-property/ key-gpios;
		/delete-property/ detect_mode;
		reg = <0x0 0xFF800000 0x0 0x400>;
	};

	cpu_opp_table0: cpu_opp_table0 {
		opp09 {
			opp-hz = /bits/ 64 <1908000000>;
			opp-microvolt = <1030000>;
		};
		opp10 {
			opp-hz = /bits/ 64 <2016000000>;
			opp-microvolt = <1040000>;
		};
	};

	cpu_opp_table1: cpu_opp_table1 {
		opp13 {
			opp-hz = /bits/ 64 <2304000000>;
			opp-microvolt = <1030000>;
		};
		opp14 {
			opp-hz = /bits/ 64 <2400000000>;
			opp-microvolt = <1040000>;
		};
	};

	cpus:cpus {
		cpu-map {
			cluster0:cluster0 {
				stock_freq = <1908>;
			};
			cluster1:cluster1 {
				stock_freq = <2208>;
			};
		};
	};

	gpioleds {
		sys_led {
			linux,default-trigger = "heartbeat";
		};
	};

	gpio-reset {
		compatible = "linux,gpio-reset";
		usb_hub_en {
			gpios = <&gpio GPIOH_5 GPIO_ACTIVE_HIGH>;
			asserted-state = <0>;
			duration-ms = <100>;
		};
		usb_hub {
			gpios = <&gpio GPIOH_4 GPIO_ACTIVE_HIGH>;
			asserted-state = <0>;
			duration-ms = <100>;
		};
	};

	unifykey {
		unifykey-num = <1>;
		unifykey-index-0 = <&keysn_0>;

		keysn_0: key_0 {
			key-name = "usid";
			key-device = "normal";
			key-permit = "read","write","del";
		};
	};

	pwmgpio: pwmgpio {
		compatible = "pwm-gpio";
		#pwm-cells = <3>;
		pwm-gpios = <&gpio_ao GPIOAO_10 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	pwmfan: pwm-fan {
		compatible = "pwm-fan";
		pwms = <&pwmgpio 0 40000 1>;
		cooling-min-state = <0>;
		cooling-max-state = <3>;
		#cooling-cells = <2>;
		cooling-levels = <0 120 170 220>;
	};

	onewire {
		compatible = "w1-gpio";
		pinctrl-names = "default";
		gpios = <&gpio GPIOX_7 GPIO_ACTIVE_HIGH>;
		status = "disabled";
	};
};

&i2c0 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	/delete-property/ clock-frequency;
};

&i2c2 {
	status = "okay";
	pinctrl-0 = <&i2c2_master_pins1>;
	clock-frequency = <400000>;
};

&i2c3 {
	pcf8563: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
	};
};

&audiobus {
	aml_tdmb: tdmb {
		/delete-property/ pinctrl-names;
		/delete-property/ pinctrl-0;
	};

	aml_spdif: spdif {
		pinctrl-names = "spdif_pins";
		/delete-property/ pinctrl-1;
	};
};

&pinctrl_periphs {
	i2c3_master_pins2: i2c3_pins2 {
		mux {
			drive-strength = <3>;
		};
	};

	spdifout: spdifout {
		mux {/* GPIOA_13 */
			groups = "spdif_out_a13";
			function = "spdif_out";
		};
	};
};

&pinctrl_aobus {
	/delete-node/ spdifout;
};

&sd_emmc_c {
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	cap-sd-highspeed;
	cap-mmc-hw-reset;
};

&sd_emmc_a {
	status = "disabled";
};

&uart_A {
	status = "disabled";
};

&amhdmitx {
	vend_data {
		vendor_name = "HK";
		product_desc = "ODROID-N2Plus";
	};
};
